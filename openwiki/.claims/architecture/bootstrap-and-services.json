    {
      "id": "claim_fa16f0d8eef64f5b81e8ac9e6883ecbb",
      "statement": "bootstrap(state_dir) is the single canonical initialization sequence for all frontends and returns a CoreSystems bundle of Arc-wrapped subsystems plus a settings snapshot.",
