import { Theme } from "../../theme.slint";

export component StatusBadge inherits Rectangle {
    in property <string> state_code;
    in property <string> state_label;

    background: root.state_code == "downloading" ? Theme.c142e1b : (
        root.state_code == "paused" ? Theme.c33200b : (
            root.state_code == "completed" ? Theme.c112842 : Theme.c361214
        )
    );
    border-color: root.state_code == "downloading" ? Theme.c22542e : (
        root.state_code == "paused" ? Theme.c543615 : (
            root.state_code == "completed" ? Theme.c1d406b : Theme.c5c1f23
        )
    );
    border-width: 1px;
    border-radius: 10px;
    height: 20px;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 5px;
        alignment: center;

        // Glowing Dot Indicator
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: root.state_code == "downloading" ? Theme.c4ade80 : (
                    root.state_code == "paused" ? Theme.cfacc15 : (
                        root.state_code == "completed" ? Theme.c38bdf8 : Theme.cf87171
                    )
                );
            }
        }

        Text {
            text: root.state_label;
            color: root.state_code == "downloading" ? Theme.c4ade80 : (
                root.state_code == "paused" ? Theme.cfacc15 : (
                    root.state_code == "completed" ? Theme.c60a5fa : Theme.cf87171
                )
            );
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

export component ToneBadge inherits Rectangle {
    in property <string> text;
    in property <string> tone: "neutral"; // neutral, success, info, warning, danger

    background: root.tone == "success" ? Theme.c14351a : (
        root.tone == "info" ? Theme.c132a42 : (
            root.tone == "warning" ? Theme.c3b280c : (
                root.tone == "danger" ? Theme.c3b1216 : Theme.c20252e
            )
        )
    );
    border-color: root.tone == "success" ? Theme.c22c55e : (
        root.tone == "info" ? Theme.c38bdf8 : (
            root.tone == "warning" ? Theme.cf59e0b : (
                root.tone == "danger" ? Theme.cef4444 : Theme.c3b4352
            )
        )
    );
    border-width: 1px;
    border-radius: 4px;
    height: 22px;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        alignment: center;
        Text {
            text: root.text;
            color: root.tone == "success" ? Theme.c4ade80 : (
                root.tone == "info" ? Theme.c38bdf8 : (
                    root.tone == "warning" ? Theme.cfbbf24 : (
                        root.tone == "danger" ? Theme.cf87171 : Theme.c9ca3af
                    )
                )
            );
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

export component CodeChip inherits Rectangle {
    in property <string> text;
    background: Theme.c14171d;
    border-color: Theme.c2b313d;
    border-width: 1px;
    border-radius: 4px;
    height: 22px;

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        alignment: center;
        Text {
            text: root.text;
            color: Theme.ca3e635;
            font-size: 11px;
            font-family: "Consolas";
            font-weight: 500;
            vertical-alignment: center;
        }
    }
}

export component WarningBanner inherits Rectangle {
    in property <string> text;
    background: Theme.c2a1d08;
    border-color: Theme.cf59e0b;
    border-width: 1px;
    border-radius: 6px;
    height: 38px;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        alignment: start;

        VerticalLayout {
            alignment: center;
            Image {
                source: @image-url("../../assets/icons/error-warning-line.svg");
                colorize: Theme.cf59e0b;
                width: 16px;
                height: 16px;
                image-fit: contain;
            }
        }

        Text {
            text: root.text;
            color: Theme.cfcd34d;
            font-size: 12px;
            font-weight: 500;
            vertical-alignment: center;
        }
    }
}

export component CategoryButton inherits Rectangle {
    in property <string> title;
    in property <image> icon_source;
    in property <string> count_text: "0";
    in property <bool> active: false;
    callback clicked();

    background: root.active ? Theme.c232b1d : (ta.has_hover ? Theme.c171b21 : transparent);
    animate background { duration: 150ms; }
    border-radius: 6px;
    height: 38px;

    ta := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 8px;
            alignment: start;

            VerticalLayout {
                alignment: center;
                Image {
                    source: root.icon_source;
                    colorize: root.active ? Theme.c84cc16 : (ta.has_hover ? Theme.cf3f4f6 : Theme.c8b95a5);
                    width: 16px;
                    height: 16px;
                    image-fit: contain;
                }
            }

            Text {
                text: root.title;
                color: root.active ? Theme.c84cc16 : (ta.has_hover ? Theme.cf3f4f6 : Theme.c9ca3af);
                font-size: 13px;
                font-weight: root.active ? 600 : 400;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            alignment: center;
            Rectangle {
                // Active badge: accent-soft surface + accent-strong text (same
                // semantics as the active row background). The previous
                // c365314/ca3e635 pair mapped to a near-black pill with bright
                // lime text in light mode — inverted versus the theme.
                background: root.active ? Theme.c26331a : Theme.c1e2229;
                border-radius: 10px;
                height: 20px;
                min-width: 22px;
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    alignment: center;
                    Text {
                        text: root.count_text;
                        color: root.active ? Theme.c65a30d : Theme.c8b95a5;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

export component CustomSelect inherits Rectangle {
    in property <[string]> model: [];
    in-out property <int> current_index: 0;
    in-out property <string> current_value: "";
    in property <bool> enabled: true;
    in property <length> select_height: 36px;
    in property <length> font_size: 13px;
    callback selected(string);
    callback selected_index(int);

    height: root.select_height;
    background: Theme.c14161b;
    border-color: popup.is-open ? Theme.c84cc16 : (ta.has_hover ? Theme.c3b4352 : Theme.c2b313d);
    animate border-color { duration: 150ms; }
    border-width: 1px;
    border-radius: 6px;

    ta := TouchArea {
        enabled: root.enabled;
        clicked => { popup.show(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: space-between;

        Text {
            text: root.current_value != "" ? root.current_value : (
                root.current_index >= 0 && root.current_index < root.model.length ? root.model[root.current_index] : ""
            );
            color: !root.enabled ? Theme.c4b5563 : Theme.cf3f4f6;
            font-size: root.font_size;
            vertical-alignment: center;
            overflow: elide;
        }

        VerticalLayout {
            alignment: center;
            width: 16px;
            Image {
                source: @image-url("../../assets/icons/arrow-down-s-line.svg");
                colorize: popup.is-open ? Theme.c84cc16 : (!root.enabled ? Theme.c4b5563 : Theme.c9ca3af);
                width: 16px;
                height: 16px;
                transform-rotation: popup.is-open ? 180deg : 0deg;
                animate transform-rotation, colorize { duration: 180ms; easing: ease-out; }
                image-fit: contain;
            }
        }
    }

    popup := PopupWindow {
        x: 0;
        y: parent.height + 4px;
        width: parent.width;

        Rectangle {
            width: 100%;
            height: self.preferred-height;
            background: Theme.c181b22;
            border-color: Theme.c343c4a;
            border-width: 1px;
            border-radius: 8px;
            drop-shadow-blur: 16px;
            drop-shadow-color: Theme.c000000bb;

            VerticalLayout {
                padding: 4px;
                spacing: 2px;

                for item[idx] in root.model : Rectangle {
                    height: 32px;
                    border-radius: 4px;
                    background: item_ta.has_hover ? Theme.c232b1d : (
                        (root.current_value != "" ? item == root.current_value : idx == root.current_index) ? Theme.c1e2229 : transparent
                    );
                    animate background { duration: 100ms; }

                    item_ta := TouchArea {
                        clicked => {
                            root.current_index = idx;
                            if root.current_value != "" {
                                root.current_value = item;
                            }
                            root.selected(item);
                            root.selected_index(idx);
                        }
                    }

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: space-between;

                        Text {
                            text: item;
                            color: (root.current_value != "" ? item == root.current_value : idx == root.current_index) ? Theme.c84cc16 : Theme.ce5e7eb;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        if (root.current_value != "" ? item == root.current_value : idx == root.current_index) : Text {
                            text: "✓";
                            color: Theme.c84cc16;
                            font-size: 11px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
