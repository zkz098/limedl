# /etc/limedl-server.env — install with mode 0600 and owner root.
#
# Every aria2 client (AriaNg, Motrix, scripts) must send the shared secret as
# the first JSON-RPC parameter: "token:<value>". Generate one with:
#
#   head -c 32 /dev/urandom | base64
#
# The daemon refuses to start when --rpc-listen is non-loopback and no secret
# (and no per-client token) is configured.
LIMEDL_RPC_SECRET=change-me

# Optional: base data directory. The shipped unit also passes --data-dir, which
# takes precedence over this variable.
# LIMEDL_DATA_DIR=/var/lib/limedl