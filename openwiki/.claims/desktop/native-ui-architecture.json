    {
      "id": "claim_a3116684fdf845e3bf61d5d54d1ccadf",
      "statement": "main() is a thin wrapper that awaits run() and reports a fatal error through crash::report_startup_failure; run() owns OS-facing startup: CLI parsing, data directory, single-instance claim, panic hook, logging with defaults, bootstrap(), logging with the configured settings, autostart, optional Aria2 RPC, then UI construction.",
      "evidence": [
        {
          "resource": "repo://crates/limedl-native/src/main.rs#L54-L130",
          "version": "repo-lines-v1:sha256:bafc23070c6582daa68211d97ba7b8f4add62658f66d5ab59c8a7f01c9e29018:"
        }
      ]
    },
    {
