---
import Layout from '../layouts/Layout.astro';
import ChangelogView from '../components/ChangelogView.astro';
import { collectionPageJsonLd } from '../lib/seo';

const description =
  'limedl 稳定版本更新日志：新功能、问题修复、性能优化与重构，由 Conventional Commits 自动生成。';
---

<Layout
  title="更新日志 - limedl"
  description={description}
  lang="zh-CN"
  rss="/changelog.xml"
  jsonLd={[
    collectionPageJsonLd('limedl 更新日志', description, 'https://limedl.com/changelog/'),
  ]}
>
  <ChangelogView lang="zh-CN" />
</Layout>
