import { ScrollView } from "std-widgets.slint";

import { Theme } from "../../theme.slint";
import { SettingsFormData, SpeedLimitSlotItem } from "../../types.slint";
import {
    CustomSelect,
    IconButton,
    SecondaryButton,
    ToggleSwitch,
    UnitInput,
} from "../common.slint";
import { FormTip } from "shared.slint";

export component SettingsTabSchedule inherits ScrollView {
    in-out property <SettingsFormData> settings_form;
    in-out property <[SpeedLimitSlotItem]> speed_limit_slots;
    callback schedule_set_enabled(bool);
    callback schedule_add();
    callback schedule_remove(int);
    callback schedule_update(int, string, string);

    VerticalLayout {
        alignment: start;
        padding: 16px;
        spacing: 14px;

        Text { text: @tr("Scheduler & Performance"); color: Theme.ca3e635; font-size: 13px; font-weight: 700; }

        VerticalLayout {
            spacing: 4px;
            Text { text: @tr("Allocation Mode:"); color: Theme.c9ca3af; font-size: 12px; }
            CustomSelect {
                    model: [@tr("Automatic (adaptive)"), @tr("Traditional (fixed)")];
                    current-index <=> root.settings_form.scheduler_mode_idx;
                    height: 36px;
                }
            Text { text: @tr("automatic uses adaptive thread pool; traditional uses fixed concurrency"); color: #6b7280; font-size: 11px; }
        }

        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                spacing: 4px;
                Text { text: @tr("Auto - Max Parallel Threads (1-128):"); color: Theme.c9ca3af; font-size: 12px; }
                UnitInput {
                    text <=> root.settings_form.scheduler_max_parallel_threads;
                    placeholder: "16";
                    unit_text: @tr("threads");
                }
            }
            VerticalLayout {
                spacing: 4px;
                Text { text: @tr("Max Threads per Task (1-64):"); color: Theme.c9ca3af; font-size: 12px; }
                UnitInput {
                    text <=> root.settings_form.scheduler_max_threads_per_task;
                    placeholder: "8";
                    unit_text: @tr("threads");
                }
            }
        }

        VerticalLayout {
            spacing: 4px;
            Text { text: @tr("Min Threads per Task (0-64):"); color: Theme.c9ca3af; font-size: 12px;
                Tooltip {
                    FormTip { text: @tr("Set to 0 to use 50% of the max thread count automatically. The adaptive algorithm never goes below this once reached."); }
                } }
            UnitInput {
                text <=> root.settings_form.scheduler_min_threads_per_task;
                placeholder: "0";
                unit_text: @tr("threads");
            }
        }

        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                spacing: 4px;
                Text { text: @tr("Adaptive Profile:"); color: Theme.c9ca3af; font-size: 12px;
                    Tooltip {
                        FormTip { text: @tr("Conservative limits thread growth, Balanced trades overhead for speed, and Aggressive prioritizes download speed."); }
                    } }
                CustomSelect {
                    model: [@tr("Conservative"), @tr("Balanced"), @tr("Aggressive")];
                    current-index <=> root.settings_form.scheduler_adaptive_profile_idx;
                    height: 36px;
                }
            }
            VerticalLayout {
                spacing: 4px;
                Text { text: @tr("Chunk Strategy:"); color: Theme.c9ca3af; font-size: 12px;
                    Tooltip {
                        FormTip { text: @tr("Auto-adjust chunk strategy based on network conditions"); }
                    } }
                CustomSelect {
                    model: [@tr("Adaptive"), @tr("Fixed")];
                    current-index <=> root.settings_form.scheduler_chunk_strategy_idx;
                    height: 36px;
                }
            }
        }

        HorizontalLayout {
            alignment: space-between;
            VerticalLayout {
                spacing: 2px;
                Text { text: @tr("Tail Sprint"); color: Theme.cf3f4f6; font-size: 13px; font-weight: 600; }
                Text { text: @tr("Parallelize tail chunks to minimize finishing latency"); color: #6b7280; font-size: 11px; }
            }
            ToggleSwitch {
                checked: root.settings_form.scheduler_tail_sprint;
                toggled => { root.settings_form.scheduler_tail_sprint = !root.settings_form.scheduler_tail_sprint; }
            }
        }

        HorizontalLayout {
            alignment: space-between;
            VerticalLayout {
                spacing: 2px;
                Text { text: @tr("Connection Warmup"); color: Theme.cf3f4f6; font-size: 13px; font-weight: 600; }
                Text { text: @tr("Pre-establish multiple connections during handshake for faster warmup"); color: #6b7280; font-size: 11px; }
            }
            ToggleSwitch {
                checked: root.settings_form.scheduler_connection_warmup;
                toggled => { root.settings_form.scheduler_connection_warmup = !root.settings_form.scheduler_connection_warmup; }
            }
        }

        // ── Speed limit schedule ──
        Rectangle { height: 1px; background: Theme.c1f242e; }

        HorizontalLayout {
            alignment: space-between;
            VerticalLayout {
                spacing: 2px;
                Text { text: @tr("Speed Limit Schedule"); color: Theme.cf3f4f6; font-size: 13px; font-weight: 600; }
                Text { text: @tr("Apply a different global speed limit per time-of-day range (local time). No matching range means the global limit above applies."); color: #6b7280; font-size: 11px; }
            }
            ToggleSwitch {
                checked: root.speed_limit_slots.length > 0;
                toggled => { root.schedule_set_enabled(root.speed_limit_slots.length == 0); }
            }
        }

        if root.speed_limit_slots.length > 0 : VerticalLayout {
            spacing: 6px;
            Text { text: @tr("Start / End (0-23 hours) and limit in KB/s (0 = unlimited)."); color: #6b7280; font-size: 11px; }

            for slot[idx] in root.speed_limit_slots : Rectangle {
                background: Theme.c14171d;
                border-color: Theme.c232832;
                border-width: 1px;
                border-radius: 6px;
                height: self.preferred-height;

                VerticalLayout {
                    padding: 10px;
                    spacing: 8px;

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;

                        VerticalLayout {
                            spacing: 3px;
                            Text { text: @tr("Start"); color: Theme.c9ca3af; font-size: 11px; }
                            slot_start := UnitInput {
                                text: slot.start_hour;
                                placeholder: "0";
                                unit_text: @tr("h");
                                edited(value) => { root.schedule_update(idx, "start", value); }
                            }
                        }
                        VerticalLayout {
                            spacing: 3px;
                            Text { text: @tr("End"); color: Theme.c9ca3af; font-size: 11px; }
                            UnitInput {
                                text: slot.end_hour;
                                placeholder: "6";
                                unit_text: @tr("h");
                                edited(value) => { root.schedule_update(idx, "end", value); }
                            }
                        }
                        VerticalLayout {
                            spacing: 3px;
                            Text { text: @tr("Limit"); color: Theme.c9ca3af; font-size: 11px; }
                            UnitInput {
                                text: slot.limit_kb;
                                placeholder: "0";
                                unit_text: "KB/s";
                                edited(value) => { root.schedule_update(idx, "limit", value); }
                            }
                        }
                        Rectangle {}
                        IconButton {
                            text: @tr("Remove");
                            icon: @image-url("../../assets/icons/delete-bin-line.svg");
                            text_color: Theme.cf87171;
                            clicked => { root.schedule_remove(idx); }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Text {
                            text: slot.summary;
                            color: slot.wraps ? Theme.cfacc15 : Theme.c84cc16;
                            font-size: 11px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        if slot.wraps : Text {
                            text: @tr("Wraps to the next day");
                            color: Theme.cfacc15;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            HorizontalLayout {
                alignment: start;
                SecondaryButton {
                    text: @tr("Add Time Range");
                    icon: @image-url("../../assets/icons/add-line.svg");
                    clicked => { root.schedule_add(); }
                }
            }
        }

        // ── 专家模式 (Expert Mode) ──
        Rectangle { height: 1px; background: Theme.c1f242e; }

        HorizontalLayout {
            alignment: space-between;
            VerticalLayout {
                spacing: 2px;
                Text { text: @tr("Expert Scheduling Mode"); color: Theme.cf3f4f6; font-size: 13px; font-weight: 600; }
                Text { text: @tr("Fine-tune internal scheduler loop, AIMD dynamic control, chunking, and network transport"); color: Theme.c6b7280; font-size: 11px; }
            }
            ToggleSwitch {
                checked: root.settings_form.scheduler_expert_mode;
                toggled => { root.settings_form.scheduler_expert_mode = !root.settings_form.scheduler_expert_mode; }
            }
        }

        if root.settings_form.scheduler_expert_mode : VerticalLayout {
            spacing: 12px;

            // Preset selector
            VerticalLayout {
                spacing: 4px;
                Text { text: @tr("Expert Configuration Preset:"); color: Theme.c9ca3af; font-size: 12px; }
                CustomSelect {
                    model: [@tr("Custom"), @tr("LAN Ultra (High throughput)"), @tr("Stealth (Low profile)"), @tr("Lossy Network (Aggressive retry)")];
                    current-index <=> root.settings_form.scheduler_expert_preset_idx;
                    height: 36px;
                    selected_index(idx) => {
                        if idx == 1 {
                            // LAN Ultra
                            root.settings_form.scheduler_tick_ms = "50";
                            root.settings_form.scheduler_max_connections_per_host = "32";
                            root.settings_form.scheduler_queue_sort_strategy_idx = 1;
                            root.settings_form.scheduler_aimd_degrade_threshold = "0.95";
                            root.settings_form.scheduler_aimd_increase_threshold = "0.98";
                            root.settings_form.scheduler_aimd_severe_drop_threshold = "0.70";
                            root.settings_form.scheduler_aimd_cooldown_secs = "1";
                            root.settings_form.scheduler_aimd_samples_needed = "1";
                            root.settings_form.scheduler_aimd_probe_stable_cycles = "2";
                            root.settings_form.scheduler_aimd_decrease_factor = "0.85";
                            root.settings_form.scheduler_aimd_step_ratio = "0.50";
                            root.settings_form.scheduler_aimd_oscillation_threshold = "5";
                            root.settings_form.scheduler_aimd_hysteresis_multiplier = "1";
                            root.settings_form.scheduler_custom_chunk_size_mb = "8";
                            root.settings_form.scheduler_tail_sprint_stall_window_secs = "2";
                            root.settings_form.scheduler_tail_sprint_min_split_size_mb = "2";
                            root.settings_form.scheduler_work_steal_min_split_size_mb = "2";
                            root.settings_form.scheduler_connect_timeout_secs = "5";
                            root.settings_form.scheduler_read_timeout_secs = "10";
                            root.settings_form.scheduler_pool_max_idle_per_host = "32";
                            root.settings_form.scheduler_tcp_keepalive_secs = "30";
                            root.settings_form.scheduler_retry_backoff_base_ms = "200";
                            root.settings_form.scheduler_retry_backoff_max_ms = "2000";
                            root.settings_form.scheduler_retry_backoff_jitter_percent = "10";
                        } else if idx == 2 {
                            // Stealth
                            root.settings_form.scheduler_tick_ms = "500";
                            root.settings_form.scheduler_max_connections_per_host = "2";
                            root.settings_form.scheduler_queue_sort_strategy_idx = 2;
                            root.settings_form.scheduler_aimd_degrade_threshold = "0.80";
                            root.settings_form.scheduler_aimd_increase_threshold = "0.90";
                            root.settings_form.scheduler_aimd_severe_drop_threshold = "0.40";
                            root.settings_form.scheduler_aimd_cooldown_secs = "10";
                            root.settings_form.scheduler_aimd_samples_needed = "5";
                            root.settings_form.scheduler_aimd_probe_stable_cycles = "8";
                            root.settings_form.scheduler_aimd_decrease_factor = "0.50";
                            root.settings_form.scheduler_aimd_step_ratio = "0.10";
                            root.settings_form.scheduler_aimd_oscillation_threshold = "2";
                            root.settings_form.scheduler_aimd_hysteresis_multiplier = "2";
                            root.settings_form.scheduler_custom_chunk_size_mb = "1";
                            root.settings_form.scheduler_tail_sprint_stall_window_secs = "10";
                            root.settings_form.scheduler_tail_sprint_min_split_size_mb = "10";
                            root.settings_form.scheduler_work_steal_min_split_size_mb = "10";
                            root.settings_form.scheduler_connect_timeout_secs = "30";
                            root.settings_form.scheduler_read_timeout_secs = "60";
                            root.settings_form.scheduler_pool_max_idle_per_host = "2";
                            root.settings_form.scheduler_tcp_keepalive_secs = "120";
                            root.settings_form.scheduler_retry_backoff_base_ms = "2000";
                            root.settings_form.scheduler_retry_backoff_max_ms = "30000";
                            root.settings_form.scheduler_retry_backoff_jitter_percent = "30";
                        } else if idx == 3 {
                            // Lossy Network
                            root.settings_form.scheduler_tick_ms = "200";
                            root.settings_form.scheduler_max_connections_per_host = "8";
                            root.settings_form.scheduler_queue_sort_strategy_idx = 0;
                            root.settings_form.scheduler_aimd_degrade_threshold = "0.75";
                            root.settings_form.scheduler_aimd_increase_threshold = "0.92";
                            root.settings_form.scheduler_aimd_severe_drop_threshold = "0.30";
                            root.settings_form.scheduler_aimd_cooldown_secs = "5";
                            root.settings_form.scheduler_aimd_samples_needed = "4";
                            root.settings_form.scheduler_aimd_probe_stable_cycles = "6";
                            root.settings_form.scheduler_aimd_decrease_factor = "0.60";
                            root.settings_form.scheduler_aimd_step_ratio = "0.15";
                            root.settings_form.scheduler_aimd_oscillation_threshold = "4";
                            root.settings_form.scheduler_aimd_hysteresis_multiplier = "2";
                            root.settings_form.scheduler_custom_chunk_size_mb = "2";
                            root.settings_form.scheduler_tail_sprint_stall_window_secs = "8";
                            root.settings_form.scheduler_tail_sprint_min_split_size_mb = "5";
                            root.settings_form.scheduler_work_steal_min_split_size_mb = "5";
                            root.settings_form.scheduler_connect_timeout_secs = "15";
                            root.settings_form.scheduler_read_timeout_secs = "45";
                            root.settings_form.scheduler_pool_max_idle_per_host = "8";
                            root.settings_form.scheduler_tcp_keepalive_secs = "45";
                            root.settings_form.scheduler_retry_backoff_base_ms = "500";
                            root.settings_form.scheduler_retry_backoff_max_ms = "10000";
                            root.settings_form.scheduler_retry_backoff_jitter_percent = "25";
                        }
                    }
                }
                Text { text: @tr("Pick a preset or customize individual parameters below"); color: Theme.c6b7280; font-size: 11px; }
            }

            // Group 1: Host Concurrency & Queue Candidate Sorting
            Rectangle {
                background: Theme.c14171d;
                border-color: Theme.c232832;
                border-width: 1px;
                border-radius: 6px;
                VerticalLayout {
                    padding: 12px;
                    spacing: 10px;

                    Text { text: @tr("Host Concurrency & Queue Strategy"); color: Theme.ca3e635; font-size: 12px; font-weight: 700; }

                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("Scheduler Tick Duration:"); color: Theme.c9ca3af; font-size: 12px;
                                Tooltip {
                                    FormTip { text: @tr("Internal scheduler loop period in ms (default 100ms). Lower values react faster to network changes but use slightly more CPU."); }
                                }
                            }
                            UnitInput {
                                text <=> root.settings_form.scheduler_tick_ms;
                                placeholder: "100";
                                unit_text: "ms";
                                edited(_v) => { root.settings_form.scheduler_expert_preset_idx = 0; }
                            }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("Max Connections per Host:"); color: Theme.c9ca3af; font-size: 12px;
                                Tooltip {
                                    FormTip { text: @tr("Concurrency ceiling for a single server domain/host across all tasks (default 16). Prevents triggering server anti-crawling defenses."); }
                                }
                            }
                            UnitInput {
                                text <=> root.settings_form.scheduler_max_connections_per_host;
                                placeholder: "16";
                                unit_text: @tr("conns");
                                edited(_v) => { root.settings_form.scheduler_expert_preset_idx = 0; }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 4px;
                        Text { text: @tr("Queue Candidate Sort Strategy:"); color: Theme.c9ca3af; font-size: 12px;
                            Tooltip {
                                FormTip { text: @tr("Controls which queued task is selected next when threads become available: Priority First (default), Shortest Job First (finishes small downloads quickly), or FIFO (strict queue order)."); }
                            }
                        }
                        CustomSelect {
                            model: [@tr("Priority First"), @tr("Shortest Job First"), @tr("FIFO (First In First Out)")];
                            current-index <=> root.settings_form.scheduler_queue_sort_strategy_idx;
                            height: 36px;
                            selected_index(_i) => { root.settings_form.scheduler_expert_preset_idx = 0; }
                        }
                    }
                }
            }

            // Group 2: AIMD Dynamic Bandwidth & Thread Control
            Rectangle {
                background: Theme.c14171d;
                border-color: Theme.c232832;
                border-width: 1px;
                border-radius: 6px;
                VerticalLayout {
                    padding: 12px;
                    spacing: 10px;

                    Text { text: @tr("AIMD Dynamic Bandwidth & Thread Control"); color: Theme.ca3e635; font-size: 12px; font-weight: 700; }

                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("Degrade Threshold:"); color: Theme.c9ca3af; font-size: 12px;
                                Tooltip {
                                    FormTip { text: @tr("Speed drop ratio (0.50-0.99) that triggers thread reduction (default 0.90 = 10% drop from baseline)."); }
                                }
                            }
                            UnitInput {
                                text <=> root.settings_form.scheduler_aimd_degrade_threshold;
                                placeholder: "0.90";
                                unit_text: "ratio";
                                edited(_v) => { root.settings_form.scheduler_expert_preset_idx = 0; }
                            }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("Increase Threshold:"); color: Theme.c9ca3af; font-size: 12px;
                                Tooltip {
                                    FormTip { text: @tr("Speed ratio relative to baseline (0.70-1.00) required to attempt adding a thread (default 0.95)."); }
                                }
                            }
                            UnitInput {
                                text <=> root.settings_form.scheduler_aimd_increase_threshold;
                                placeholder: "0.95";
                                unit_text: "ratio";
                                edited(_v) => { root.settings_form.scheduler_expert_preset_idx = 0; }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("Severe Drop Threshold:"); color: Theme.c9ca3af; font-size: 12px;
                                Tooltip {
                                    FormTip { text: @tr("Critical speed crash ratio (0.10-0.80) that triggers emergency backoff to minimum threads (default 0.60)."); }
                                }
                            }
                            UnitInput {
                                text <=> root.settings_form.scheduler_aimd_severe_drop_threshold;
                                placeholder: "0.60";
                                unit_text: "ratio";
                                edited(_v) => { root.settings_form.scheduler_expert_preset_idx = 0; }
                            }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("AIMD Cooldown Window:"); color: Theme.c9ca3af; font-size: 12px;
                                Tooltip {
                                    FormTip { text: @tr("Minimum seconds to wait between thread allocation adjustments (default 3s)."); }
                                }
                            }
                            UnitInput {
                                text <=> root.settings_form.scheduler_aimd_cooldown_secs;
                                placeholder: "3";
                                unit_text: "s";
                                edited(_v) => { root.settings_form.scheduler_expert_preset_idx = 0; }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("Stable Samples Needed:"); color: Theme.c9ca3af; font-size: 12px;
                                Tooltip {
                                    FormTip { text: @tr("Number of consecutive steady speed samples required before making an AIMD decision (default 2)."); }
                                }
                            }
                            UnitInput {
                                text <=> root.settings_form.scheduler_aimd_samples_needed;
                                placeholder: "2";
                                unit_text: @tr("samples");
                                edited(_v) => { root.settings_form.scheduler_expert_preset_idx = 0; }
                            }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("Probe Stable Cycles:"); color: Theme.c9ca3af; font-size: 12px;
                                Tooltip {
                                    FormTip { text: @tr("Number of consecutive stable cycles required before probing for thread expansion (default 4)."); }
                                }
                            }
                            UnitInput {
                                text <=> root.settings_form.scheduler_aimd_probe_stable_cycles;
                                placeholder: "4";
                                unit_text: @tr("cycles");
                                edited(_v) => { root.settings_form.scheduler_expert_preset_idx = 0; }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("Decrease Factor:"); color: Theme.c9ca3af; font-size: 12px;
                                Tooltip {
                                    FormTip { text: @tr("Multiplicative decrease multiplier (0.10-0.95) applied to thread count when congestion is detected (default 0.75)."); }
                                }
                            }
                            UnitInput {
                                text <=> root.settings_form.scheduler_aimd_decrease_factor;
                                placeholder: "0.75";
                                unit_text: "mult";
                                edited(_v) => { root.settings_form.scheduler_expert_preset_idx = 0; }
                            }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("Additive Step Ratio:"); color: Theme.c9ca3af; font-size: 12px;
                                Tooltip {
                                    FormTip { text: @tr("Fraction of headroom to add during linear increase (default 0.25)."); }
                                }
                            }
                            UnitInput {
                                text <=> root.settings_form.scheduler_aimd_step_ratio;
                                placeholder: "0.25";
                                unit_text: "ratio";
                                edited(_v) => { root.settings_form.scheduler_expert_preset_idx = 0; }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("Oscillation Threshold:"); color: Theme.c9ca3af; font-size: 12px;
                                Tooltip {
                                    FormTip { text: @tr("Maximum frequency of direction reversals within history window before damping AIMD adjustments (default 3)."); }
                                }
                            }
                            UnitInput {
                                text <=> root.settings_form.scheduler_aimd_oscillation_threshold;
                                placeholder: "3";
                                unit_text: @tr("reversals");
                                edited(_v) => { root.settings_form.scheduler_expert_preset_idx = 0; }
                            }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("Hysteresis Multiplier:"); color: Theme.c9ca3af; font-size: 12px;
                                Tooltip {
                                    FormTip { text: @tr("Damping multiplier for cooldown when oscillation is detected (default 2)."); }
                                }
                            }
                            UnitInput {
                                text <=> root.settings_form.scheduler_aimd_hysteresis_multiplier;
                                placeholder: "2";
                                unit_text: "x";
                                edited(_v) => { root.settings_form.scheduler_expert_preset_idx = 0; }
                            }
                        }
                    }
                }
            }

            // Group 3: Chunking, Tail Sprint & Work Stealing
            Rectangle {
                background: Theme.c14171d;
                border-color: Theme.c232832;
                border-width: 1px;
                border-radius: 6px;
                VerticalLayout {
                    padding: 12px;
                    spacing: 10px;

                    Text { text: @tr("Chunking, Tail Sprint & Work Stealing"); color: Theme.ca3e635; font-size: 12px; font-weight: 700; }

                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("Custom Chunk Size:"); color: Theme.c9ca3af; font-size: 12px;
                                Tooltip {
                                    FormTip { text: @tr("Override download chunk size in MB (0 = automatic adaptive chunk sizing based on content length)."); }
                                }
                            }
                            UnitInput {
                                text <=> root.settings_form.scheduler_custom_chunk_size_mb;
                                placeholder: "0";
                                unit_text: "MB";
                                edited(_v) => { root.settings_form.scheduler_expert_preset_idx = 0; }
                            }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("Tail Sprint Stall Window:"); color: Theme.c9ca3af; font-size: 12px;
                                Tooltip {
                                    FormTip { text: @tr("Seconds of stalled progress on the last remaining chunk before splitting it across idle workers (default 4s)."); }
                                }
                            }
                            UnitInput {
                                text <=> root.settings_form.scheduler_tail_sprint_stall_window_secs;
                                placeholder: "4";
                                unit_text: "s";
                                edited(_v) => { root.settings_form.scheduler_expert_preset_idx = 0; }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("Tail Sprint Min Split Size:"); color: Theme.c9ca3af; font-size: 12px;
                                Tooltip {
                                    FormTip { text: @tr("Minimum chunk size in MB eligible for tail sprint sub-division (default 4MB). Smaller chunks are not split to avoid HTTP overhead."); }
                                }
                            }
                            UnitInput {
                                text <=> root.settings_form.scheduler_tail_sprint_min_split_size_mb;
                                placeholder: "4";
                                unit_text: "MB";
                                edited(_v) => { root.settings_form.scheduler_expert_preset_idx = 0; }
                            }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("Work Stealing Min Split Size:"); color: Theme.c9ca3af; font-size: 12px;
                                Tooltip {
                                    FormTip { text: @tr("Minimum remaining bytes in MB required for an idle worker to steal half of another worker's chunk (default 4MB)."); }
                                }
                            }
                            UnitInput {
                                text <=> root.settings_form.scheduler_work_steal_min_split_size_mb;
                                placeholder: "4";
                                unit_text: "MB";
                                edited(_v) => { root.settings_form.scheduler_expert_preset_idx = 0; }
                            }
                        }
                    }
                }
            }

            // Group 4: Network Transport & Retry Backoff
            Rectangle {
                background: Theme.c14171d;
                border-color: Theme.c232832;
                border-width: 1px;
                border-radius: 6px;
                VerticalLayout {
                    padding: 12px;
                    spacing: 10px;

                    Text { text: @tr("Network Transport & Retry Backoff"); color: Theme.ca3e635; font-size: 12px; font-weight: 700; }

                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("Connect Timeout:"); color: Theme.c9ca3af; font-size: 12px;
                                Tooltip {
                                    FormTip { text: @tr("TCP / TLS handshake timeout in seconds (default 10s)."); }
                                }
                            }
                            UnitInput {
                                text <=> root.settings_form.scheduler_connect_timeout_secs;
                                placeholder: "10";
                                unit_text: "s";
                                edited(_v) => { root.settings_form.scheduler_expert_preset_idx = 0; }
                            }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("Read Timeout:"); color: Theme.c9ca3af; font-size: 12px;
                                Tooltip {
                                    FormTip { text: @tr("Socket read idle timeout in seconds before aborting stalled connection (default 30s)."); }
                                }
                            }
                            UnitInput {
                                text <=> root.settings_form.scheduler_read_timeout_secs;
                                placeholder: "30";
                                unit_text: "s";
                                edited(_v) => { root.settings_form.scheduler_expert_preset_idx = 0; }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("Pool Max Idle per Host:"); color: Theme.c9ca3af; font-size: 12px;
                                Tooltip {
                                    FormTip { text: @tr("Maximum pooled idle persistent connections kept open per host (default 16)."); }
                                }
                            }
                            UnitInput {
                                text <=> root.settings_form.scheduler_pool_max_idle_per_host;
                                placeholder: "16";
                                unit_text: @tr("conns");
                                edited(_v) => { root.settings_form.scheduler_expert_preset_idx = 0; }
                            }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("TCP Keepalive Interval:"); color: Theme.c9ca3af; font-size: 12px;
                                Tooltip {
                                    FormTip { text: @tr("TCP keepalive probe interval in seconds (default 60s)."); }
                                }
                            }
                            UnitInput {
                                text <=> root.settings_form.scheduler_tcp_keepalive_secs;
                                placeholder: "60";
                                unit_text: "s";
                                edited(_v) => { root.settings_form.scheduler_expert_preset_idx = 0; }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("Retry Backoff Base:"); color: Theme.c9ca3af; font-size: 12px;
                                Tooltip {
                                    FormTip { text: @tr("Initial delay for exponential backoff on transient connection failures in ms (default 1000ms)."); }
                                }
                            }
                            UnitInput {
                                text <=> root.settings_form.scheduler_retry_backoff_base_ms;
                                placeholder: "1000";
                                unit_text: "ms";
                                edited(_v) => { root.settings_form.scheduler_expert_preset_idx = 0; }
                            }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("Retry Backoff Max:"); color: Theme.c9ca3af; font-size: 12px;
                                Tooltip {
                                    FormTip { text: @tr("Maximum cap for exponential backoff delay in ms (default 16000ms)."); }
                                }
                            }
                            UnitInput {
                                text <=> root.settings_form.scheduler_retry_backoff_max_ms;
                                placeholder: "16000";
                                unit_text: "ms";
                                edited(_v) => { root.settings_form.scheduler_expert_preset_idx = 0; }
                            }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("Retry Jitter Percent:"); color: Theme.c9ca3af; font-size: 12px;
                                Tooltip {
                                    FormTip { text: @tr("Random jitter percentage (0-100%) added to retry backoff to avoid thundering herd (default 20%)."); }
                                }
                            }
                            UnitInput {
                                text <=> root.settings_form.scheduler_retry_backoff_jitter_percent;
                                placeholder: "20";
                                unit_text: "%";
                                edited(_v) => { root.settings_form.scheduler_expert_preset_idx = 0; }
                            }
                        }
                    }
                }
            }
        }
    }
}
