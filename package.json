{
  "name": "limedl",
  "version": "0.1.4",
  "private": true,
  "description": "Fast multi-protocol download manager — HTTP, BitTorrent, CDN acceleration",
  "license": "GPL-3.0-or-later",
  "author": "limedl contributors",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:nas": "vue-tsc --noEmit && vite build --mode nas",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "oxlint --type-aware --type-check .",
    "format": "oxfmt .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "test:e2e:nas": "playwright test --config e2e/playwright.config.ts --project=nas-webui",
    "test:e2e:nas:ui": "playwright test --config e2e/playwright.config.ts --project=nas-webui --ui",
    "test:e2e:nas:real": "cross-env LIMEDL_E2E_REAL_SERVER=1 playwright test --config e2e/playwright.config.ts --project=nas-webui e2e/tests/integration-real.spec.ts"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@vueuse/core": "^14.3.0",
    "i18next": "^26.3.6",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@iconify-json/ri": "^1.2.10",
    "@playwright/test": "^1.61.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "cross-env": "^10.1.0",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "~6.0.3",
    "unocss": "^66.7.5",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  },
  "packageManager": "pnpm@11.14.0"
}
