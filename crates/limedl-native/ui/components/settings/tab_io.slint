import { ScrollView } from "std-widgets.slint";

import { Theme } from "../../theme.slint";
import { SettingsFormData, DiskTypeOverrideItem } from "../../types.slint";
import {
    CustomSelect,
    CustomTextInput,
    IconButton,
    SecondaryButton,
    ToggleSwitch,
    UnitInput,
} from "../common.slint";
import { FormTip } from "shared.slint";

export component SettingsTabIo inherits ScrollView {
    in-out property <SettingsFormData> settings_form;
    in-out property <[DiskTypeOverrideItem]> disk_type_overrides: [];
    callback toggle_game_mode();
    callback toggle_overclock_mode();
    callback disk_override_add();
    callback disk_override_remove(int);
    callback disk_override_path_edited(int, string);
    callback disk_override_media_selected(int, int);

    VerticalLayout {
        alignment: start;
        padding: 16px;
        spacing: 14px;

        Text { text: @tr("IO Baseline & Performance Modes"); color: Theme.ca3e635; font-size: 13px; font-weight: 700; }

        HorizontalLayout {
            alignment: space-between;
            VerticalLayout {
                spacing: 2px;
                Text { text: @tr("Game Mode"); color: Theme.cf59e0b; font-size: 13px; font-weight: 600; }
                Text { text: @tr("Reduces buffer and IO frequency to minimize latency interference with 3D games"); color: #6b7280; font-size: 11px; }
            }
            ToggleSwitch {
                checked: root.settings_form.game_mode;
                toggled => { root.toggle_game_mode(); }
            }
        }

        HorizontalLayout {
            alignment: space-between;
            VerticalLayout {
                spacing: 2px;
                Text { text: @tr("Overclock Mode"); color: Theme.cec4899; font-size: 13px; font-weight: 600; }
                Text { text: @tr("Aggressive multi-threading to push bandwidth to the hardware limit"); color: #6b7280; font-size: 11px; }
            }
            ToggleSwitch {
                checked: root.settings_form.overclock_mode;
                toggled => { root.toggle_overclock_mode(); }
            }
        }

        Rectangle { height: 1px; background: Theme.c1a1e26; }

        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                spacing: 4px;
                Text { text: @tr("Buffer Pool Limit:"); color: Theme.c9ca3af; font-size: 12px;
                    Tooltip {
                        FormTip { text: @tr("Maximum memory used to buffer HDD downloads. A larger buffer turns more random writes into sequential writes."); }
                    } }
                UnitInput { text <=> root.settings_form.io_buffer_limit_mb; placeholder: "1024"; unit_text: "MB"; }
            }
            VerticalLayout {
                spacing: 4px;
                Text { text: @tr("Game Mode Buffer:"); color: Theme.c9ca3af; font-size: 12px;
                    Tooltip {
                        FormTip { text: @tr("Buffer limit when game mode is active, reducing impact on gaming performance."); }
                    } }
                UnitInput { text <=> root.settings_form.io_game_mode_buffer_mb; placeholder: "128"; unit_text: "MB"; }
            }
        }

        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                spacing: 4px;
                Text { text: @tr("HDD Max Parallel:"); color: Theme.c9ca3af; font-size: 12px;
                    Tooltip {
                        FormTip { text: @tr("Maximum number of HDD downloads that can use the buffer simultaneously. Each gets an equal share of the buffer pool."); }
                    } }
                UnitInput { text <=> root.settings_form.io_max_parallel_hdd; placeholder: "4"; unit_text: @tr("tasks"); }
            }
            VerticalLayout {
                spacing: 4px;
                Text { text: @tr("Game Mode Max Parallel:"); color: Theme.c9ca3af; font-size: 12px;
                    Tooltip {
                        FormTip { text: @tr("Maximum parallel HDD downloads when game mode is active."); }
                    } }
                UnitInput { text <=> root.settings_form.io_game_mode_max_parallel; placeholder: "1"; unit_text: @tr("tasks"); }
            }
        }

        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                alignment: space-between;
                spacing: 2px;
                Text { text: @tr("HDD Double-Buffer Optimization"); color: Theme.cf3f4f6; font-size: 12px; font-weight: 600;
                    Tooltip {
                        FormTip { text: @tr("Enable double-buffer pool optimization for mechanical hard drives to improve write performance. Not needed for SSDs."); }
                    } }
                ToggleSwitch {
                    checked: root.settings_form.io_hdd_buffer_enabled;
                    toggled => { root.settings_form.io_hdd_buffer_enabled = !root.settings_form.io_hdd_buffer_enabled; }
                }
            }
            VerticalLayout {
                spacing: 4px;
                Text { text: @tr("SSD Write Combining (0=auto):"); color: Theme.c9ca3af; font-size: 12px; }
                UnitInput { text <=> root.settings_form.io_ssd_write_combine_mb; placeholder: "0"; unit_text: "MB"; }
            }
        }

        Rectangle { height: 1px; background: Theme.c1a1e26; }

        Rectangle { height: 1px; background: Theme.c1a1e26; }

        // ── Per-directory media overrides ──
        VerticalLayout {
            spacing: 6px;

            HorizontalLayout {
                alignment: space-between;
                VerticalLayout {
                    spacing: 2px;
                    Text { text: @tr("Directory Media Overrides"); color: Theme.cf3f4f6; font-size: 13px; font-weight: 600; }
                    Text {
                        text: @tr("Force the buffer mode for one directory: a NAS share, a WSL path or a virtual disk. Everything inside it follows the longest matching entry.");
                        color: #6b7280;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                }
                io_override_add := SecondaryButton {
                    text: @tr("Add Directory");
                    icon: @image-url("../../assets/icons/add-line.svg");
                    clicked => { root.disk_override_add(); }
                }
            }

            for row[idx] in root.disk_type_overrides : io_override_row := Rectangle {
                background: Theme.c14171d;
                border-color: Theme.c232832;
                border-width: 1px;
                border-radius: 6px;
                height: self.preferred-height;

                VerticalLayout {
                    padding: 10px;
                    spacing: 6px;

                    HorizontalLayout {
                        spacing: 8px;

                        VerticalLayout {
                            spacing: 3px;
                            horizontal-stretch: 4;
                            Text { text: @tr("Directory"); color: Theme.c9ca3af; font-size: 11px; }
                            io_override_path := CustomTextInput {
                                text: row.path;
                                placeholder: @tr("Absolute directory path");
                                edited(value) => { root.disk_override_path_edited(idx, value); }
                            }
                        }

                        VerticalLayout {
                            spacing: 3px;
                            horizontal-stretch: 1;
                            Text { text: @tr("Treat as"); color: Theme.c9ca3af; font-size: 11px; }
                            io_override_media := CustomSelect {
                                model: [@tr("SSD"), @tr("HDD")];
                                current-index: row.media_idx;
                                selected_index(index) => { root.disk_override_media_selected(idx, index); }
                            }
                        }

                        VerticalLayout {
                            alignment: end;
                            IconButton {
                                text: @tr("Remove");
                                icon: @image-url("../../assets/icons/delete-bin-line.svg");
                                text_color: Theme.cf87171;
                                clicked => { root.disk_override_remove(idx); }
                            }
                        }
                    }

                    Text {
                        text: row.detected_text;
                        color: Theme.c38bdf8;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                }
            }
        }

        Rectangle { height: 1px; background: Theme.c1a1e26; }

        VerticalLayout {
            spacing: 4px;
            HorizontalLayout {
                spacing: 6px;
                VerticalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../../assets/icons/hard-drive-2-line.svg");
                        colorize: Theme.c38bdf8;
                        width: 15px;
                        height: 15px;
                        image-fit: contain;
                    }
                }
                Text { text: @tr("Disk Type Detection (SSD / HDD):"); color: Theme.c9ca3af; font-size: 12px; font-weight: 600; vertical-alignment: center; }
            }
            Text { text: root.settings_form.disk_type_text; color: Theme.c38bdf8; font-size: 12px; wrap: word-wrap; }
        }

        VerticalLayout {
            spacing: 4px;
            HorizontalLayout {
                spacing: 6px;
                VerticalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../../assets/icons/cpu-line.svg");
                        colorize: Theme.ca3e635;
                        width: 15px;
                        height: 15px;
                        image-fit: contain;
                    }
                }
                Text { text: @tr("Buffer Pool Status:"); color: Theme.c9ca3af; font-size: 12px; font-weight: 600; vertical-alignment: center; }
            }
            Text { text: root.settings_form.io_status_text; color: Theme.ca3e635; font-size: 12px; }
        }
    }
}
