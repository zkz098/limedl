    {
      "id": "claim_4d796343b2b4420e8767392f5c349cc8",
      "statement": "SystemContext::new creates a default RateLimiter and an EventBus with capacity 8192, then delegates to with_components, which derives the settings path as state_dir's parent joined with settings.json.",
      "evidence": [
        {
          "resource": "repo://crates/limedl-core/src/context.rs#L31-L55",
