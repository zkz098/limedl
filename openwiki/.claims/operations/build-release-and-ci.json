    {
      "id": "claim_b68278df618d40d58541f22992b396c1",
      "statement": "rust-cache's key is v0-rust-<shared-key>-<os>-<arch>-<envHash>-<lockHash>: envHash covers the installed Rust toolchain versions and every RUST*/CARGO*/CC*/CFLAGS*/CXX*/CMAKE* environment variable, while lockHash hashes workspace Cargo.toml files with package.version normalised to 0.0.0 and path dependencies blanked, the external packages of Cargo.lock, and the raw bytes of .cargo/config.toml and rust-toolchain*.",
      "evidence": [
        {
          "resource": "repo://docs/ci-operations.md#L39-L57",
          "version": "repo-lines-v1:sha256:63ebf53bd17eef14ae2006cb0e936e25fb5d684bc78cabcfc2a16a7136eb350a:"
        }
      ]
    },
    {
      "id": "claim_fd85517cb004442e87092e62f50e754c",
      "statement": "Because .cargo/config.toml is hashed as raw bytes, a Windows CRLF checkout produces a different lockHash than Linux/macOS on the same commit (measured 75a17e6d vs 73b11a8a), so cache keys are never expected to be equal across operating systems.",
      "evidence": [
        {
          "resource": "repo://docs/ci-operations.md#L53-L57",
          "version": "repo-lines-v1:sha256:d109e03d6a92fbd23aedf9100ac88cb50e27dd8afaeab57105aa4320ed3d8804:"
        }
