import { IconButton, PrimaryButton, SecondaryButton, UnitInput } from "common.slint";

import { Theme } from "../theme.slint";
import { IconButton, PrimaryButton, SecondaryButton, UnitInput } from "common.slint";

export component SpeedLimitDialog inherits Rectangle {
    in-out property <string> speed_limit_dl_kb: "0";
    in-out property <string> speed_limit_ul_kb: "0";

    callback close();
    callback submit(string, string);

    width: 100%;
    height: 100%;
    background: Theme.c000000bb;

    TouchArea {}

    Rectangle {
        width: 420px;
        height: 280px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.c171a20;
        border-color: Theme.c2e3542;
        border-width: 1px;
        border-radius: 12px;
        drop-shadow-blur: 24px;
        drop-shadow-color: Theme.c000000cc;

        VerticalLayout {
            padding: 22px;
            spacing: 16px;

            HorizontalLayout {
                alignment: space-between;
                Text {
                    text: @tr("Task Speed Limit");
                    color: Theme.cf3f4f6;
                    font-size: 15px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                IconButton {
                    icon: @image-url("../assets/icons/close-line.svg");
                    clicked => { root.close(); }
                }
            }

            VerticalLayout {
                spacing: 4px;
                Text { text: @tr("Download Rate Limit (0 for unlimited):"); color: Theme.c9ca3af; font-size: 12px; }
                UnitInput {
                    text <=> root.speed_limit_dl_kb;
                    placeholder: "0";
                    unit_text: "KB/s";
                }
            }

            VerticalLayout {
                spacing: 4px;
                Text { text: @tr("Upload Rate Limit (0 for unlimited):"); color: Theme.c9ca3af; font-size: 12px; }
                UnitInput {
                    text <=> root.speed_limit_ul_kb;
                    placeholder: "0";
                    unit_text: "KB/s";
                }
            }

            Rectangle {}

            HorizontalLayout {
                alignment: end;
                spacing: 10px;
                SecondaryButton {
                    text: @tr("Cancel");
                    clicked => { root.close(); }
                }
                PrimaryButton {
                    text: @tr("Apply Speed Limit");
                    icon: @image-url("../assets/icons/speed-up-line.svg");
                    clicked => {
                        root.submit(root.speed_limit_dl_kb, root.speed_limit_ul_kb);
                    }
                }
            }
        }
    }
}
