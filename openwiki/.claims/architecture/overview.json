    {
      "id": "claim_9c0d5dcff6e1458e835a784c7889c1d7",
      "statement": "TaskId variants are Http(Uuid) and Bt(Id20), wire-serialize as http:<uuid> / bt:<hex>, deliberately do not implement Serialize/Deserialize, and expose kind() as the routing key.",
