                                            HorizontalLayout { padding: 10px; Text { text: @tr("MSE/PE protocol encryption. Forced mode may reject unencrypted connections. irontide only."); wrap: word-wrap; color: Theme.cf3f4f6; font-size: 12px; vertical-alignment: center; } }
                                        }
                                    } }
                                ComboBox {
                                    model: [@tr("Enabled"), @tr("Disabled"), @tr("Forced")];
