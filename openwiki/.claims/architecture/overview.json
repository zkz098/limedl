  "claims": [
    {
      "id": "claim_50e14f0840f8483a9aa585a5b612f644",
      "statement": "The workspace has twelve members — nine engine crates (limedl-types, limedl-disk, limedl-store, limedl-http, limedl-engine, limedl-bt, limedl-core, limedl-rpc, limedl-testkit), the two frontends (limedl-native, limedl-server) and xtask — inherits version and license from the root manifest, and uses Rust edition 2024 in every crate.",
      "evidence": [
        {
          "resource": "repo://Cargo.toml#L1-L16",
          "version": "repo-lines-v1:sha256:4a90642e66f5044286f65416b57accb688391ab5b79205d059ccffa5222335bd:"
        }
      ]
    },
    {
      "id": "claim_a33322039352460f8d166f4fa75ff397",
      "statement": "limedl-core (lib name limedl_core) is now the facade over nine engine crates — manager, dispatcher, context, backend_registry, bootstrap, logging — and declares no GUI dependency; its lib.rs is mostly module re-exports, which is what keeps the engine's historical crate:: paths resolving.",
      "evidence": [
        {
          "resource": "repo://crates/limedl-core/Cargo.toml#L14-L30",
          "version": "repo-lines-v1:sha256:33ca0e4b1bebc000e361adfeac2f147f09f38a9e734cf9088a6b734068d25fbb:"
