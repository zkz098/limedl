import { TaskItem } from "../types.slint";
import { CustomCheckBox, IconButton, StatusBadge } from "common.slint";

export component TaskCard inherits Rectangle {
    in property <TaskItem> item;
    callback toggle_select();
    callback open_inspector();
    callback pause_task();
    callback resume_task();
    callback open_explorer();
    callback remove_task();
    callback show_menu(length, length);

    background: root.item.selected ? #1c2618 : (ta.has_hover ? #191c22 : #13161b);
    border-color: root.item.selected ? #65a30d : (ta.has_hover ? #323845 : #22262f);
    border-width: 1px;
    border-radius: 8px;
    height: 104px;

    ta := TouchArea {
        pointer-event(event) => {
            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                root.show_menu(self.mouse-x, self.mouse-y);
            }
        }
    }

    HorizontalLayout {
        padding: 12px;
        spacing: 12px;

        // Selection Checkbox
        VerticalLayout {
            alignment: center;
            CustomCheckBox {
                checked: root.item.selected;
                toggled => { root.toggle_select(); }
            }
        }

        // Main Details
        VerticalLayout {
            spacing: 8px;
            alignment: center;

            // Top Row: Badge, Title, Speed, Status
            HorizontalLayout {
                spacing: 8px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    // Kind badge
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            background: root.item.kind == "bt" ? #152c42 : #153920;
                            border-color: root.item.kind == "bt" ? #255078 : #276238;
                            border-width: 1px;
                            border-radius: 4px;
                            height: 20px;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                alignment: center;
                                Text {
                                    text: root.item.kind == "bt" ? "BT" : "HTTP";
                                    color: root.item.kind == "bt" ? #38bdf8 : #4ade80;
                                    font-size: 10px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // File Name
                    Text {
                        text: root.item.file_name;
                        color: #f3f4f6;
                        font-size: 14px;
                        font-weight: 600;
                        overflow: elide;
                        max-width: 440px;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;

                    // Speed
                    if root.item.speed_text != "" : Text {
                        text: root.item.speed_text;
                        color: #84cc16;
                        font-size: 12px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    // Status Badge with Dot Indicator
                    VerticalLayout {
                        alignment: center;
                        StatusBadge {
                            state_code: root.item.state_code;
                            state_label: root.item.state_label;
                        }
                    }
                }
            }

            // Progress Bar
            Rectangle {
                background: #1e2229;
                border-radius: 3px;
                height: 5px;

                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: parent.width * max(0.0, min(1.0, root.item.progress));
                    height: parent.height;
                    background: root.item.state_code == "completed" ? #38bdf8 : (
                        root.item.state_code == "failed" ? #ef4444 : #84cc16
                    );
                    border-radius: 3px;
                }
            }

            // Bottom Row: Size & ETA, Actions
            HorizontalLayout {
                alignment: space-between;

                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    Text {
                        text: root.item.size_text;
                        color: #9ca3af;
                        font-size: 12px;
                        vertical-alignment: center;
                    }

                    if root.item.eta_text != "" : Text {
                        text: root.item.eta_text;
                        color: #626c7d;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    alignment: end;

                    IconButton {
                        text: @tr("Details");
                        icon: @image-url("../assets/icons/information-line.svg");
                        text_color: #38bdf8;
                        clicked => { root.open_inspector(); }
                    }

                    if root.item.can_pause : IconButton {
                        text: @tr("Pause");
                        icon: @image-url("../assets/icons/pause-line.svg");
                        text_color: #facc15;
                        clicked => { root.pause_task(); }
                    }

                    if root.item.can_resume : IconButton {
                        text: @tr("Resume");
                        icon: @image-url("../assets/icons/play-line.svg");
                        text_color: #4ade80;
                        clicked => { root.resume_task(); }
                    }

                    IconButton {
                        text: @tr("Folder");
                        icon: @image-url("../assets/icons/folder-open-line.svg");
                        text_color: #9ca3af;
                        clicked => { root.open_explorer(); }
                    }

                    IconButton {
                        icon: @image-url("../assets/icons/more-2-fill.svg");
                        text_color: #9ca3af;
                        clicked => { root.show_menu(parent.width - 120px, 40px); }
                    }
                }
            }
        }
    }
}
