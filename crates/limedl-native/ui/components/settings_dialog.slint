                                            border-width: 1px;
        border-color: Theme.c2e3542;
                                            border-radius: 8px;
                                            max-width: 520px;
                                            HorizontalLayout { padding: 10px; Text { text: @tr("Peers sending back less than this share of what they take are treated as leechers. 0 disables the ratio check."); wrap: word-wrap; color: Theme.cf3f4f6; font-size: 12px; vertical-alignment: center; } }
                                        }
                                    } }
                                CustomTextInput { text <=> root.settings_form.bt_anti_leech_ratio; placeholder: "0.1"; }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Ban Duration:"); color: Theme.c9ca3af; font-size: 12px;
                                    Tooltip {
