import { ScrollView } from "std-widgets.slint";
import { Theme, ColorModePref } from "theme.slint";

// Bundled MiSans VF variable font (family "MiSans VF", wght 150-700). Embedded
// into the binary at compile time and auto-registered at startup, so every
// platform renders with the same typeface. The .ttf is NOT in git (MiSans
// license forbids re-distributing the font file itself); fetch it with
// scripts/fetch-misans.ps1 — build.rs fails with the same instruction if missing.
import "../assets/fonts/MiSansVF.ttf";

export { Theme, ColorModePref }
export {
    TaskItem,
    PeerItem,
    TrackerItem,
    TorrentFileItem,
    InspectorInfo,
    SettingsFormData,
    ContextMenuState,
    CdnCandidateItem,
    UrlRewriteTargetItem,
    UrlRewriteRuleItem,
    LabsFormData,
} from "types.slint";

import {
    TaskItem,
    PeerItem,
    TrackerItem,
    TorrentFileItem,
    InspectorInfo,
    SettingsFormData,
    ContextMenuState,
    CdnCandidateItem,
    UrlRewriteTargetItem,
    UrlRewriteRuleItem,
    LabsFormData,
    UpdateState,
} from "types.slint";

import {
    CategoryButton,
    IconButton,
    PrimaryButton,
    SearchInput,
    SecondaryButton,
} from "components/common.slint";

import { TaskCard } from "components/task_card.slint";
import { ContextMenu } from "components/context_menu.slint";
import { NewTaskDialog } from "components/new_task_dialog.slint";
import { TaskInspector } from "components/inspector.slint";
import { SpeedLimitDialog } from "components/speed_limit_dialog.slint";
import { SettingsDialog } from "components/settings_dialog.slint";
import { LabsDialog } from "components/labs_dialog.slint";

export component MainWindow inherits Window {
    title: "limedl - Native";
    icon: @image-url("assets/icon.png");
    min-width: 1000px;
    min-height: 660px;
    // NOTE: font-family in Slint is a SINGLE family name (no CSS fallback
    // stacks). MiSans VF is bundled via the import above, so this resolves on
    // every platform and all UI text renders with the same typeface; glyphs
    // missing from MiSans (emoji, rare Han) still fall back to system fonts.
    default-font-family: "MiSans VF";
    background: Theme.c0d0f12;

    // State properties
    in property <[TaskItem]> tasks: [];
    in property <int> active_category: 0; // 0: All, 1: Downloading, 2: Paused, 3: Completed, 4: Failed
    in property <string> count_all: "0";
    in property <string> count_downloading: "0";
    in property <string> count_paused: "0";
    in property <string> count_completed: "0";
    in property <string> count_failed: "0";
    in property <string> global_speed_text: "0 B/s";
    in property <string> default_download_dir: "";
    in property <bool> show_new_task_dialog: false;

    // Search & Sort state
    in-out property <string> search_query: "";
    in property <int> sort_field: 0; // 0: Created, 1: Size, 2: Speed, 3: Progress, 4: Name
    in property <bool> sort_asc: false;
    in property <int> selected_count: 0;

    // Phase 3: Inspector state
    in property <bool> show_inspector: false;
    in property <InspectorInfo> inspector_info;
    in property <int> inspector_tab: 0;
    in property <[PeerItem]> inspector_peers: [];
    in property <[TrackerItem]> inspector_trackers: [];
    in property <[TorrentFileItem]> inspector_files: [];
    in property <image> inspector_piece_map;
    in property <string> inspector_pieces_count_text: "";
    in property <bool> show_speed_limit_dialog: false;
    in-out property <string> speed_limit_dl_kb: "0";
    in-out property <string> speed_limit_ul_kb: "0";

    // Phase 4: Settings & Performance Modes state
    in property <bool> show_settings: false;
    in property <int> settings_tab: 0;
    in-out property <SettingsFormData> settings_form;
    in property <bool> game_mode_active: false;
    in property <bool> overclock_mode_active: false;

    // Self-update state (rendered in Settings → About)
    in-out property <UpdateState> update_state: {
        phase: "idle",
        latest_version: "",
        notes: "",
        progress_percent: 0,
        progress_label: "",
        error_text: "",
        install_kind: "portable",
    };

    // Phase 6: Labs (CDN Acceleration & URL Rewrite) state
    in property <bool> show_labs: false;
    in property <int> labs_tab: 0;
    in-out property <LabsFormData> labs_form;
    in property <[CdnCandidateItem]> cdn_candidates: [];
    in property <[UrlRewriteRuleItem]> rewrite_rules: [];

    // Context Menu state
    in-out property <ContextMenuState> context_menu_state: {
        visible: false,
        x: 0px,
        y: 0px,
        task_id: "",
        task_name: "",
        task_url: "",
        can_pause: false,
        can_resume: false,
        is_bt: false,
    };

    // New task form fields
    in-out property <string> new_task_url: "";
    in-out property <string> new_task_dir: "";
    in-out property <string> new_task_filename: "";

    // Callbacks to Rust
    callback select_category(int);
    callback open_new_task_dialog();
    callback close_new_task_dialog();
    callback submit_new_task(string, string, string);
    callback pause_all();
    callback resume_all();
    callback pause_task(string);
    callback resume_task(string);
    callback open_task_explorer(string);
    callback remove_task(string);

    // Phase 2 Callbacks
    callback search_changed(string);
    callback set_sort_field(int);
    callback toggle_sort_asc();
    callback toggle_select_task(string);
    callback select_all();
    callback clear_selection();
    callback batch_pause();
    callback batch_resume();
    callback batch_remove(bool);

    // Phase 3 Callbacks
    callback open_inspector(string);
    callback close_inspector();
    callback set_inspector_tab(int);
    callback open_speed_limit_dialog();
    callback close_speed_limit_dialog();
    callback submit_speed_limit(string, string);

    // Phase 4 Settings Callbacks
    callback open_settings();
    callback close_settings();
    callback set_settings_tab(int);
    callback save_settings(SettingsFormData);
    callback toggle_game_mode();
    callback toggle_overclock_mode();
    callback fetch_trackers_remote(string);

    // Self-update callbacks
    callback check_for_updates();
    callback start_update_download();
    callback restart_after_update();

    // Phase 6 Labs Callbacks
    callback open_labs();
    callback close_labs();
    callback set_labs_tab(int);
    callback save_labs(LabsFormData);
    callback start_cdn_test();
    callback cancel_cdn_test();
    callback clear_cdn_test();
    callback apply_cdn_candidate(string, float);
    callback toggle_cdn_advanced();
    callback apply_manual_cdn_ip(string);
    callback import_rewrite_preset(string);
    callback add_custom_rule();
    callback remove_rule(int);
    callback toggle_rule_expanded(int);
    callback toggle_rule_enabled(int);
    callback update_rule_name(int, string);
    callback update_rule_match_type(int, string);
    callback update_rule_pattern(int, string);
    callback update_rule_mode(int, string);
    callback toggle_rule_encode(int);
    callback toggle_rule_fallback(int);
    callback add_rule_target(int);
    callback remove_rule_target(int, int);
    callback update_rule_target(int, int, string);
    callback toggle_rule_target(int, int);
    callback test_url_changed(string);

    // Phase 5 Native Pickers & Clipboard Callbacks
    callback pick_torrent_file();
    callback pick_save_folder();
    callback pick_default_folder();
    callback pick_log_folder();
    callback open_log_folder();
    callback open_font_license();
    callback copy_task_url(string);
    callback purge_single_task(string);

    HorizontalLayout {
        // Left Sidebar
        Rectangle {
            width: 220px;
            background: Theme.c12151a;
            border-color: Theme.c20242d;
            border-width: 1px;

            VerticalLayout {
                padding-top: 18px;
                padding-bottom: 16px;
                padding-left: 16px;
                padding-right: 16px;
                spacing: 16px;

                // App Brand
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("assets/logo.png");
                            width: 32px;
                            height: 32px;
                            image-fit: contain;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        Text {
                            text: "limedl";
                            color: Theme.cf3f4f6;
                            font-size: 16px;
                            font-weight: 700;
                        }
                        Text {
                            text: "Native Edition";
                            color: Theme.c84cc16;
                            font-size: 10px;
                            font-weight: 600;
                        }
                    }
                }

                // Category List
                VerticalLayout {
                    spacing: 4px;
                    CategoryButton {
                        title: @tr("All Tasks");
                        icon_source: @image-url("assets/icons/download-cloud-2-line.svg");
                        count_text: root.count_all;
                        active: root.active_category == 0;
                        clicked => { root.select_category(0); }
                    }
                    CategoryButton {
                        title: @tr("Downloading");
                        icon_source: @image-url("assets/icons/download-line.svg");
                        count_text: root.count_downloading;
                        active: root.active_category == 1;
                        clicked => { root.select_category(1); }
                    }
                    CategoryButton {
                        title: @tr("Paused");
                        icon_source: @image-url("assets/icons/pause-circle-line.svg");
                        count_text: root.count_paused;
                        active: root.active_category == 2;
                        clicked => { root.select_category(2); }
                    }
                    CategoryButton {
                        title: @tr("Completed");
                        icon_source: @image-url("assets/icons/checkbox-circle-line.svg");
                        count_text: root.count_completed;
                        active: root.active_category == 3;
                        clicked => { root.select_category(3); }
                    }
                    CategoryButton {
                        title: @tr("Failed / Error");
                        icon_source: @image-url("assets/icons/error-warning-line.svg");
                        count_text: root.count_failed;
                        active: root.active_category == 4;
                        clicked => { root.select_category(4); }
                    }
                }

                // Spacer
                Rectangle {}

                // Quick Mode Controls (Game Mode & Overclock)
                VerticalLayout {
                    spacing: 6px;

                    Rectangle {
                        background: root.game_mode_active ? Theme.c351d0b : Theme.c181b22;
                        border-color: root.game_mode_active ? Theme.cf59e0b : Theme.c252b36;
                        border-width: 1px;
                        border-radius: 6px;
                        height: 34px;

                        TouchArea {
                            clicked => { root.toggle_game_mode(); }
                        }

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            alignment: space-between;
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("assets/icons/gamepad-line.svg");
                                        colorize: root.game_mode_active ? Theme.cf59e0b : Theme.c8b95a5;
                                        width: 15px;
                                        height: 15px;
                                        image-fit: contain;
                                    }
                                }
                                Text {
                                    text: @tr("Game Mode");
                                    color: root.game_mode_active ? Theme.cf59e0b : Theme.c9ca3af;
                                    font-size: 12px;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: root.game_mode_active ? "ON" : "OFF";
                                color: root.game_mode_active ? Theme.cfcd34d : Theme.c5d6778;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle {
                        background: root.overclock_mode_active ? Theme.c31132b : Theme.c181b22;
                        border-color: root.overclock_mode_active ? Theme.cec4899 : Theme.c252b36;
                        border-width: 1px;
                        border-radius: 6px;
                        height: 34px;

                        TouchArea {
                            clicked => { root.toggle_overclock_mode(); }
                        }

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            alignment: space-between;
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("assets/icons/rocket-line.svg");
                                        colorize: root.overclock_mode_active ? Theme.cec4899 : Theme.c8b95a5;
                                        width: 15px;
                                        height: 15px;
                                        image-fit: contain;
                                    }
                                }
                                Text {
                                    text: @tr("Overclock Mode");
                                    color: root.overclock_mode_active ? Theme.cec4899 : Theme.c9ca3af;
                                    font-size: 12px;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: root.overclock_mode_active ? "ON" : "OFF";
                                color: root.overclock_mode_active ? Theme.cf472b6 : Theme.c5d6778;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Global Speed Widget
                Rectangle {
                    background: Theme.c181b22;
                    border-color: Theme.c252b36;
                    border-width: 1px;
                    border-radius: 8px;
                    height: 56px;

                    VerticalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        alignment: space-around;
                        Text {
                            text: @tr("Realtime Download Speed");
                            color: Theme.c8b95a5;
                            font-size: 10px;
                            font-weight: 500;
                        }
                        Text {
                            text: root.global_speed_text;
                            color: Theme.c84cc16;
                            font-size: 15px;
                            font-weight: 700;
                        }
                    }
                }

                // Settings & Labs Buttons
                HorizontalLayout {
                    spacing: 8px;

                    // Settings Button
                    Rectangle {
                        background: ta_set.has_hover ? Theme.c222731 : Theme.c181b22;
                        border-color: Theme.c252b36;
                        border-width: 1px;
                        border-radius: 6px;
                        height: 36px;

                        ta_set := TouchArea {
                            clicked => { root.open_settings(); }
                        }

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            alignment: center;
                            spacing: 6px;

                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("assets/icons/settings-3-line.svg");
                                    colorize: ta_set.has_hover ? Theme.cffffff : Theme.cd1d5db;
                                    width: 15px;
                                    height: 15px;
                                    image-fit: contain;
                                }
                            }

                            Text {
                                text: @tr("Settings");
                                color: ta_set.has_hover ? Theme.cffffff : Theme.cd1d5db;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Labs Button
                    Rectangle {
                        background: ta_lab.has_hover ? Theme.c222731 : Theme.c181b22;
                        border-color: Theme.c252b36;
                        border-width: 1px;
                        border-radius: 6px;
                        height: 36px;

                        ta_lab := TouchArea {
                            clicked => { root.open_labs(); }
                        }

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            alignment: center;
                            spacing: 6px;

                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("assets/icons/flask-line.svg");
                                    colorize: ta_lab.has_hover ? Theme.ca3e635 : Theme.cd1d5db;
                                    width: 15px;
                                    height: 15px;
                                    image-fit: contain;
                                }
                            }

                            Text {
                                text: @tr("Labs");
                                color: ta_lab.has_hover ? Theme.ca3e635 : Theme.cd1d5db;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // Right Main Content
        VerticalLayout {
            // Top Toolbar with vertical centering and proper padding
            Rectangle {
                height: 62px;
                background: Theme.c111419;
                border-color: Theme.c20242d;
                border-width: 1px;

                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-top: 14px;
                    padding-bottom: 14px;
                    alignment: space-between;

                    // Left Title & Search
                    HorizontalLayout {
                        spacing: 16px;
                        alignment: start;

                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: root.active_category == 0 ? @tr("All Tasks") : (
                                    root.active_category == 1 ? @tr("Downloading") : (
                                        root.active_category == 2 ? @tr("Paused") : (
                                            root.active_category == 3 ? @tr("Completed") : @tr("Failed / Error")
                                        )
                                    )
                                );
                                color: Theme.cf3f4f6;
                                font-size: 16px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            SearchInput {
                                text <=> root.search_query;
                                text_changed(q) => { root.search_changed(q); }
                            }
                        }
                    }

                    // Middle / Right Actions
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;

                        // Sort Buttons
                        HorizontalLayout {
                            spacing: 4px;
                            alignment: center;

                            Text {
                                text: @tr("Sort:");
                                color: #6b7280;
                                font-size: 11px;
                                vertical-alignment: center;
                            }

                            SecondaryButton {
                                text: @tr("Time");
                                active: root.sort_field == 0;
                                clicked => { root.set_sort_field(0); }
                            }
                            SecondaryButton {
                                text: @tr("Size");
                                active: root.sort_field == 1;
                                clicked => { root.set_sort_field(1); }
                            }
                            SecondaryButton {
                                text: @tr("Speed");
                                active: root.sort_field == 2;
                                clicked => { root.set_sort_field(2); }
                            }
                            SecondaryButton {
                                text: @tr("Progress");
                                active: root.sort_field == 3;
                                clicked => { root.set_sort_field(3); }
                            }

                            IconButton {
                                text: root.sort_asc ? @tr("Ascending") : @tr("Descending");
                                icon: @image-url("assets/icons/arrow-up-down-line.svg");
                                text_color: Theme.ca3e635;
                                clicked => { root.toggle_sort_asc(); }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 1px;
                                height: 20px;
                                background: Theme.c242934;
                            }
                        }

                        SecondaryButton {
                            text: @tr("Pause All");
                            icon: @image-url("assets/icons/pause-line.svg");
                            clicked => { root.pause_all(); }
                        }

                        SecondaryButton {
                            text: @tr("Resume All");
                            icon: @image-url("assets/icons/play-line.svg");
                            clicked => { root.resume_all(); }
                        }

                        PrimaryButton {
                            text: @tr("New Task");
                            icon: @image-url("assets/icons/add-line.svg");
                            clicked => { root.open_new_task_dialog(); }
                        }
                    }
                }
            }

            // Task List Area & Floating BatchActionBar
            Rectangle {
                background: Theme.c0d0f12;

                if root.tasks.length == 0 : VerticalLayout {
                    alignment: center;
                    spacing: 12px;
                    Text {
                        text: root.search_query != "" ? @tr("No matching download tasks found") : @tr("No download tasks");
                        color: #6b7280;
                        font-size: 16px;
                        font-weight: 500;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: root.search_query != "" ? @tr("Try clearing your search keywords") : @tr("Click \"New Task\" in the top-right corner to add HTTP / BT downloads");
                        color: Theme.c4b5563;
                        font-size: 13px;
                        horizontal-alignment: center;
                    }
                }

                if root.tasks.length > 0 : ScrollView {
                    viewport-y: 0;
                    VerticalLayout {
                        padding-left: 18px;
                        padding-right: 18px;
                        padding-top: 18px;
                        padding-bottom: root.selected_count > 0 ? 72px : 18px;
                        spacing: 10px;
                        alignment: start;

                        for task[idx] in root.tasks : TaskCard {
                            item: task;
                            toggle_select => { root.toggle_select_task(task.id); }
                            open_inspector => { root.open_inspector(task.id); }
                            pause_task => { root.pause_task(task.id); }
                            resume_task => { root.resume_task(task.id); }
                            open_explorer => { root.open_task_explorer(task.id); }
                            remove_task => { root.remove_task(task.id); }
                            show_menu(mx, my) => {
                                root.context_menu_state = {
                                    visible: true,
                                    x: mx + 240px,
                                    y: my + 86px + (idx * 114px),
                                    task_id: task.id,
                                    task_name: task.file_name,
                                    task_url: task.url,
                                    can_pause: task.can_pause,
                                    can_resume: task.can_resume,
                                    is_bt: task.kind == "bt",
                                };
                            }
                        }
                    }
                }

                // Floating Batch Action Bar
                if root.selected_count > 0 : Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: parent.height - self.height - 16px;
                    width: min(parent.width - 40px, 700px);
                    height: 52px;
                    background: Theme.c181b22;
                    border-color: Theme.c84cc16;
                    border-width: 1px;
                    border-radius: 10px;
                    drop-shadow-blur: 20px;
                    drop-shadow-color: Theme.c000000cc;

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;

                            Text {
                                text: @tr("Selected ") + root.selected_count + @tr(" tasks");
                                color: Theme.c84cc16;
                                font-size: 13px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }

                            IconButton {
                                text: @tr("Select All");
                                text_color: Theme.c9ca3af;
                                clicked => { root.select_all(); }
                            }

                            IconButton {
                                text: @tr("Deselect");
                                text_color: Theme.c9ca3af;
                                clicked => { root.clear_selection(); }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;

                            SecondaryButton {
                                text: @tr("Pause Selected");
                                icon: @image-url("assets/icons/pause-line.svg");
                                clicked => { root.batch_pause(); }
                            }

                            SecondaryButton {
                                text: @tr("Resume Selected");
                                icon: @image-url("assets/icons/play-line.svg");
                                clicked => { root.batch_resume(); }
                            }

                            SecondaryButton {
                                text: @tr("Remove Records");
                                icon: @image-url("assets/icons/delete-bin-line.svg");
                                clicked => { root.batch_remove(false); }
                            }

                            PrimaryButton {
                                text: @tr("Delete Files");
                                icon: @image-url("assets/icons/delete-bin-6-line.svg");
                                clicked => { root.batch_remove(true); }
                            }
                        }
                    }
                }
            }
        }
    }

    // Context Menu Overlay
    if root.context_menu_state.visible : ContextMenu {
        menu_state: root.context_menu_state;
        close => { root.context_menu_state.visible = false; }
        open_inspector(id) => { root.open_inspector(id); }
        pause_task(id) => { root.pause_task(id); }
        resume_task(id) => { root.resume_task(id); }
        open_explorer(id) => { root.open_task_explorer(id); }
        copy_url(url) => { root.copy_task_url(url); }
        open_speed_limit(id) => { root.open_inspector(id); root.open_speed_limit_dialog(); }
        remove_task(id) => { root.remove_task(id); }
        purge_task(id) => { root.purge_single_task(id); }
    }

    // Dialog: Settings Center
    if root.show_settings : SettingsDialog {
        settings_tab: root.settings_tab;
        settings_form <=> root.settings_form;
        update_state <=> root.update_state;
        close => { root.close_settings(); }
        set_tab(tab) => { root.set_settings_tab(tab); }
        save(form) => { root.save_settings(form); }
        toggle_game_mode => { root.toggle_game_mode(); }
        toggle_overclock_mode => { root.toggle_overclock_mode(); }
        fetch_trackers(url) => { root.fetch_trackers_remote(url); }
        pick_default_folder => { root.pick_default_folder(); }
        pick_log_folder => { root.pick_log_folder(); }
        open_log_folder => { root.open_log_folder(); }
        open_font_license => { root.open_font_license(); }
        check_updates => { root.check_for_updates(); }
        start_download => { root.start_update_download(); }
        restart_now => { root.restart_after_update(); }
    }

    // Dialog: Labs (CDN Acceleration & URL Rewrite)
    if root.show_labs : LabsDialog {
        labs_tab: root.labs_tab;
        labs_form <=> root.labs_form;
        cdn_candidates: root.cdn_candidates;
        rewrite_rules: root.rewrite_rules;
        close => { root.close_labs(); }
        set_tab(tab) => { root.set_labs_tab(tab); }
        save_labs(data) => { root.save_labs(data); }
        start_cdn_test => { root.start_cdn_test(); }
        cancel_cdn_test => { root.cancel_cdn_test(); }
        clear_cdn_test => { root.clear_cdn_test(); }
        apply_cdn_candidate(ip, tp) => { root.apply_cdn_candidate(ip, tp); }
        toggle_cdn_advanced => { root.toggle_cdn_advanced(); }
        apply_manual_cdn_ip(ip) => { root.apply_manual_cdn_ip(ip); }
        import_rewrite_preset(p) => { root.import_rewrite_preset(p); }
        add_custom_rule => { root.add_custom_rule(); }
        remove_rule(idx) => { root.remove_rule(idx); }
        toggle_rule_expanded(idx) => { root.toggle_rule_expanded(idx); }
        toggle_rule_enabled(idx) => { root.toggle_rule_enabled(idx); }
        update_rule_name(idx, name) => { root.update_rule_name(idx, name); }
        update_rule_match_type(idx, mt) => { root.update_rule_match_type(idx, mt); }
        update_rule_pattern(idx, pat) => { root.update_rule_pattern(idx, pat); }
        update_rule_mode(idx, mode) => { root.update_rule_mode(idx, mode); }
        toggle_rule_encode(idx) => { root.toggle_rule_encode(idx); }
        toggle_rule_fallback(idx) => { root.toggle_rule_fallback(idx); }
        add_rule_target(idx) => { root.add_rule_target(idx); }
        remove_rule_target(ridx, tidx) => { root.remove_rule_target(ridx, tidx); }
        update_rule_target(ridx, tidx, tmpl) => { root.update_rule_target(ridx, tidx, tmpl); }
        toggle_rule_target(ridx, tidx) => { root.toggle_rule_target(ridx, tidx); }
        test_url_changed(url) => { root.test_url_changed(url); }
    }

    // Dialog: Task Inspector
    if root.show_inspector : TaskInspector {
        inspector_info: root.inspector_info;
        inspector_tab: root.inspector_tab;
        inspector_peers: root.inspector_peers;
        inspector_trackers: root.inspector_trackers;
        inspector_files: root.inspector_files;
        inspector_piece_map: root.inspector_piece_map;
        inspector_pieces_count_text: root.inspector_pieces_count_text;
        close => { root.close_inspector(); }
        set_tab(tab) => { root.set_inspector_tab(tab); }
        open_speed_limit => { root.open_speed_limit_dialog(); }
        open_explorer(id) => { root.open_task_explorer(id); }
    }

    // Dialog: Speed Limit
    if root.show_speed_limit_dialog : SpeedLimitDialog {
        speed_limit_dl_kb <=> root.speed_limit_dl_kb;
        speed_limit_ul_kb <=> root.speed_limit_ul_kb;
        close => { root.close_speed_limit_dialog(); }
        submit(dl, ul) => { root.submit_speed_limit(dl, ul); }
    }

    // Dialog: New Task
    if root.show_new_task_dialog : NewTaskDialog {
        new_task_url <=> root.new_task_url;
        new_task_dir <=> root.new_task_dir;
        new_task_filename <=> root.new_task_filename;
        default_download_dir: root.default_download_dir;
        close => { root.close_new_task_dialog(); }
        submit(url, dir, filename) => { root.submit_new_task(url, dir, filename); }
        pick_torrent_file => { root.pick_torrent_file(); }
        pick_save_folder => { root.pick_save_folder(); }
    }
}
