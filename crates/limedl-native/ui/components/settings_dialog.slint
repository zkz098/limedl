        border-color: Theme.c2e3542;
                                            border-radius: 8px;
                                            max-width: 520px;
                                            HorizontalLayout { padding: 10px; Text { text: @tr("Load a peer IP blocklist into the session. Blocked ranges (e.g. known leeching IDC/networks) are refused on connection."); wrap: word-wrap; color: Theme.cf3f4f6; font-size: 12px; vertical-alignment: center; } }
                                        }
                                    } }
                                Text { text: @tr("Load local blocklist filter file"); color: #6b7280; font-size: 11px; }
                            }
                            ToggleSwitch {
                                checked: root.settings_form.bt_blocklist_enabled;
                                toggled => { root.settings_form.bt_blocklist_enabled = !root.settings_form.bt_blocklist_enabled; }
                            }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("Blocklist Path:"); color: Theme.c9ca3af; font-size: 12px;
                                Tooltip {
                                    Rectangle {
                                        background: Theme.c111419;
                                        border-width: 1px;
        border-color: Theme.c2e3542;
                                        border-radius: 8px;
                                        max-width: 520px;
                                        HorizontalLayout { padding: 10px; Text { text: @tr("Path to a blocklist file. Use an eMule .dat file or a P2P plaintext file (one CIDR per line); format is chosen by file extension."); wrap: word-wrap; color: Theme.cf3f4f6; font-size: 12px; vertical-alignment: center; } }
                                    }
                                } }
                            CustomTextInput { text <=> root.settings_form.bt_blocklist_path; placeholder: "C:/path/to/blocklist.dat"; }
                        }

                        Rectangle { height: 1px; background: Theme.c1a1e26; }

                        Text { text: @tr("Engine Tuning"); color: Theme.c9ca3af; font-size: 12px; font-weight: 600; }
                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Seed Choking (fastest_upload/round_robin/anti_leech):"); color: Theme.c9ca3af; font-size: 12px;
                                    Tooltip {
                                        Rectangle {
                                            background: Theme.c111419;
                                            border-width: 1px;
        border-color: Theme.c2e3542;
                                            border-radius: 8px;
                                            max-width: 520px;
                                            HorizontalLayout { padding: 10px; Text { text: @tr("How peers are ranked while seeding. Anti-Leech prefers seeding peers that contribute the most back."); wrap: word-wrap; color: Theme.cf3f4f6; font-size: 12px; vertical-alignment: center; } }
                                        }
                                    } }
                                ComboBox {
                                    model: [@tr("Fastest Upload First"), @tr("Round Robin"), @tr("Anti-Leech First")];
                                    current-index <=> root.settings_form.bt_seed_choking_algorithm_idx;
                                    height: 36px;
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Choking Algorithm (fixed_slots/rate_based):"); color: Theme.c9ca3af; font-size: 12px;
                                    Tooltip {
                                        Rectangle {
                                            background: Theme.c111419;
                                            border-width: 1px;
        border-color: Theme.c2e3542;
                                            border-radius: 8px;
                                            max-width: 520px;
                                            HorizontalLayout { padding: 10px; Text { text: @tr("How unchoke slots are determined per torrent. Fixed keeps a constant slot count; Rate-based auto-adjusts."); wrap: word-wrap; color: Theme.cf3f4f6; font-size: 12px; vertical-alignment: center; } }
                                        }
                                    } }
                                ComboBox {
                                    model: [@tr("Fixed Slots"), @tr("Rate Based")];
                                    current-index <=> root.settings_form.bt_choking_algorithm_idx;
                                    height: 36px;
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Max Upload Slots per Torrent:"); color: Theme.c9ca3af; font-size: 12px;
                                    Tooltip {
                                        Rectangle {
                                            background: Theme.c111419;
                                            border-width: 1px;
        border-color: Theme.c2e3542;
                                            border-radius: 8px;
                                            max-width: 520px;
                                            HorizontalLayout { padding: 10px; Text { text: @tr("Maximum concurrent unchoke slots per torrent."); wrap: word-wrap; color: Theme.cf3f4f6; font-size: 12px; vertical-alignment: center; } }
                                        }
                                    } }
                                UnitInput { text <=> root.settings_form.bt_max_upload_slots_per_torrent; placeholder: "4"; unit_text: @tr("slots"); }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Smart Ban Threshold (1-100):"); color: Theme.c9ca3af; font-size: 12px;
                                    Tooltip {
                                        Rectangle {
                                            background: Theme.c111419;
                                            border-width: 1px;
        border-color: Theme.c2e3542;
                                            border-radius: 8px;
                                            max-width: 520px;
                                            HorizontalLayout { padding: 10px; Text { text: @tr("Hash-failure involvements before a peer is automatically banned."); wrap: word-wrap; color: Theme.cf3f4f6; font-size: 12px; vertical-alignment: center; } }
                                        }
                                    } }
                                UnitInput { text <=> root.settings_form.bt_smart_ban_max_failures; placeholder: "3"; unit_text: @tr("failures"); }
                            }
                        }
                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: @tr("Smart Ban Parole"); color: Theme.cf3f4f6; font-size: 13px; font-weight: 600;
                                    Tooltip {
                                        Rectangle {
                                            background: Theme.c111419;
                                            border-width: 1px;
        border-color: Theme.c2e3542;
                                            border-radius: 8px;
                                            max-width: 520px;
                                            HorizontalLayout { padding: 10px; Text { text: @tr("Re-download a failed piece from an uninvolved peer to attribute the fault before striking."); wrap: word-wrap; color: Theme.cf3f4f6; font-size: 12px; vertical-alignment: center; } }
                                        }
                                    } }
                                Text { text: @tr("Isolate suspicious peers before permanent ban to prevent false positives"); color: #6b7280; font-size: 11px; }
                            }
                            ToggleSwitch {
                                checked: root.settings_form.bt_smart_ban_parole;
                                toggled => { root.settings_form.bt_smart_ban_parole = !root.settings_form.bt_smart_ban_parole; }
                            }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Ban Duration after Eviction:"); color: Theme.c9ca3af; font-size: 12px;
                                    Tooltip {
                                        Rectangle {
                                            background: Theme.c111419;
                                            border-width: 1px;
        border-color: Theme.c2e3542;
                                            border-radius: 8px;
                                            max-width: 520px;
                                            HorizontalLayout { padding: 10px; Text { text: @tr("Seconds an evicted (non-contributing) peer is blocked from reconnecting."); wrap: word-wrap; color: Theme.cf3f4f6; font-size: 12px; vertical-alignment: center; } }
                                        }
                                    } }
                                UnitInput { text <=> root.settings_form.bt_eviction_ban_duration_secs; placeholder: "600"; unit_text: @tr("secs"); }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("No Data Contribution Timeout:"); color: Theme.c9ca3af; font-size: 12px;
                                    Tooltip {
                                        Rectangle {
                                            background: Theme.c111419;
                                            border-width: 1px;
        border-color: Theme.c2e3542;
                                            border-radius: 8px;
                                            max-width: 520px;
                                            HorizontalLayout { padding: 10px; Text { text: @tr("Seconds without receiving piece data before a peer is disconnected. 0 disables this safeguard."); wrap: word-wrap; color: Theme.cf3f4f6; font-size: 12px; vertical-alignment: center; } }
                                        }
                                    } }
                                UnitInput { text <=> root.settings_form.bt_data_contribution_timeout_secs; placeholder: "60"; unit_text: @tr("secs"); }
                            }
                        }

                        Rectangle { height: 1px; background: Theme.c1a1e26; }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                alignment: space-between;
                                spacing: 2px;
                                Text { text: "Fast Extension"; color: Theme.cf3f4f6; font-size: 12px; font-weight: 600; }
                                ToggleSwitch {
                                    checked: root.settings_form.bt_enable_fast_extension;
                                    toggled => { root.settings_form.bt_enable_fast_extension = !root.settings_form.bt_enable_fast_extension; }
                                }
                            }
                            VerticalLayout {
                                alignment: space-between;
                                spacing: 2px;
                                Text { text: "Holepunch"; color: Theme.cf3f4f6; font-size: 12px; font-weight: 600; }
                                ToggleSwitch {
                                    checked: root.settings_form.bt_enable_holepunch;
                                    toggled => { root.settings_form.bt_enable_holepunch = !root.settings_form.bt_enable_holepunch; }
                                }
                            }
                            VerticalLayout {
                                alignment: space-between;
                                spacing: 2px;
                                Text { text: "WebSeed"; color: Theme.cf3f4f6; font-size: 12px; font-weight: 600; }
                                ToggleSwitch {
                                    checked: root.settings_form.bt_enable_web_seed;
                                    toggled => { root.settings_form.bt_enable_web_seed = !root.settings_form.bt_enable_web_seed; }
                                }
                            }
                            VerticalLayout {
                                alignment: space-between;
                                spacing: 2px;
                                Text { text: "SuperSeed"; color: Theme.cf3f4f6; font-size: 12px; font-weight: 600; }
                                ToggleSwitch {
                                    checked: root.settings_form.bt_enable_super_seeding;
                                    toggled => { root.settings_form.bt_enable_super_seeding = !root.settings_form.bt_enable_super_seeding; }
                                }
                            }
                        }

                        Rectangle { height: 1px; background: Theme.c1a1e26; }

                        VerticalLayout {
                            spacing: 6px;
                            Text { text: @tr("Tracker Subscription URL:"); color: Theme.c9ca3af; font-size: 12px;
                                Tooltip {
                                    Rectangle {
                                        background: Theme.c111419;
                                        border-width: 1px;
        border-color: Theme.c2e3542;
                                        border-radius: 8px;
                                        max-width: 520px;
                                        HorizontalLayout { padding: 10px; Text { text: @tr("Download a TXT file from this URL, one tracker URL per line. Updating refreshes the list below; save settings afterward."); wrap: word-wrap; color: Theme.cf3f4f6; font-size: 12px; vertical-alignment: center; } }
                                    }
                                } }
                            HorizontalLayout {
                                spacing: 8px;
                                CustomTextInput {
                                    horizontal-stretch: 1;
                                    text <=> root.settings_form.tracker_url;
                                    placeholder: "https://cf.trackerslist.com/best.txt";
                                }
                                SecondaryButton {
                                    horizontal-stretch: 0;
                                    text: @tr("Sync Now");
                                    icon: @image-url("../assets/icons/refresh-line.svg");
                                    clicked => { root.fetch_trackers(root.settings_form.tracker_url); }
                                }
                            }
                            Text { text: @tr("Synced trackers update bt.trackerList. Click Save to apply."); color: #6b7280; font-size: 11px; }
                                }
                                }
                            }
                        }
                    }
                }

                // ── Tab 5: IO 实验室 ──
                if root.settings_tab == 5 : ScrollView {
                    VerticalLayout {
                        alignment: start;
                        padding: 16px;
                        spacing: 14px;

                        Text { text: @tr("IO Baseline & Performance Modes"); color: Theme.ca3e635; font-size: 13px; font-weight: 700; }

                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: @tr("Game Mode"); color: Theme.cf59e0b; font-size: 13px; font-weight: 600; }
                                Text { text: @tr("Reduces buffer and IO frequency to minimize latency interference with 3D games"); color: #6b7280; font-size: 11px; }
                            }
                            ToggleSwitch {
                                checked: root.settings_form.game_mode;
                                toggled => { root.toggle_game_mode(); }
                            }
                        }

                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: @tr("Overclock Mode"); color: Theme.cec4899; font-size: 13px; font-weight: 600; }
                                Text { text: @tr("Aggressive multi-threading to push bandwidth to the hardware limit"); color: #6b7280; font-size: 11px; }
                            }
                            ToggleSwitch {
                                checked: root.settings_form.overclock_mode;
                                toggled => { root.toggle_overclock_mode(); }
                            }
                        }

                        Rectangle { height: 1px; background: Theme.c1a1e26; }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Buffer Pool Limit:"); color: Theme.c9ca3af; font-size: 12px;
                                    Tooltip {
                                        Rectangle {
                                            background: Theme.c111419;
                                            border-width: 1px;
        border-color: Theme.c2e3542;
                                            border-radius: 8px;
                                            max-width: 520px;
                                            HorizontalLayout { padding: 10px; Text { text: @tr("Maximum memory used to buffer HDD downloads. A larger buffer turns more random writes into sequential writes."); wrap: word-wrap; color: Theme.cf3f4f6; font-size: 12px; vertical-alignment: center; } }
                                        }
                                    } }
                                UnitInput { text <=> root.settings_form.io_buffer_limit_mb; placeholder: "1024"; unit_text: "MB"; }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Game Mode Buffer:"); color: Theme.c9ca3af; font-size: 12px;
                                    Tooltip {
                                        Rectangle {
                                            background: Theme.c111419;
                                            border-width: 1px;
        border-color: Theme.c2e3542;
                                            border-radius: 8px;
                                            max-width: 520px;
                                            HorizontalLayout { padding: 10px; Text { text: @tr("Buffer limit when game mode is active, reducing impact on gaming performance."); wrap: word-wrap; color: Theme.cf3f4f6; font-size: 12px; vertical-alignment: center; } }
                                        }
                                    } }
                                UnitInput { text <=> root.settings_form.io_game_mode_buffer_mb; placeholder: "128"; unit_text: "MB"; }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("HDD Max Parallel:"); color: Theme.c9ca3af; font-size: 12px;
                                    Tooltip {
                                        Rectangle {
                                            background: Theme.c111419;
                                            border-width: 1px;
        border-color: Theme.c2e3542;
                                            border-radius: 8px;
                                            max-width: 520px;
                                            HorizontalLayout { padding: 10px; Text { text: @tr("Maximum number of HDD downloads that can use the buffer simultaneously. Each gets an equal share of the buffer pool."); wrap: word-wrap; color: Theme.cf3f4f6; font-size: 12px; vertical-alignment: center; } }
                                        }
                                    } }
                                UnitInput { text <=> root.settings_form.io_max_parallel_hdd; placeholder: "4"; unit_text: @tr("tasks"); }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Game Mode Max Parallel:"); color: Theme.c9ca3af; font-size: 12px;
                                    Tooltip {
                                        Rectangle {
                                            background: Theme.c111419;
                                            border-width: 1px;
        border-color: Theme.c2e3542;
                                            border-radius: 8px;
                                            max-width: 520px;
                                            HorizontalLayout { padding: 10px; Text { text: @tr("Maximum parallel HDD downloads when game mode is active."); wrap: word-wrap; color: Theme.cf3f4f6; font-size: 12px; vertical-alignment: center; } }
                                        }
                                    } }
                                UnitInput { text <=> root.settings_form.io_game_mode_max_parallel; placeholder: "1"; unit_text: @tr("tasks"); }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                alignment: space-between;
                                spacing: 2px;
                                Text { text: @tr("HDD Double-Buffer Optimization"); color: Theme.cf3f4f6; font-size: 12px; font-weight: 600;
                                    Tooltip {
                                        Rectangle {
                                            background: Theme.c111419;
                                            border-width: 1px;
        border-color: Theme.c2e3542;
                                            border-radius: 8px;
                                            max-width: 520px;
                                            HorizontalLayout { padding: 10px; Text { text: @tr("Enable double-buffer pool optimization for mechanical hard drives to improve write performance. Not needed for SSDs."); wrap: word-wrap; color: Theme.cf3f4f6; font-size: 12px; vertical-alignment: center; } }
                                        }
                                    } }
                                ToggleSwitch {
                                    checked: root.settings_form.io_hdd_buffer_enabled;
                                    toggled => { root.settings_form.io_hdd_buffer_enabled = !root.settings_form.io_hdd_buffer_enabled; }
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("SSD Write Combining (0=auto):"); color: Theme.c9ca3af; font-size: 12px; }
                                UnitInput { text <=> root.settings_form.io_ssd_write_combine_mb; placeholder: "0"; unit_text: "MB"; }
                            }
                        }

                        Rectangle { height: 1px; background: Theme.c1a1e26; }

                        VerticalLayout {
                            spacing: 4px;
                            HorizontalLayout {
                                spacing: 6px;
                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("../assets/icons/hard-drive-2-line.svg");
                                        colorize: Theme.c38bdf8;
                                        width: 15px;
                                        height: 15px;
                                        image-fit: contain;
                                    }
                                }
                                Text { text: @tr("Disk Type Detection (SSD / HDD):"); color: Theme.c9ca3af; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                            }
                            Text { text: root.settings_form.disk_type_text; color: Theme.c38bdf8; font-size: 12px; }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            HorizontalLayout {
                                spacing: 6px;
                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("../assets/icons/cpu-line.svg");
                                        colorize: Theme.ca3e635;
                                        width: 15px;
                                        height: 15px;
                                        image-fit: contain;
                                    }
                                }
                                Text { text: @tr("Buffer Pool Status:"); color: Theme.c9ca3af; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                            }
                            Text { text: root.settings_form.io_status_text; color: Theme.ca3e635; font-size: 12px; }
                        }
                    }
                }

                // ── Tab 6: 日志 ──
                if root.settings_tab == 6 : ScrollView {
                    VerticalLayout {
                        alignment: start;
                        padding: 16px;
                        spacing: 14px;

                        Text { text: @tr("Logging"); color: Theme.ca3e635; font-size: 13px; font-weight: 700; }

                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: @tr("Enable File Logging"); color: Theme.cf3f4f6; font-size: 13px; font-weight: 600; }
                                Text { text: @tr("Write logs to the specified filePath"); color: #6b7280; font-size: 11px; }
                            }
                            ToggleSwitch {
                                checked: root.settings_form.logging_enabled;
                                toggled => { root.settings_form.logging_enabled = !root.settings_form.logging_enabled; }
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("Log Level (trace/debug/info/warn/error):"); color: Theme.c9ca3af; font-size: 12px; }
                            ComboBox {
                                    model: [@tr("Trace"), @tr("Debug"), @tr("Info"), @tr("Warn"), @tr("Error")];
                                    current-index <=> root.settings_form.logging_level_idx;
                                    height: 36px;
                                }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("Log File Path:"); color: Theme.c9ca3af; font-size: 12px;
                                Tooltip {
                                    Rectangle {
                                        background: Theme.c111419;
                                        border-width: 1px;
        border-color: Theme.c2e3542;
                                        border-radius: 8px;
                                        max-width: 520px;
                                        HorizontalLayout { padding: 10px; Text { text: @tr("Supports absolute or relative paths. Leave empty to write to logs/limedl.log under app data."); wrap: word-wrap; color: Theme.cf3f4f6; font-size: 12px; vertical-alignment: center; } }
                                    }
                                } }
                            HorizontalLayout {
                                spacing: 8px;
                                CustomTextInput {
                                    horizontal-stretch: 1;
                                    text <=> root.settings_form.logging_file_path;
                                    placeholder: @tr("Leave empty for system default, e.g. D:\\limedl\\logs\\limedl.log");
                                }
                                SecondaryButton {
                                    horizontal-stretch: 0;
                                    text: @tr("Select Path...");
                                    icon: @image-url("../assets/icons/folder-open-line.svg");
                                    clicked => { root.pick_log_folder(); }
                                }
                                SecondaryButton {
                                    horizontal-stretch: 0;
                                    text: @tr("Open Folder");
                                    icon: @image-url("../assets/icons/folder-open-line.svg");
                                    clicked => { root.open_log_folder(); }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Retention Files (empty for unlimited):"); color: Theme.c9ca3af; font-size: 12px; }
                                UnitInput { text <=> root.settings_form.logging_retention_count; placeholder: @tr("Unlimited"); unit_text: @tr("files"); }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Retention Days (empty for unlimited):"); color: Theme.c9ca3af; font-size: 12px; }
                                UnitInput { text <=> root.settings_form.logging_retention_days; placeholder: @tr("Unlimited"); unit_text: @tr("days"); }
                            }
                        }
                    }
                }

                // ── Tab 7: Aria2 RPC ──
                if root.settings_tab == 7 : ScrollView {
                    VerticalLayout {
                        alignment: start;
                        padding: 16px;
                        spacing: 14px;

                        Text { text: @tr("Aria2 RPC Service"); color: Theme.ca3e635; font-size: 13px; font-weight: 700; }

                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: @tr("Enable Aria2 RPC Service"); color: Theme.cf3f4f6; font-size: 13px; font-weight: 600;
                                    Tooltip {
                                        Rectangle {
                                            background: Theme.c111419;
                                            border-width: 1px;
        border-color: Theme.c2e3542;
                                            border-radius: 8px;
                                            max-width: 520px;
                                            HorizontalLayout { padding: 10px; Text { text: @tr("Start a local Aria2 RPC-compatible server, allowing Chrome download extensions to send downloads via the Aria2 protocol."); wrap: word-wrap; color: Theme.cf3f4f6; font-size: 12px; vertical-alignment: center; } }
                                        }
                                    } }
                                Text { text: @tr("Allows browser extensions (such as Aria2 Explorer) to intercept downloads"); color: #6b7280; font-size: 11px; }
                            }
                            ToggleSwitch {
                                checked: root.settings_form.aria2_enabled;
                                toggled => { root.settings_form.aria2_enabled = !root.settings_form.aria2_enabled; }
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("RPC Port (1-65535):"); color: Theme.c9ca3af; font-size: 12px;
                                Tooltip {
                                    Rectangle {
                                        background: Theme.c111419;
                                        border-width: 1px;
        border-color: Theme.c2e3542;
                                        border-radius: 8px;
                                        max-width: 520px;
                                        HorizontalLayout { padding: 10px; Text { text: @tr("Default 6800. Make sure the port is available."); wrap: word-wrap; color: Theme.cf3f4f6; font-size: 12px; vertical-alignment: center; } }
                                    }
                                } }
                            UnitInput {
                                text <=> root.settings_form.aria2_port;
                                placeholder: "6800";
                                unit_text: @tr("port");
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("RPC Secret (empty for no authentication):"); color: Theme.c9ca3af; font-size: 12px;
                                Tooltip {
                                    Rectangle {
                                        background: Theme.c111419;
                                        border-width: 1px;
        border-color: Theme.c2e3542;
                                        border-radius: 8px;
                                        max-width: 520px;
                                        HorizontalLayout { padding: 10px; Text { text: @tr("Leave empty to allow connections without a secret. If set, configure the same token in your browser extension."); wrap: word-wrap; color: Theme.cf3f4f6; font-size: 12px; vertical-alignment: center; } }
                                    }
                                } }
                            CustomTextInput {
                                text <=> root.settings_form.aria2_secret;
                                placeholder: @tr("Leave empty for no secret");
                            }
                        }

                        Rectangle { height: 1px; background: Theme.c1a1e26; }
                        Text { text: @tr("Tip: Install Aria2 Explorer from Chrome/Edge/Firefox webstore and set host to http://127.0.0.1:{{port}} with your secret."); color: #6b7280; font-size: 11px; wrap: word-wrap; }
                    }
                }

                // ── Tab 8: 关于 ──
                if root.settings_tab == 8 : ScrollView {
                    VerticalLayout {
                        alignment: start;
                        padding: 18px;
                        spacing: 16px;

                        HorizontalLayout {
                            spacing: 16px;
                            alignment: start;
                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("../assets/logo.png");
                                    width: 48px;
                                    height: 48px;
                                    image-fit: contain;
                                }
                            }
                            VerticalLayout {
                                spacing: 3px;
                                Text { text: "limedl - Native Edition"; color: Theme.cf3f4f6; font-size: 16px; font-weight: 700; }
                                Text { text: @tr("Lightweight high-performance asynchronous multi-protocol download engine"); color: Theme.c84cc16; font-size: 12px; font-weight: 600; }
                                Text { text: @tr("Cross-platform unified engine supporting HTTP/HTTPS adaptive multi-threading and full BitTorrent protocols."); color: Theme.c9ca3af; font-size: 11px; }
                            }
                        }

                        Rectangle { height: 1px; background: Theme.c1f242e; }

                        Rectangle {
                            background: Theme.c14171d;
                            border-color: Theme.c232832;
                            border-width: 1px;
                            border-radius: 8px;

                            VerticalLayout {
                                padding: 14px;
                                spacing: 10px;
                                Text { text: @tr("System & Environment Info"); color: Theme.ca3e635; font-size: 12px; font-weight: 700; }

                                HorizontalLayout {
                                    Text { width: 140px; text: @tr("Client Version:"); color: #6b7280; font-size: 12px; }
                                    Text { text: root.settings_form.app_version; color: Theme.cf3f4f6; font-size: 12px; font-weight: 600; font-family: "Consolas"; }
                                }
                                HorizontalLayout {
                                    Text { width: 140px; text: @tr("Engine Core:"); color: #6b7280; font-size: 12px; }
                                    Text { text: root.settings_form.engine_version; color: Theme.cf3f4f6; font-size: 12px; font-weight: 600; font-family: "Consolas"; }
                                }
                                HorizontalLayout {
                                    Text { width: 140px; text: @tr("Target Arch & Graphics:"); color: #6b7280; font-size: 12px; }
                                    Text { text: root.settings_form.arch_info; color: Theme.c38bdf8; font-size: 12px; font-weight: 600; font-family: "Consolas"; }
                                }
                                HorizontalLayout {
                                    Text { width: 140px; text: @tr("Core Technology Stack:"); color: #6b7280; font-size: 12px; }
                                    Text { text: @tr("Rust Edition 2024 / Slint Native UI / Skia HW Acceleration / Tokio Async Runtime"); color: Theme.c9ca3af; font-size: 12px; }
                                }
                                HorizontalLayout {
                                    Text { width: 140px; text: @tr("License:"); color: #6b7280; font-size: 12px; }
                                    Text { text: "MIT / Apache-2.0 Dual License"; color: Theme.c9ca3af; font-size: 12px; }
                                }

                                Rectangle { height: 1px; background: Theme.c1f242e; }

                                // ── Self-update ──
                                Text { text: @tr("Software Update"); color: Theme.ca3e635; font-size: 12px; font-weight: 700; }

                                HorizontalLayout {
                                    Text { width: 140px; text: @tr("Update Status:"); color: #6b7280; font-size: 12px; }
                                    Text {
                                        text: root.update_status_text();
                                        color: root.update_status_color();
                                        font-size: 12px;
                                        font-weight: 600;
                                        wrap: word-wrap;
                                        vertical-alignment: center;
                                    }
                                }

                                HorizontalLayout {
                                    Text { width: 140px; text: @tr("Distribution Channel:"); color: #6b7280; font-size: 12px; }
                                    Text {
                                        text: root.install_kind_label();
                                        color: Theme.c9ca3af;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                    }
                                }

                                if root.update_state.phase == "available" : Text {
                                    text: root.update_state.notes;
                                    color: Theme.c9ca3af;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }

                                if root.update_state.phase == "downloading" : VerticalLayout {
                                    spacing: 5px;
                                    Rectangle {
                                        height: 6px;
                                        border-radius: 3px;
                                        background: Theme.c1f242e;
                                        Rectangle {
                                            x: 0;
                                            y: 0;
                                            height: parent.height;
                                            width: parent.width * clamp(root.update_state.progress_percent, 0, 100) / 100;
                                            border-radius: 3px;
                                            background: Theme.c84cc16;
                                        }
                                    }
                                    Text {
                                        text: root.update_state.progress_label;
                                        color: #6b7280;
                                        font-size: 11px;
                                    }
                                }

                                if root.update_state.phase == "error" && root.update_state.error_text != "" : Text {
                                    text: root.update_state.error_text;
                                    color: Theme.cf87171;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }

                                HorizontalLayout {
                                    spacing: 10px;
                                    alignment: start;

                                    if root.update_state.phase != "downloading" && root.update_state.phase != "ready" : SecondaryButton {
                                        text: root.update_state.phase == "checking" ? @tr("Checking...") : @tr("Check for Updates");
                                        enabled: root.update_state.phase != "checking";
                                        clicked => { root.check_updates(); }
                                    }

                                    if root.update_state.phase == "available" : PrimaryButton {
                                        text: root.update_state.install_kind == "store" ? @tr("Update in Store") : @tr("Download & Install");
                                        clicked => { root.start_download(); }
                                    }

                                    if root.update_state.phase == "ready" : PrimaryButton {
                                        text: @tr("Restart to Update");
                                        clicked => { root.restart_now(); }
                                    }
                                }
                                HorizontalLayout {
                                    Text { width: 140px; text: @tr("Font License:"); color: #6b7280; font-size: 12px; }
                                    VerticalLayout {
                                        spacing: 3px;
                                        Text { text: @tr("MiSans VF © Beijing Xiaomi Mobile Software Co.,Ltd. Free for commercial use."); color: Theme.c9ca3af; font-size: 12px; }
                                        HorizontalLayout {
                                            alignment: start;
                                            Text {
                                                text: "hyperos.mi.com/font";
                                                color: lic-ta.has_hover ? Theme.c60a5fa : Theme.c38bdf8;
                                                font-size: 12px;
                                                font-family: "Consolas";
                                                vertical-alignment: center;
                                                lic-ta := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.open_font_license(); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Footer
            HorizontalLayout {
                alignment: end;
                spacing: 10px;

                SecondaryButton {
                    text: @tr("Cancel");
                    clicked => { root.close(); }
                }

                PrimaryButton {
                    text: @tr("Save Settings");
                    icon: @image-url("../assets/icons/save-line.svg");
                    clicked => { root.save(root.settings_form); }
                }
            }
        }
    }
}
