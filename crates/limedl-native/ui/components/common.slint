    in property <bool> enabled: true;
    callback clicked();

    background: !root.enabled ? Theme.c201315 : (ta.has_hover ? (ta.pressed ? Theme.c7f1d1d : #b91c1c) : Theme.c991b1b);
    border-color: #dc2626;
    border-width: 1px;
    border-radius: 6px;
    height: 32px;
    min-width: 60px;

    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 5px;
        alignment: center;

        if root.icon.width > 0 : VerticalLayout {
