import { IconButton } from "common.slint";
import { Theme } from "../theme.slint";
import { ToastItem } from "../types.slint";

/// Top-right in-app toast notifications. Dismissal is handled from Rust
/// (auto-expire timer + dismiss callback); this component is purely visual.
/// Declared last in the window so it paints above every dialog. The root is a
/// transparent full-screen overlay without TouchArea, so it never intercepts
/// clicks — only the toast cards themselves are interactive.
export component ToastStack inherits Rectangle {
    in property <[ToastItem]> toasts: [];
    callback dismiss(int);

    width: 100%;
    height: 100%;
    visible: root.toasts.length > 0 || stack_box.opacity > 0.01;

    stack_box := Rectangle {
        width: 380px;
        height: self.preferred-height;
        x: parent.width - self.width - 24px;
        y: root.toasts.length > 0 ? 24px : 8px;
        opacity: root.toasts.length > 0 ? 1.0 : 0.0;
        animate y, opacity { duration: 180ms; easing: ease-out; }
        clip: true;

        VerticalLayout {
            spacing: 8px;
            alignment: start;

            // One layout slot per toast. The slot keeps its height while the
            // card slides out, so retiring one toast does not reflow the rest
            // mid-animation; Rust drops the row once the exit has played.
            for toast[index] in root.toasts : Rectangle {
                width: 100%;
                height: toast_card.preferred-height;

                // Enter/exit state. `entered` is flipped by a one-shot Timer
                // rather than in `init` so the first frame really renders at the
                // off-screen position and the property animation has a value to
                // animate from.
                property <bool> entered: false;
                Timer {
                    interval: 1ms;
                    triggered => {
                        entered = true;
                        self.running = false;
                    }
                }

                // The card is not a direct layout child, so its `x` is free to
                // animate: it slides in from the right edge and slides back out
                // when `toast.leaving` flips. The stack's `clip` hides the part
                // that is still off-screen. Keep the 200ms in sync with
                // `TOAST_EXIT_MS` in src/toast.rs.
                toast_card := Rectangle {
                    x: toast.leaving ? 26px : (entered ? 0px : 26px);
                    y: 0;
                    width: parent.width;
                    height: self.preferred-height;
                    opacity: toast.leaving ? 0.0 : (entered ? 1.0 : 0.0);
                    animate x, opacity { duration: 200ms; easing: ease-out; }
                    background: root.toast_bg(toast.kind);
                    border-color: root.toast_border(toast.kind);
                    border-width: 1px;
                    border-radius: 8px;
                    drop-shadow-blur: 14px;
                    drop-shadow-color: Theme.c000000cc;
                    clip: true;

                    HorizontalLayout {
                        alignment: start;

                        // Left severity accent strip
                        Rectangle {
                            width: 4px;
                            background: root.toast_color(toast.kind);
                        }

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 8px;
                            padding-top: 10px;
                            padding-bottom: 10px;
                            spacing: 8px;
                            alignment: start;
                            horizontal-stretch: 1;

                            // Kind icon
                            VerticalLayout {
                                alignment: center;
                                width: 18px;
                                Image {
                                    source: root.toast_icon(toast.kind);
                                    colorize: root.toast_color(toast.kind);
                                    width: 16px;
                                    height: 16px;
                                    image-fit: contain;
                                }
                            }

                            // Message
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                Text {
                                    text: toast.message;
                                    color: Theme.cf3f4f6;
                                    font-size: 12px;
                                    font-weight: 500;
                                    wrap: word-wrap;
                                    vertical-alignment: center;
                                }
                            }

                            // Close button. The id addresses one row of the toast
                            // stack, so the UI tests can click the real control
                            // instead of calling the dismiss handler.
                            toast_close := IconButton {
                                icon: @image-url("../assets/icons/close-line.svg");
                                text_color: Theme.c8b95a5;
                                clicked => { root.dismiss(toast.id); }
                            }
                        }
                    }
                }
            }
        }
    }

    pure function toast_bg(kind: string) -> color {
        kind == "success" ? Theme.c14351a :
        kind == "error" ? Theme.c3b1216 :
        kind == "warning" ? Theme.c3b280c :
        Theme.c132a42;
    }
    pure function toast_border(kind: string) -> color {
        kind == "success" ? Theme.c22542e :
        kind == "error" ? Theme.c5c1f23 :
        kind == "warning" ? Theme.c543615 :
        Theme.c2e3542;
    }
    pure function toast_color(kind: string) -> color {
        kind == "success" ? Theme.c4ade80 :
        kind == "error" ? Theme.cf87171 :
        kind == "warning" ? Theme.cfbbf24 :
        Theme.c38bdf8;
    }
    pure function toast_icon(kind: string) -> image {
        kind == "success" ? @image-url("../assets/icons/checkbox-circle-line.svg") :
        kind == "error" ? @image-url("../assets/icons/error-warning-line.svg") :
        kind == "warning" ? @image-url("../assets/icons/error-warning-line.svg") :
        @image-url("../assets/icons/information-line.svg");
    }
}
