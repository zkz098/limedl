msgid "Increase Threshold:"
msgstr "增容探测阈值:"

msgid "Speed ratio relative to baseline (0.70-1.00) required to attempt adding a thread (default 0.95)."
msgstr "尝试探测试探性增容所需的吞吐量比率（默认 0.95，即当前速度达到基准的 95% 时允许加线程）。"

msgid "Severe Drop Threshold:"
msgstr "剧烈下跌阈值:"

msgid "Critical speed crash ratio (0.10-0.80) that triggers emergency backoff to minimum threads (default 0.60)."
msgstr "触发紧急避险减容的暴跌阈值（默认 0.60，即速度跌破 60% 时立即回退到最低基础线程）。"

msgid "AIMD Cooldown Window:"
msgstr "AIMD 冷却时长:"

msgid "Minimum seconds to wait between thread allocation adjustments (default 3s)."
msgstr "两次线程调配决策之间的强制冷静期（默认 3 秒），防止网络波动引起剧烈振荡。"

msgid "Stable Samples Needed:"
msgstr "所需稳定样本数:"

msgid "Number of consecutive steady speed samples required before making an AIMD decision (default 2)."
msgstr "触发 AIMD 决策所需的连续稳定采样周期数（默认 2 个采样点）。"

msgid "samples"
msgstr "个样本"

msgid "Probe Stable Cycles:"
msgstr "增容探测稳定周期:"

msgid "Number of consecutive stable cycles required before probing for thread expansion (default 4)."
msgstr "在平稳运行状态下，主动发起探索性加线程探测所需的连续稳定周期数（默认 4 个周期）。"

msgid "cycles"
msgstr "个周期"

msgid "Decrease Factor:"
msgstr "乘法减速乘数:"

msgid "Multiplicative decrease multiplier (0.10-0.95) applied to thread count when congestion is detected (default 0.75)."
msgstr "检测到网络拥塞时线程数乘法减小的衰减系数（默认 0.75，即缩容保留当前线程的 75%）。"

msgid "Additive Step Ratio:"
msgstr "加法探测步长比率:"

msgid "Fraction of headroom to add during linear increase (default 0.25)."
msgstr "线性增容探测时单次增加线程占剩余可用空间的比例（默认 0.25）。"

msgid "Oscillation Threshold:"
msgstr "振荡抑制阈值:"

msgid "Maximum frequency of direction reversals within history window before damping AIMD adjustments (default 3)."
msgstr "历史滑动窗口内允许的线程增减频繁反转次数（默认 3 次），超限时启动迟滞衰减锁定。"

msgid "reversals"
msgstr "次反转"

msgid "Hysteresis Multiplier:"
msgstr "迟滞倍数:"

msgid "Damping multiplier for cooldown when oscillation is detected (default 2)."
msgstr "检测到频繁振荡时冷静时间的延长倍数（默认 2 倍）。"

msgid "Chunking, Tail Sprint & Work Stealing"
msgstr "分块、尾部冲刺与工作窃取"

msgid "Custom Chunk Size:"
msgstr "自定义分块大小:"

msgid "Override download chunk size in MB (0 = automatic adaptive chunk sizing based on content length)."
msgstr "强制指定 HTTP 下载分块大小（MB，设为 0 表示根据文件总大小自动动态自适应计算）。"

msgid "Tail Sprint Stall Window:"
msgstr "尾部冲刺停滞判定窗口:"

msgid "Seconds of stalled progress on the last remaining chunk before splitting it across idle workers (default 4s)."
msgstr "下载尾部最后分块传输停滞超时门限（默认 4 秒），超时后自动切分派发给空闲线程。"

msgid "Tail Sprint Min Split Size:"
msgstr "尾部冲刺最小切分大小:"

msgid "Minimum chunk size in MB eligible for tail sprint sub-division (default 4MB). Smaller chunks are not split to avoid HTTP overhead."
msgstr "允许进行尾部冲刺细分的最小分块大小（默认 4MB，过小的分块不切分以避免 HTTP 连接握手损耗）。"

msgid "Work Stealing Min Split Size:"
msgstr "工作窃取最小切分大小:"

msgid "Minimum remaining bytes in MB required for an idle worker to steal half of another worker's chunk (default 4MB)."
msgstr "空闲工作线程窃取正在运行分块一半进度时，被窃取分块所需的最小剩余大小（默认 4MB）。"

msgid "Network Transport & Retry Backoff"
msgstr "网络传输与重试退避"

msgid "Connect Timeout:"
msgstr "连接超时:"

msgid "TCP / TLS handshake timeout in seconds (default 10s)."
msgstr "TCP 握手与 TLS 证书协商建连超时时长（默认 10 秒）。"

msgid "Read Timeout:"
msgstr "读取超时:"

msgid "Socket read idle timeout in seconds before aborting stalled connection (default 30s)."
msgstr "Socket 数据读取空闲等待超时时长（默认 30 秒，超期自动中断并重试）。"

msgid "Pool Max Idle per Host:"
msgstr "连接池每域名空闲上限:"

msgid "Maximum pooled idle persistent connections kept open per host (default 16)."
msgstr "HTTP 连接池针对单一域名长期保活的最大空闲连接数（默认 16）。"

msgid "conns"
msgstr "连接"

msgid "TCP Keepalive Interval:"
msgstr "TCP Keepalive 保活时长:"

msgid "TCP keepalive probe interval in seconds (default 60s)."
msgstr "TCP Keepalive 心跳探测数据包发送间隔（默认 60 秒）。"

msgid "Retry Backoff Base:"
msgstr "初始退避基数:"

msgid "Initial delay for exponential backoff on transient connection failures in ms (default 1000ms)."
msgstr "遇到偶发网络故障或重试时指数退避的初始等待延迟（默认 1000ms）。"

msgid "Retry Backoff Max:"
msgstr "重试退避上限:"

msgid "Maximum cap for exponential backoff delay in ms (default 16000ms)."
msgstr "指数退避重试等待时长的封顶上限（默认 16000ms）。"

msgid "Retry Jitter Percent:"
msgstr "重试退避抖动比例:"

msgid "Random jitter percentage (0-100%) added to retry backoff to avoid thundering herd (default 20%)."
msgstr "为避免集群惊群效应而在退避延迟中加入的随机扰动浮动比例（默认 20%）。"

msgid "Custom"
msgstr "自定义"

