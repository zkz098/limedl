    {
      "id": "claim_cefb2fb1ab1a4fab8f1f85c4d33ee9ec",
      "statement": "The parser honors --out/-o, --dir/-d, repeatable --header/-H/--http-header, --referer (synthesized into a Referer header), --user-agent/-U, --checksum=TYPE=DIGEST for sha256/sha512/blake3 and -Z/--force-sequential, accepts both --name=value and attached short forms, consumes proxy option values so a proxy URI is never taken as a target, and records materially unsupported options under a canonical label instead of dropping them silently.",
      "evidence": [
        {
          "resource": "repo://crates/limedl-native/src/aria2_cli.rs#L18-L56",
          "version": "repo-lines-v1:sha256:20fb432bdfb20d4fab63220c207850a95926450c9314397e0ff389062952eef1:"
