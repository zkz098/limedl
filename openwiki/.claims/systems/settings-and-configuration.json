    {
      "id": "claim_d3f596c632e4413ca5885ce0d45c34f6",
      "statement": "SettingsService holds the settings behind an RwLock plus a tokio Mutex update_lock; update_with serializes read-modify-write by cloning the current persisted base, normalizing, atomically persisting and replacing memory, and a closure error aborts without persisting.",
      "evidence": [
        {
          "resource": "repo://crates/limedl-core/src/services/settings_service.rs#L10-L96",
          "version": "repo-lines-v1:sha256:bc1d6482bdfcc4aca6f6fe4a08a9856800dbfaed6d9146056c76ccc70526a59b:"
        }
      ]
    },
    {
      "id": "claim_dcb3dfa326484c5d862445041d93c03a",
      "statement": "persist_settings writes settings.json.tmp, flushes and sync_all's it before renaming it over settings.json, and snapshots the outgoing file to settings.json.bak (best effort), so neither a crash nor a power loss can leave a truncated or empty settings file.",
      "evidence": [
        {
          "resource": "repo://crates/limedl-core/src/settings/mod.rs#L486-L524",
          "version": "repo-lines-v1:sha256:87c8d881048452ef0deebfa4c77eb62db68f0fb0f639513d5c7a17ac75a712e8:"
        }
      ]
    },
    {
      "id": "claim_3488f06938e842ef9c59589ec95acb8d",
      "statement": "normalize_settings validates and clamps every external input: proxy URLs, scheduler parallelism (1..=32 traditional, 1..=64 automatic, per-task <= global), retries 0..=20, absolute download directory, IO baseline ranges, logging retention, BT trackers, aria2 RPC and URL rewrite.",
      "evidence": [
