      "id": "claim_50e14f0840f8483a9aa585a5b612f644",
      "statement": "The workspace has exactly four members — crates/limedl-core, crates/limedl-native, crates/limedl-server and xtask — inherits version 0.4.6 from the root manifest, and uses Rust edition 2024 in every crate.",
      "evidence": [
        {
          "resource": "repo://Cargo.toml#L1-L11",
          "version": "repo-lines-v1:sha256:fdb7d7d0bda8364cc420b0fbf76206e26d8bb07041b7bee975ad55e921180ee5:"
        }
      ]
    },
    {
      "id": "claim_a33322039352460f8d166f4fa75ff397",
      "statement": "limedl-core (lib name limedl_core) is the pure download engine and declares no GUI dependency; the Slint client is only one possible frontend over it.",
