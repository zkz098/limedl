import { ScrollView } from "std-widgets.slint";

import { Theme } from "../../theme.slint";
import { SettingsFormData, UpdateState } from "../../types.slint";
import {
    DangerButton,
    PrimaryButton,
    SecondaryButton,
} from "../common.slint";

export component SettingsTabAbout inherits ScrollView {
    in-out property <SettingsFormData> settings_form;
    in-out property <UpdateState> update_state;
    in-out property <bool> reset_confirm: false;
    callback check_updates();
    callback start_download();
    callback restart_now();
    callback restart_setup();
    callback factory_reset();
    callback open_font_license();

    pure function update_status_text() -> string {
        root.update_state.phase == "checking" ? @tr("Checking for updates...")
        : root.update_state.phase == "up-to-date" ? @tr("You are up to date.")
        : root.update_state.phase == "available" ? @tr("Version {} is available.", root.update_state.latest_version)
        : root.update_state.phase == "downloading" ? @tr("Downloading update...")
        : root.update_state.phase == "ready" ? @tr("v{} downloaded and verified. Restart to apply.", root.update_state.latest_version)
        : root.update_state.phase == "error" ? @tr("Update check failed.")
        : @tr("No update checked yet.");
    }

    pure function update_status_color() -> color {
        root.update_state.phase == "available" || root.update_state.phase == "ready" ? Theme.c84cc16
        : root.update_state.phase == "error" ? Theme.cf87171
        : root.update_state.phase == "downloading" ? Theme.c38bdf8
        : Theme.cf3f4f6;
    }

    pure function install_kind_label() -> string {
        root.update_state.install_kind == "store" ? @tr("Store (MSIX)")
        : root.update_state.install_kind == "installer" ? @tr("Installer")
        : @tr("Portable");
    }

    VerticalLayout {
        alignment: start;
        padding: 18px;
        spacing: 16px;

        HorizontalLayout {
            spacing: 16px;
            alignment: start;
            VerticalLayout {
                alignment: center;
                Image {
                    source: @image-url("../../assets/logo.png");
                    width: 48px;
                    height: 48px;
                    image-fit: contain;
                }
            }
            VerticalLayout {
                spacing: 3px;
                Text { text: "limedl - " + @tr("Native Edition"); color: Theme.cf3f4f6; font-size: 16px; font-weight: 700; }
                Text { text: @tr("Lightweight high-performance asynchronous multi-protocol download engine"); color: Theme.c84cc16; font-size: 12px; font-weight: 600; }
                Text { text: @tr("Cross-platform unified engine supporting HTTP/HTTPS adaptive multi-threading and full BitTorrent protocols."); color: Theme.c9ca3af; font-size: 11px; }
            }
        }

        Rectangle { height: 1px; background: Theme.c1f242e; }

        Rectangle {
            background: Theme.c14171d;
            border-color: Theme.c232832;
            border-width: 1px;
            border-radius: 8px;

            VerticalLayout {
                padding: 14px;
                spacing: 10px;
                Text { text: @tr("System & Environment Info"); color: Theme.ca3e635; font-size: 12px; font-weight: 700; }

                HorizontalLayout {
                    Text { width: 140px; text: @tr("Client Version:"); color: #6b7280; font-size: 12px; }
                    Text { text: root.settings_form.app_version; color: Theme.cf3f4f6; font-size: 12px; font-weight: 600; font-family: "Consolas"; }
                }
                HorizontalLayout {
                    Text { width: 140px; text: @tr("Engine Core:"); color: #6b7280; font-size: 12px; }
                    Text { text: root.settings_form.engine_version; color: Theme.cf3f4f6; font-size: 12px; font-weight: 600; font-family: "Consolas"; }
                }
                HorizontalLayout {
                    Text { width: 140px; text: @tr("Target Arch & Graphics:"); color: #6b7280; font-size: 12px; }
                    Text { text: root.settings_form.arch_info; color: Theme.c38bdf8; font-size: 12px; font-weight: 600; font-family: "Consolas"; }
                }
                HorizontalLayout {
                    Text { width: 140px; text: @tr("Core Technology Stack:"); color: #6b7280; font-size: 12px; }
                    Text { text: @tr("Rust Edition 2024 / Slint Native UI / Skia HW Acceleration / Tokio Async Runtime"); color: Theme.c9ca3af; font-size: 12px; }
                }
                HorizontalLayout {
                    Text { width: 140px; text: @tr("License:"); color: #6b7280; font-size: 12px; }
                    Text { text: "GPL-3.0-or-later"; color: Theme.c9ca3af; font-size: 12px; font-family: "Consolas"; }
                }

                Rectangle { height: 1px; background: Theme.c1f242e; }

                // ── Self-update ──
                Text { text: @tr("Software Update"); color: Theme.ca3e635; font-size: 12px; font-weight: 700; }

                HorizontalLayout {
                    Text { width: 140px; text: @tr("Update Status:"); color: #6b7280; font-size: 12px; }
                    update_status_text := Text {
                        text: root.update_status_text();
                        color: root.update_status_color();
                        font-size: 12px;
                        font-weight: 600;
                        wrap: word-wrap;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    Text { width: 140px; text: @tr("Distribution Channel:"); color: #6b7280; font-size: 12px; }
                    install_kind_text := Text {
                        text: root.install_kind_label();
                        color: Theme.c9ca3af;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }

                if root.update_state.phase == "available" : Text {
                    text: root.update_state.notes;
                    color: Theme.c9ca3af;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                if root.update_state.phase == "downloading" : update_progress_row := VerticalLayout {
                    spacing: 5px;
                    Rectangle {
                        height: 6px;
                        border-radius: 3px;
                        background: Theme.c1f242e;
                        Rectangle {
                            x: 0;
                            y: 0;
                            height: parent.height;
                            width: parent.width * clamp(root.update_state.progress_percent, 0, 100) / 100;
                            border-radius: 3px;
                            background: Theme.c84cc16;
                        }
                    }
                    update_progress_label := Text {
                        text: root.update_state.progress_label;
                        color: #6b7280;
                        font-size: 11px;
                    }
                }

                if root.update_state.phase == "error" && root.update_state.error_text != "" : update_error_text := Text {
                    text: root.update_state.error_text;
                    color: Theme.cf87171;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;

                    if root.update_state.phase != "downloading" && root.update_state.phase != "ready" : check_btn := SecondaryButton {
                        text: root.update_state.phase == "checking" ? @tr("Checking...") : @tr("Check for Updates");
                        enabled: root.update_state.phase != "checking";
                        clicked => { root.check_updates(); }
                    }

                    if root.update_state.phase == "available" : download_btn := PrimaryButton {
                        text: root.update_state.install_kind == "store" ? @tr("Update in Store") : @tr("Download & Install");
                        clicked => { root.start_download(); }
                    }

                    if root.update_state.phase == "ready" : restart_btn := PrimaryButton {
                        text: @tr("Restart to Update");
                        clicked => { root.restart_now(); }
                    }
                }
                HorizontalLayout {
                    Text { width: 140px; text: @tr("Font License:"); color: #6b7280; font-size: 12px; }
                    VerticalLayout {
                        spacing: 3px;
                        Text { text: @tr("MiSans VF © Beijing Xiaomi Mobile Software Co.,Ltd. Free for commercial use."); color: Theme.c9ca3af; font-size: 12px; }
                        HorizontalLayout {
                            alignment: start;
                            Text {
                                text: "hyperos.mi.com/font";
                                color: lic-ta.has_hover ? Theme.c60a5fa : Theme.c38bdf8;
                                font-size: 12px;
                                font-family: "Consolas";
                                vertical-alignment: center;
                                lic-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.open_font_license(); }
                                }
                            }
                        }
                    }
                }

                Rectangle { height: 1px; background: Theme.c1f242e; }

                // ── Setup wizard re-run ──
                Text { text: @tr("Setup Wizard"); color: Theme.ca3e635; font-size: 12px; font-weight: 700; }
                Text { text: @tr("Re-run the first-run wizard to reconfigure language, appearance, CDN, RPC, folder, performance and system options."); color: Theme.c9ca3af; font-size: 11px; wrap: word-wrap; }
                HorizontalLayout {
                    alignment: start;
                    SecondaryButton {
                        text: @tr("Re-run Setup Wizard");
                        icon: @image-url("../../assets/icons/settings-3-line.svg");
                        clicked => { root.restart_setup(); }
                    }
                }

                Rectangle { height: 1px; background: Theme.c1f242e; }

                // ── Danger zone: factory reset ──
                Text { text: @tr("Danger Zone"); color: Theme.cf87171; font-size: 12px; font-weight: 700; }
                Text {
                    text: @tr("Factory reset stops all downloads, deletes the download records, the database and the settings file, then restarts limedl.");
                    color: Theme.c9ca3af;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                if !root.reset_confirm : HorizontalLayout {
                    alignment: start;
                    reset_arm_btn := DangerButton {
                        text: @tr("Factory Reset");
                        icon: @image-url("../../assets/icons/delete-bin-6-line.svg");
                        clicked => { root.reset_confirm = true; }
                    }
                }

                if root.reset_confirm : VerticalLayout {
                    spacing: 8px;
                    Text {
                        text: @tr("This permanently deletes all local limedl data and cannot be undone. Continue?");
                        color: #fca5a5;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        reset_cancel_btn := SecondaryButton {
                            text: @tr("Cancel");
                            clicked => { root.reset_confirm = false; }
                        }
                        reset_confirm_btn := DangerButton {
                            text: @tr("Confirm Reset");
                            clicked => { root.reset_confirm = false; root.factory_reset(); }
                        }
                    }
                }
            }
        }
    }
}
