        }
      ]
    },
    {
      "id": "claim_32a4eb671148473b9d730976f1ea341a",
      "statement": "limedl-native depends on limedl-core and limedl-rpc as separate path dependencies, compiles the FemtoVG/OpenGL renderer plus Slint's software rasterizer as a runtime fallback when GL initialization fails, and enables tokio's signal feature for the cfg(unix) SIGTERM/SIGINT watcher.",
      "evidence": [
        {
          "resource": "repo://crates/limedl-native/Cargo.toml#L12-L26",
