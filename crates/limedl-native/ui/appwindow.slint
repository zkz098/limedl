import { ScrollView } from "std-widgets.slint";
import { Theme, ColorModePref } from "theme.slint";

// Bundled MiSans VF variable font (family "MiSans VF", wght 150-700). Embedded
// into the binary at compile time and auto-registered at startup, so every
// platform renders with the same typeface. The .ttf is NOT in git (MiSans
// license forbids re-distributing the font file itself); fetch it with
// scripts/fetch-misans.ps1 — build.rs fails with the same instruction if missing.
import "../assets/fonts/MiSansVF.ttf";

export { Theme, ColorModePref }
export {
    TaskItem,
    PeerItem,
    TrackerItem,
    TorrentFileItem,
    NewTaskTorrentFileItem,
    InspectorInfo,
    SettingsFormData,
    ContextMenuState,
    CdnCandidateItem,
    UrlRewriteTargetItem,
    UrlRewriteRuleItem,
    LabsFormData,
    SetupFormData,
    ToastItem,
} from "types.slint";

import {
    TaskItem,
    PeerItem,
    TrackerItem,
    TorrentFileItem,
    NewTaskTorrentFileItem,
    InspectorInfo,
    SettingsFormData,
    ContextMenuState,
    CdnCandidateItem,
    UrlRewriteTargetItem,
    UrlRewriteRuleItem,
    LabsFormData,
    SetupFormData,
    SpeedLimitSlotItem,
    ToastItem,
    UpdateState,
} from "types.slint";

import {
    CategoryButton,
    CustomSelect,
    IconButton,
    PrimaryButton,
    SearchInput,
    SecondaryButton,
} from "components/common.slint";
import { TaskCard } from "components/task_card.slint";
import { TaskTable } from "components/task_table.slint";
import { ContextMenu } from "components/context_menu.slint";
import { BackgroundMenu } from "components/background_menu.slint";
import { ToastStack } from "components/toast_stack.slint";
import { NewTaskDialog } from "components/new_task_dialog.slint";
import { TaskInspector } from "components/inspector.slint";
import { SpeedLimitDialog } from "components/speed_limit_dialog.slint";
import { SettingsDialog } from "components/settings_dialog.slint";
import { LabsDialog } from "components/labs_dialog.slint";
import { SetupWizard } from "components/setup_wizard.slint";
import { PriorityMenu } from "components/priority_menu.slint";

/// Compact pill showing one BT runtime metric in the top toolbar
/// (DHT node count / upload speed / connected peers).
component BtStatPill inherits Rectangle {
    in property <string> text;
    in property <image> icon;

    height: 24px;
    border-radius: 12px;
    background: Theme.c181b22;
    border-color: Theme.c252b36;
    border-width: 1px;

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 3px;
        alignment: center;

        VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                colorize: Theme.c4ade80;
                width: 12px;
                height: 12px;
                image-fit: contain;
            }
        }

        Text {
            text: root.text;
            color: Theme.c9ca3af;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
}

export component MainWindow inherits Window {
    title: "limedl - Native";
    icon: @image-url("assets/icon.png");
    min-width: 1000px;
    min-height: 660px;
    preferred-width: 1280px;
    preferred-height: 800px;
    // NOTE: font-family in Slint is a SINGLE family name (no CSS fallback
    // stacks). MiSans VF is bundled via the import above, so this resolves on
    // every platform and all UI text renders with the same typeface; glyphs
    // missing from MiSans (emoji, rare Han) still fall back to system fonts.
    default-font-family: "MiSans VF";
    background: Theme.c0d0f12;
    forward-focus: root_focus;

    public function handle_key_escape() {
        if root.show_new_task_dialog {
            root.close_new_task_dialog();
        } else if root.show_settings {
            root.close_settings();
        } else if root.show_labs {
            root.close_labs();
        } else if root.show_inspector {
            root.close_inspector();
        } else if root.show_speed_limit_dialog {
            root.close_speed_limit_dialog();
        } else if root.priority_menu_visible {
            root.priority_menu_visible = false;
        } else if root.context_menu_state.visible {
            root.context_menu_state.visible = false;
        } else if root.background_menu_visible {
            root.background_menu_visible = false;
        } else if root.selected_count > 0 {
            root.clear_selection();
        } else if root.search_query != "" {
            root.search_query = "";
            root.search_changed("");
        }
    }

    // State properties
    in property <[TaskItem]> tasks: [];
    in property <int> active_category: 0; // 0: All, 1: Downloading, 2: Paused, 3: Completed, 4: Failed
    in property <string> count_all: "0";
    in property <string> count_downloading: "0";
    in property <string> count_paused: "0";
    in property <string> count_completed: "0";
    in property <string> count_failed: "0";
    in property <string> global_speed_text: "0 B/s";
    // BT runtime status pills (hidden while the BT backend is unavailable).
    in property <bool> bt_status_visible: false;
    in property <string> bt_dht_text: "0";
    in property <string> bt_upload_speed_text: "0 B/s";
    in property <string> bt_peers_text: "0";
    in property <string> default_download_dir: "";
    in property <bool> show_new_task_dialog: false;

    // Search & Sort state
    in-out property <string> search_query: "";
    in property <int> sort_field: 0; // 0: Created, 1: Size, 2: Speed, 3: Progress, 4: Name
    in property <bool> sort_asc: false;
    in property <int> selected_count: 0;
    in-out property <int> view_mode: 0; // 0: Cards, 1: Table


    // Phase 3: Inspector state
    in property <bool> show_inspector: false;
    in property <InspectorInfo> inspector_info;
    in property <int> inspector_tab: 0;
    in property <[PeerItem]> inspector_peers: [];
    in property <[TrackerItem]> inspector_trackers: [];
    in property <[TorrentFileItem]> inspector_files: [];
    in property <image> inspector_piece_map;
    in property <string> inspector_pieces_count_text: "";
    in property <bool> show_speed_limit_dialog: false;
    in-out property <string> speed_limit_dl_kb: "0";
    in-out property <string> speed_limit_ul_kb: "0";

    // Table layout / density (Appearance → table columns + compact view)
    in property <bool> compact_view: false;
    in property <bool> column_file: true;
    in property <bool> column_size: true;
    in property <bool> column_downloaded: true;
    in property <bool> column_status: true;
    in property <bool> column_progress: true;
    in property <bool> column_speed: true;
    in property <bool> column_priority: true;
    in property <bool> column_upload_speed: false;
    in property <bool> column_seeds: false;
    in property <bool> column_eta: true;

    // Speed limit schedule editor rows (authoritative: the VecModel behind this
    // property; persisted on Save).
    in-out property <[SpeedLimitSlotItem]> speed_limit_slots: [];

    // Priority popup menu (opened from the table badge or task context menu)
    in-out property <bool> priority_menu_visible: false;
    in-out property <length> priority_menu_x: 0px;
    in-out property <length> priority_menu_y: 0px;
    in-out property <string> priority_menu_task_id: "";
    in-out property <string> priority_menu_current: "normal";

    // Phase 4: Settings & Performance Modes state
    in property <bool> show_settings: false;
    in property <int> settings_tab: 0;
    in-out property <SettingsFormData> settings_form;
    in property <bool> game_mode_active: false;
    in property <bool> overclock_mode_active: false;

    // Self-update state (rendered in Settings → About)
    in-out property <UpdateState> update_state: {
        phase: "idle",
        latest_version: "",
        notes: "",
        progress_percent: 0,
        progress_label: "",
        error_text: "",
        install_kind: "portable",
    };

    // Phase 6: Labs (CDN Acceleration & URL Rewrite) state
    in property <bool> show_labs: false;
    in property <int> labs_tab: 0;
    in-out property <LabsFormData> labs_form;
    in property <[CdnCandidateItem]> cdn_candidates: [];
    in property <[UrlRewriteRuleItem]> rewrite_rules: [];

    // First-run setup wizard state
    in property <bool> show_setup_wizard: false;
    in property <int> setup_start_step: 0;
    in-out property <SetupFormData> setup_form;

    // In-app toast notifications (driven from Rust)
    in-out property <[ToastItem]> toasts: [];

    // Task-list background context menu state
    in-out property <bool> background_menu_visible: false;
    in-out property <length> background_menu_x: 0px;
    in-out property <length> background_menu_y: 0px;

    // Context Menu state
    in-out property <ContextMenuState> context_menu_state: {
        visible: false,
        x: 0px,
        y: 0px,
        task_id: "",
        task_name: "",
        task_url: "",
        can_pause: false,
        can_resume: false,
        is_bt: false,
    };

    // New task form fields
    in-out property <string> new_task_url: "";
    in-out property <string> new_task_dir: "";
    in-out property <string> new_task_filename: "";
    in-out property <bool> new_task_batch_mode: false;
    in-out property <string> new_task_batch_text: "";
    // Checksum probe state: probe_state "idle" | "probing" | "found" | "missing" | "not_http"
    in-out property <string> new_task_probe_state: "idle";
    in-out property <string> new_task_probe_status_text: "";
    in-out property <string> new_task_probe_hash: ""; // raw detected hash (submit input)
    // Torrent preview state: "none" | "loading" | "ready" | "error"
    in-out property <string> new_task_preview_state: "none";
    in-out property <string> new_task_preview_status_text: "";
    in-out property <string> new_task_preview_summary_text: "";
    in property <[NewTaskTorrentFileItem]> new_task_torrent_files: [];
    // Batch mode state
    in-out property <string> new_task_batch_count_text: "";
    in-out property <bool> new_task_batch_submitting: false;
    in-out property <string> new_task_batch_status_text: "";

    // Callbacks to Rust
    callback select_category(int);
    callback open_new_task_dialog();
    callback close_new_task_dialog();
    callback submit_new_task(string, string, string);
    callback pause_all();
    callback resume_all();
    callback clear_completed();
    callback pause_task(string);
    callback resume_task(string);
    callback open_task_explorer(string);
    callback remove_task(string);
    callback task_double_clicked(string);

    // Phase 2 Callbacks
    callback search_changed(string);
    callback set_sort_field(int);
    callback toggle_sort_asc();
    callback toggle_select_task(string);
    callback range_select_task(string);
    callback select_all();
    callback clear_selection();
    callback batch_pause();
    callback batch_resume();
    callback batch_remove(bool);
    callback toggle_view_mode();
    callback table_sort_clicked(int);
    callback hotkey_space();
    callback hotkey_delete(bool);

    // Phase 3 Callbacks
    callback open_inspector(string);
    callback close_inspector();
    callback set_inspector_tab(int);
    callback open_speed_limit_dialog();
    callback close_speed_limit_dialog();
    callback submit_speed_limit(string, string);

    // Phase 4 Settings Callbacks
    callback open_settings();
    callback close_settings();
    callback set_settings_tab(int);
    callback save_settings(SettingsFormData);
    callback toggle_game_mode();
    callback toggle_overclock_mode();
    callback fetch_trackers_remote(string);

    // Self-update callbacks
    callback check_for_updates();
    callback start_update_download();
    callback restart_after_update();

    // Phase 6 Labs Callbacks
    callback open_labs();
    callback close_labs();
    callback set_labs_tab(int);
    callback save_labs(LabsFormData);
    callback start_cdn_test();
    callback cancel_cdn_test();
    callback clear_cdn_test();
    callback apply_cdn_candidate(string, float);
    callback toggle_cdn_advanced();
    callback apply_manual_cdn_ip(string);
    callback import_rewrite_preset(string);
    callback add_custom_rule();
    callback remove_rule(int);
    callback toggle_rule_expanded(int);
    callback toggle_rule_enabled(int);
    callback update_rule_name(int, string);
    callback update_rule_match_type(int, string);
    callback update_rule_pattern(int, string);
    callback update_rule_mode(int, string);
    callback toggle_rule_encode(int);
    callback toggle_rule_fallback(int);
    callback add_rule_target(int);
    callback remove_rule_target(int, int);
    callback update_rule_target(int, int, string);
    callback toggle_rule_target(int, int);
    callback test_url_changed(string);

    // Phase 5 Native Pickers & Clipboard Callbacks
    callback pick_torrent_file();
    callback pick_save_folder();
    callback pick_default_folder();
    callback pick_log_folder();
    callback open_log_folder();
    callback open_font_license();
    callback copy_task_url(string);
    callback copy_task_name(string);
    callback purge_single_task(string);
    callback set_task_priority(string, string); // task_id, priority code
    callback toggle_inspector_file(int, bool); // file index, currently included
    // Speed limit schedule editing
    callback schedule_set_enabled(bool);
    callback schedule_add();
    callback schedule_remove(int);
    callback schedule_update(int, string, string); // index, field, value

    // Setup wizard callbacks
    callback close_setup_wizard(int);
    callback finish_setup(SetupFormData);
    callback pick_setup_directory();
    callback setup_set_language(int);
    callback setup_set_appearance(int, int);
    callback restart_setup();
    callback factory_reset();

    // In-app toast dismiss (auto-expire also handled in Rust)
    callback dismiss_toast(int);

    // Task-list background menu
    callback background_refresh();

    // New-task dialog: checksum probe / torrent file pre-selection / batch mode
    callback probe_new_task_checksum();
    callback reset_new_task_probe();
    callback toggle_new_task_file(int);
    callback set_all_new_task_files(bool);
    callback new_task_batch_text_changed(string);
    callback submit_new_task_batch(string, string);

    root_focus := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.handle_key_escape();
                accept
            }
            if root.show_new_task_dialog || root.show_settings || root.show_labs || root.show_setup_wizard || root.show_speed_limit_dialog {
                reject
            }
            if event.modifiers.control && (event.text == "a" || event.text == "A") {
                root.select_all();
                accept
            } else if event.modifiers.control && (event.text == "n" || event.text == "N") {
                root.open_new_task_dialog();
                accept
            } else if event.modifiers.control && (event.text == "f" || event.text == "F") {
                search_box.focus_input();
                accept
            } else if event.modifiers.control && event.text == "," {
                root.open_settings();
                accept
            } else if event.text == " " {
                root.hotkey_space();
                accept
            } else if event.text == Key.Delete {
                root.hotkey_delete(event.modifiers.shift);
                accept
            }
            reject
        }
    }

    HorizontalLayout {
        // Left Sidebar
        Rectangle {
            width: 250px;
            background: Theme.c12151a;
            border-color: Theme.c20242d;
            border-width: 1px;

            VerticalLayout {
                padding-top: 20px;
                padding-bottom: 18px;
                padding-left: 16px;
                padding-right: 16px;
                spacing: 18px;

                // App Brand
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("assets/logo.png");
                            width: 32px;
                            height: 32px;
                            image-fit: contain;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        Text {
                            text: "limedl";
                            color: Theme.cf3f4f6;
                            font-size: 16px;
                            font-weight: 700;
                        }
                        Text {
                            text: @tr("Native Edition");
                            color: Theme.c84cc16;
                            font-size: 10px;
                            font-weight: 600;
                        }
                    }
                }

                // Category List
                VerticalLayout {
                    spacing: 6px;
                    CategoryButton {
                        title: @tr("All Tasks");
                        icon_source: @image-url("assets/icons/download-cloud-2-line.svg");
                        count_text: root.count_all;
                        active: root.active_category == 0;
                        clicked => { root.select_category(0); }
                    }
                    CategoryButton {
                        title: @tr("Downloading");
                        icon_source: @image-url("assets/icons/download-line.svg");
                        count_text: root.count_downloading;
                        active: root.active_category == 1;
                        clicked => { root.select_category(1); }
                    }
                    CategoryButton {
                        title: @tr("Paused");
                        icon_source: @image-url("assets/icons/pause-circle-line.svg");
                        count_text: root.count_paused;
                        active: root.active_category == 2;
                        clicked => { root.select_category(2); }
                    }
                    CategoryButton {
                        title: @tr("Completed");
                        icon_source: @image-url("assets/icons/checkbox-circle-line.svg");
                        count_text: root.count_completed;
                        active: root.active_category == 3;
                        clicked => { root.select_category(3); }
                    }
                    CategoryButton {
                        title: @tr("Failed / Error");
                        icon_source: @image-url("assets/icons/error-warning-line.svg");
                        count_text: root.count_failed;
                        active: root.active_category == 4;
                        clicked => { root.select_category(4); }
                    }
                }

                // Spacer
                Rectangle {}

                // Quick Mode Controls (Game Mode & Overclock)
                VerticalLayout {
                    spacing: 6px;

                    Rectangle {
                        background: root.game_mode_active ? Theme.c351d0b : Theme.c181b22;
                        border-color: root.game_mode_active ? Theme.cf59e0b : Theme.c252b36;
                        border-width: 1px;
                        border-radius: 6px;
                        height: 36px;

                        TouchArea {
                            clicked => { root.toggle_game_mode(); }
                        }

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            alignment: space-between;
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("assets/icons/gamepad-line.svg");
                                        colorize: root.game_mode_active ? Theme.cf59e0b : Theme.c8b95a5;
                                        width: 15px;
                                        height: 15px;
                                        image-fit: contain;
                                    }
                                }
                                Text {
                                    text: @tr("Game Mode");
                                    color: root.game_mode_active ? Theme.cf59e0b : Theme.c9ca3af;
                                    font-size: 12px;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: root.game_mode_active ? "ON" : "OFF";
                                color: root.game_mode_active ? Theme.cfcd34d : Theme.c5d6778;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle {
                        background: root.overclock_mode_active ? Theme.c31132b : Theme.c181b22;
                        border-color: root.overclock_mode_active ? Theme.cec4899 : Theme.c252b36;
                        border-width: 1px;
                        border-radius: 6px;
                        height: 36px;

                        TouchArea {
                            clicked => { root.toggle_overclock_mode(); }
                        }

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            alignment: space-between;
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("assets/icons/rocket-line.svg");
                                        colorize: root.overclock_mode_active ? Theme.cec4899 : Theme.c8b95a5;
                                        width: 15px;
                                        height: 15px;
                                        image-fit: contain;
                                    }
                                }
                                Text {
                                    text: @tr("Overclock Mode");
                                    color: root.overclock_mode_active ? Theme.cec4899 : Theme.c9ca3af;
                                    font-size: 12px;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: root.overclock_mode_active ? "ON" : "OFF";
                                color: root.overclock_mode_active ? Theme.cf472b6 : Theme.c5d6778;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Global Speed Widget
                Rectangle {
                    background: Theme.c181b22;
                    border-color: Theme.c252b36;
                    border-width: 1px;
                    border-radius: 8px;
                    height: 56px;

                    VerticalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        alignment: space-around;
                        Text {
                            text: @tr("Realtime Download Speed");
                            color: Theme.c8b95a5;
                            font-size: 10px;
                            font-weight: 500;
                        }
                        Text {
                            text: root.global_speed_text;
                            color: Theme.c84cc16;
                            font-size: 15px;
                            font-weight: 700;
                        }
                    }
                }

                // Settings & Labs Buttons
                HorizontalLayout {
                    spacing: 8px;

                    // Settings Button
                    Rectangle {
                        background: ta_set.has_hover ? Theme.c222731 : Theme.c181b22;
                        border-color: Theme.c252b36;
                        border-width: 1px;
                        border-radius: 6px;
                        height: 36px;

                        ta_set := TouchArea {
                            clicked => { root.open_settings(); }
                        }

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            alignment: center;
                            spacing: 6px;

                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("assets/icons/settings-3-line.svg");
                                    colorize: ta_set.has_hover ? Theme.cffffff : Theme.cd1d5db;
                                    width: 15px;
                                    height: 15px;
                                    image-fit: contain;
                                }
                            }

                            Text {
                                text: @tr("Settings");
                                color: ta_set.has_hover ? Theme.cffffff : Theme.cd1d5db;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Labs Button
                    Rectangle {
                        background: ta_lab.has_hover ? Theme.c222731 : Theme.c181b22;
                        border-color: Theme.c252b36;
                        border-width: 1px;
                        border-radius: 6px;
                        height: 36px;

                        ta_lab := TouchArea {
                            clicked => { root.open_labs(); }
                        }

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            alignment: center;
                            spacing: 6px;

                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("assets/icons/flask-line.svg");
                                    colorize: ta_lab.has_hover ? Theme.ca3e635 : Theme.cd1d5db;
                                    width: 15px;
                                    height: 15px;
                                    image-fit: contain;
                                }
                            }

                            Text {
                                text: @tr("Labs");
                                color: ta_lab.has_hover ? Theme.ca3e635 : Theme.cd1d5db;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // Right Main Content
        VerticalLayout {
            // Top Toolbar with vertical centering and proper padding
            Rectangle {
                height: 66px;
                background: Theme.c111419;
                border-color: Theme.c20242d;
                border-width: 1px;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 15px;
                    padding-bottom: 15px;
                    spacing: 10px;

                    // Left Title & Search
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: start;

                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: root.active_category == 0 ? @tr("All Tasks") : (
                                    root.active_category == 1 ? @tr("Downloading") : (
                                        root.active_category == 2 ? @tr("Paused") : (
                                            root.active_category == 3 ? @tr("Completed") : @tr("Failed / Error")
                                        )
                                    )
                                );
                                color: Theme.cf3f4f6;
                                font-size: 16px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            search_box := SearchInput {
                                input_width: 170px;
                                text <=> root.search_query;
                                text_changed(q) => { root.search_changed(q); }
                            }
                        }
                    }

                    // Flexible Spacer between left and right groups
                    Rectangle {
                        horizontal-stretch: 1;
                        min-width: 8px;
                    }

                    // Middle / Right Actions
                    HorizontalLayout {
                        spacing: 5px;
                        alignment: center;

                        // View Mode Toggle (Cards / Table)
                        VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: root.view_mode == 0 ? @image-url("assets/icons/file-list-line.svg") : @image-url("assets/icons/layout-grid-line.svg");
                                text_color: Theme.ca3e635;
                                clicked => { root.toggle_view_mode(); }
                            }
                        }

                        // BT runtime status pills (DHT nodes / upload speed / peers)
                        if root.bt_status_visible : VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                spacing: 4px;
                                alignment: center;

                                BtStatPill {
                                    icon: @image-url("assets/icons/global-line.svg");
                                    text: root.bt_dht_text;
                                }
                                BtStatPill {
                                    icon: @image-url("assets/icons/file-upload-line.svg");
                                    text: root.bt_upload_speed_text;
                                }
                                BtStatPill {
                                    icon: @image-url("assets/icons/group-line.svg");
                                    text: root.bt_peers_text;
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 1px;
                                height: 20px;
                                background: Theme.c242934;
                            }
                        }

                        // Sort Selector
                        HorizontalLayout {
                            spacing: 4px;
                            alignment: center;

                            Text {
                                text: @tr("Sort:");
                                color: #6b7280;
                                font-size: 11px;
                                vertical-alignment: center;
                            }

                            CustomSelect {
                                width: 92px;
                                select_height: 32px;
                                font_size: 12px;
                                model: [
                                    @tr("Time"),
                                    @tr("Size"),
                                    @tr("Speed"),
                                    @tr("Progress"),
                                    @tr("File Name"),
                                    @tr("Status"),
                                ];
                                current_index: root.sort_field;
                                selected_index(idx) => {
                                    root.set_sort_field(idx);
                                }
                            }

                            VerticalLayout {
                                alignment: center;
                                IconButton {
                                    icon: root.sort_asc ? @image-url("assets/icons/sort-asc.svg") : @image-url("assets/icons/sort-desc.svg");
                                    text_color: Theme.ca3e635;
                                    clicked => { root.toggle_sort_asc(); }
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 1px;
                                height: 20px;
                                background: Theme.c242934;
                            }
                        }

                        SecondaryButton {
                            icon: @image-url("assets/icons/pause-line.svg");
                            clicked => { root.pause_all(); }
                        }

                        SecondaryButton {
                            icon: @image-url("assets/icons/play-line.svg");
                            clicked => { root.resume_all(); }
                        }

                        SecondaryButton {
                            icon: @image-url("assets/icons/eraser-line.svg");
                            clicked => { root.clear_completed(); }
                        }

                        PrimaryButton {
                            text: @tr("New Task");
                            icon: @image-url("assets/icons/add-line.svg");
                            clicked => { root.open_new_task_dialog(); }
                        }
                    }
                }
            }

            // Task List Area & Floating BatchActionBar
            Rectangle {
                background: Theme.c0d0f12;

                if root.tasks.length == 0 : Rectangle {
                    width: 100%;
                    height: 100%;

                    empty_menu_ta := TouchArea {
                        pointer-event(event) => {
                            if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                                // Empty list → background menu covers the whole area
                                root.background_menu_x = self.absolute-position.x + self.mouse-x + 8px;
                                root.background_menu_y = self.absolute-position.y + self.mouse-y + 8px;
                                root.background_menu_visible = true;
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        spacing: 16px;

                        // Icon badge
                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: 68px;
                                height: 68px;
                                border-radius: 34px;
                                background: root.search_query != "" ? Theme.c14171d : Theme.c181b22;
                                border-width: 1px;
                                border-color: root.search_query != "" ? Theme.c272d38 : Theme.c343c4a;

                                Image {
                                    width: 32px;
                                    height: 32px;
                                    source: root.search_query != "" ? @image-url("assets/icons/search-line.svg") : @image-url("assets/icons/download-cloud-2-line.svg");
                                    colorize: root.search_query != "" ? Theme.c9ca3af : Theme.ca3e635;
                                    image-fit: contain;
                                }
                            }
                        }

                        // Texts
                        VerticalLayout {
                            spacing: 6px;
                            Text {
                                text: root.search_query != "" ? @tr("No matching download tasks found") : @tr("No download tasks yet");
                                color: Theme.ce5e7eb;
                                font-size: 16px;
                                font-weight: 600;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: root.search_query != "" ? @tr("Try clearing your search keywords") : @tr("Add a URL or drag & drop files here to begin downloading");
                                color: Theme.c6b7280;
                                font-size: 13px;
                                horizontal-alignment: center;
                            }
                        }

                        // Action button & hints
                        HorizontalLayout {
                            alignment: center;
                            spacing: 10px;

                            if root.search_query != "" : SecondaryButton {
                                text: @tr("Clear Search");
                                icon: @image-url("assets/icons/close-line.svg");
                                clicked => {
                                    root.search_query = "";
                                    root.search_changed("");
                                }
                            }

                            if root.search_query == "" : PrimaryButton {
                                text: @tr("Create New Task");
                                icon: @image-url("assets/icons/add-line.svg");
                                clicked => { root.open_new_task_dialog(); }
                            }
                        }

                        if root.search_query == "" : HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                height: 26px;
                                border-radius: 13px;
                                background: Theme.c14171d;
                                border-width: 1px;
                                border-color: Theme.c242934;

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 6px;
                                    alignment: center;

                                    Image {
                                        width: 13px;
                                        height: 13px;
                                        source: @image-url("assets/icons/file-upload-line.svg");
                                        colorize: Theme.c6b7280;
                                        image-fit: contain;
                                    }
                                    Text {
                                        text: @tr("Drop .torrent or metalink files to start");
                                        color: Theme.c6b7280;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                if root.tasks.length > 0 && root.view_mode == 0 : ScrollView {
                    viewport-y: 0;
                    // Background layer: non-layout child, pinned to the full
                    // viewport, declared BEFORE the layout so it sits below the
                    // cards in z-order. Right-clicks on empty list space (padding,
                    // gaps, the area below the last card) hit this TouchArea;
                    // card clicks are captured by the card TouchAreas above.
                    Rectangle {
                        width: 100%;
                        height: 100%;

                        list_menu_ta := TouchArea {
                            pointer-event(event) => {
                                if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                                    // absolute-position is window-relative and already
                                    // accounts for ScrollView offsets.
                                    root.background_menu_x = self.absolute-position.x + self.mouse-x + 8px;
                                    root.background_menu_y = self.absolute-position.y + self.mouse-y + 8px;
                                    root.background_menu_visible = true;
                                }
                            }
                        }
                    }

                    // Card list: layout child (viewport-stretched, top-aligned)
                    VerticalLayout {
                        padding-left: 24px;
                        padding-right: 24px;
                        padding-top: 18px;
                        padding-bottom: root.selected_count > 0 ? 80px : 20px;
                        spacing: 12px;
                        alignment: start;

                        for task[idx] in root.tasks : task_card := TaskCard {
                            item: task;
                            compact: root.compact_view;
                            toggle_select => { root.toggle_select_task(task.id); }
                            range_select => { root.range_select_task(task.id); }
                            open_inspector => { root.open_inspector(task.id); }
                            pause_task => { root.pause_task(task.id); }
                            resume_task => { root.resume_task(task.id); }
                            open_explorer => { root.open_task_explorer(task.id); }
                            remove_task => { root.remove_task(task.id); }
                            double_clicked => { root.task_double_clicked(task.id); }
                            show_menu(mx, my) => {
                                // `absolute-position` is window-relative and
                                // already accounts for ScrollView offsets, so
                                // adding the card-local cursor position gives
                                // true window coordinates for the popup.
                                root.context_menu_state = {
                                    visible: true,
                                    x: task_card.absolute-position.x + mx + 8px,
                                    y: task_card.absolute-position.y + my + 8px,
                                    task_id: task.id,
                                    task_name: task.file_name,
                                    task_url: task.url,
                                    can_pause: task.can_pause,
                                    can_resume: task.can_resume,
                                    is_bt: task.kind == "bt",
                                    priority_code: task.priority_code,
                                };
                            }
                        }
                    }
                }

                if root.tasks.length > 0 && root.view_mode == 1 : TaskTable {
                    tasks: root.tasks;
                    sort_field: root.sort_field;
                    sort_asc: root.sort_asc;
                    selected_count: root.selected_count;
                    compact: root.compact_view;
                    column_file: root.column_file;
                    column_size: root.column_size;
                    column_downloaded: root.column_downloaded;
                    column_status: root.column_status;
                    column_progress: root.column_progress;
                    column_speed: root.column_speed;
                    column_priority: root.column_priority;
                    column_upload_speed: root.column_upload_speed;
                    column_seeds: root.column_seeds;
                    column_eta: root.column_eta;
                    toggle_select(id) => { root.toggle_select_task(id); }
                    range_select(id) => { root.range_select_task(id); }
                    open_inspector(id) => { root.open_inspector(id); }
                    pause_task(id) => { root.pause_task(id); }
                    resume_task(id) => { root.resume_task(id); }
                    open_explorer(id) => { root.open_task_explorer(id); }
                    remove_task(id) => { root.remove_task(id); }
                    double_clicked(id) => { root.task_double_clicked(id); }
                    header_sort_clicked(f) => { root.table_sort_clicked(f); }
                    select_all => { root.select_all(); }
                    clear_selection => { root.clear_selection(); }
                    show_priority_menu(t, mx, my) => {
                        root.priority_menu_task_id = t.id;
                        root.priority_menu_current = t.priority_code;
                        root.priority_menu_x = mx;
                        root.priority_menu_y = my;
                        root.priority_menu_visible = true;
                    }
                    show_menu(t, mx, my) => {
                        root.context_menu_state = {
                            visible: true,
                            x: mx,
                            y: my,
                            task_id: t.id,
                            task_name: t.file_name,
                            task_url: t.url,
                            can_pause: t.can_pause,
                            can_resume: t.can_resume,
                            is_bt: t.kind == "bt",
                            priority_code: t.priority_code,
                        };
                    }
                }

                // Floating Batch Action Bar
                if root.selected_count > 0 : Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: parent.height - self.height - 24px;
                    width: min(parent.width - 80px, 820px);
                    height: 56px;
                    background: Theme.c181b22;
                    border-color: Theme.c84cc16;
                    border-width: 1px;
                    border-radius: 10px;
                    drop-shadow-blur: 20px;
                    drop-shadow-color: Theme.c000000cc;

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;

                            Text {
                                text: @tr("Selected ") + root.selected_count + @tr(" tasks");
                                color: Theme.c84cc16;
                                font-size: 13px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }

                            IconButton {
                                text: @tr("Select All");
                                text_color: Theme.c9ca3af;
                                clicked => { root.select_all(); }
                            }

                            IconButton {
                                text: @tr("Deselect");
                                text_color: Theme.c9ca3af;
                                clicked => { root.clear_selection(); }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;

                            SecondaryButton {
                                text: @tr("Pause Selected");
                                icon: @image-url("assets/icons/pause-line.svg");
                                clicked => { root.batch_pause(); }
                            }

                            SecondaryButton {
                                text: @tr("Resume Selected");
                                icon: @image-url("assets/icons/play-line.svg");
                                clicked => { root.batch_resume(); }
                            }

                            SecondaryButton {
                                text: @tr("Remove Records");
                                icon: @image-url("assets/icons/delete-bin-line.svg");
                                clicked => { root.batch_remove(false); }
                            }

                            PrimaryButton {
                                text: @tr("Delete Files");
                                icon: @image-url("assets/icons/delete-bin-6-line.svg");
                                clicked => { root.batch_remove(true); }
                            }
                        }
                    }
                }
            }
        }
    }

    // Context Menu Overlay
    if root.context_menu_state.visible : ContextMenu {
        menu_state: root.context_menu_state;
        close => { root.context_menu_state.visible = false; }
        open_inspector(id) => { root.open_inspector(id); }
        pause_task(id) => { root.pause_task(id); }
        resume_task(id) => { root.resume_task(id); }
        open_explorer(id) => { root.open_task_explorer(id); }
        copy_url(url) => { root.copy_task_url(url); }
        copy_name(name) => { root.copy_task_name(name); }
        open_speed_limit(id) => { root.open_inspector(id); root.open_speed_limit_dialog(); }
        set_priority(id) => {
            // Open the popup anchored under the task's row (the context menu
            // already knows the row it was opened from).
            root.priority_menu_task_id = id;
            root.priority_menu_current = root.context_menu_state.priority_code;
            root.priority_menu_x = root.context_menu_state.x;
            root.priority_menu_y = root.context_menu_state.y;
            root.priority_menu_visible = true;
        }
        remove_task(id) => { root.remove_task(id); }
        purge_task(id) => { root.purge_single_task(id); }
    }

    // Priority popup menu (table badge / task context menu)
    PriorityMenu {
        is_open: root.priority_menu_visible;
        menu_x: root.priority_menu_x;
        menu_y: root.priority_menu_y;
        task_id: root.priority_menu_task_id;
        current_priority: root.priority_menu_current;
        close => { root.priority_menu_visible = false; }
        pick(id, code) => { root.set_task_priority(id, code); }
    }

    // Dialog: Settings Center
    SettingsDialog {
        is_open: root.show_settings;
        settings_tab: root.settings_tab;
        settings_form <=> root.settings_form;
        speed_limit_slots <=> root.speed_limit_slots;
        update_state <=> root.update_state;
        close => { root.close_settings(); }
        set_tab(tab) => { root.set_settings_tab(tab); }
        save(form) => { root.save_settings(form); }
        toggle_game_mode => { root.toggle_game_mode(); }
        toggle_overclock_mode => { root.toggle_overclock_mode(); }
        fetch_trackers(url) => { root.fetch_trackers_remote(url); }
        pick_default_folder => { root.pick_default_folder(); }
        pick_log_folder => { root.pick_log_folder(); }
        open_log_folder => { root.open_log_folder(); }
        open_font_license => { root.open_font_license(); }
        check_updates => { root.check_for_updates(); }
        start_download => { root.start_update_download(); }
        restart_now => { root.restart_after_update(); }
        restart_setup => { root.restart_setup(); }
        factory_reset => { root.factory_reset(); }
        schedule_set_enabled(enabled) => { root.schedule_set_enabled(enabled); }
        schedule_add => { root.schedule_add(); }
        schedule_remove(idx) => { root.schedule_remove(idx); }
        schedule_update(idx, field, value) => { root.schedule_update(idx, field, value); }
    }

    // Dialog: Labs (CDN Acceleration & URL Rewrite)
    LabsDialog {
        is_open: root.show_labs;
        labs_tab: root.labs_tab;
        labs_form <=> root.labs_form;
        cdn_candidates: root.cdn_candidates;
        rewrite_rules: root.rewrite_rules;
        close => { root.close_labs(); }
        set_tab(tab) => { root.set_labs_tab(tab); }
        save_labs(data) => { root.save_labs(data); }
        start_cdn_test => { root.start_cdn_test(); }
        cancel_cdn_test => { root.cancel_cdn_test(); }
        clear_cdn_test => { root.clear_cdn_test(); }
        apply_cdn_candidate(ip, tp) => { root.apply_cdn_candidate(ip, tp); }
        toggle_cdn_advanced => { root.toggle_cdn_advanced(); }
        apply_manual_cdn_ip(ip) => { root.apply_manual_cdn_ip(ip); }
        import_rewrite_preset(p) => { root.import_rewrite_preset(p); }
        add_custom_rule => { root.add_custom_rule(); }
        remove_rule(idx) => { root.remove_rule(idx); }
        toggle_rule_expanded(idx) => { root.toggle_rule_expanded(idx); }
        toggle_rule_enabled(idx) => { root.toggle_rule_enabled(idx); }
        update_rule_name(idx, name) => { root.update_rule_name(idx, name); }
        update_rule_match_type(idx, mt) => { root.update_rule_match_type(idx, mt); }
        update_rule_pattern(idx, pat) => { root.update_rule_pattern(idx, pat); }
        update_rule_mode(idx, mode) => { root.update_rule_mode(idx, mode); }
        toggle_rule_encode(idx) => { root.toggle_rule_encode(idx); }
        toggle_rule_fallback(idx) => { root.toggle_rule_fallback(idx); }
        add_rule_target(idx) => { root.add_rule_target(idx); }
        remove_rule_target(ridx, tidx) => { root.remove_rule_target(ridx, tidx); }
        update_rule_target(ridx, tidx, tmpl) => { root.update_rule_target(ridx, tidx, tmpl); }
        toggle_rule_target(ridx, tidx) => { root.toggle_rule_target(ridx, tidx); }
        test_url_changed(url) => { root.test_url_changed(url); }
    }

    // Dialog: Task Inspector
    TaskInspector {
        is_open: root.show_inspector;
        inspector_info: root.inspector_info;
        inspector_tab: root.inspector_tab;
        inspector_peers: root.inspector_peers;
        inspector_trackers: root.inspector_trackers;
        inspector_files: root.inspector_files;
        inspector_piece_map: root.inspector_piece_map;
        inspector_pieces_count_text: root.inspector_pieces_count_text;
        close => { root.close_inspector(); }
        set_tab(tab) => { root.set_inspector_tab(tab); }
        open_speed_limit => { root.open_speed_limit_dialog(); }
        open_explorer(id) => { root.open_task_explorer(id); }
        toggle_file(idx, included) => { root.toggle_inspector_file(idx, included); }
    }

    // Dialog: Speed Limit
    SpeedLimitDialog {
        is_open: root.show_speed_limit_dialog;
        speed_limit_dl_kb <=> root.speed_limit_dl_kb;
        speed_limit_ul_kb <=> root.speed_limit_ul_kb;
        close => { root.close_speed_limit_dialog(); }
        submit(dl, ul) => { root.submit_speed_limit(dl, ul); }
    }

    // Dialog: New Task
    NewTaskDialog {
        is_open: root.show_new_task_dialog;
        new_task_url <=> root.new_task_url;
        new_task_dir <=> root.new_task_dir;
        new_task_filename <=> root.new_task_filename;
        default_download_dir: root.default_download_dir;
        probe_state: root.new_task_probe_state;
        probe_status_text: root.new_task_probe_status_text;
        preview_state: root.new_task_preview_state;
        preview_status_text: root.new_task_preview_status_text;
        preview_summary_text: root.new_task_preview_summary_text;
        torrent_files: root.new_task_torrent_files;
        batch_count_text: root.new_task_batch_count_text;
        batch_submitting: root.new_task_batch_submitting;
        batch_status_text: root.new_task_batch_status_text;
        batch_mode <=> root.new_task_batch_mode;
        batch_text <=> root.new_task_batch_text;
        close => { root.close_new_task_dialog(); }
        submit(url, dir, filename) => { root.submit_new_task(url, dir, filename); }
        pick_torrent_file => { root.pick_torrent_file(); }
        pick_save_folder => { root.pick_save_folder(); }
        probe_checksum => { root.probe_new_task_checksum(); }
        reset_probe => { root.reset_new_task_probe(); }
        toggle_torrent_file(idx) => { root.toggle_new_task_file(idx); }
        set_all_torrent_files(all) => { root.set_all_new_task_files(all); }
        batch_text_changed(text) => { root.new_task_batch_text_changed(text); }
        submit_batch(text, dir) => { root.submit_new_task_batch(text, dir); }
    }

    // First-run setup wizard (modal, above all dialogs)
    SetupWizard {
        is_open: root.show_setup_wizard;
        form <=> root.setup_form;
        start_step: root.setup_start_step;
        close(step) => { root.close_setup_wizard(step); }
        finish(form) => { root.finish_setup(form); }
        pick_directory => { root.pick_setup_directory(); }
        set_language(idx) => { root.setup_set_language(idx); }
        set_appearance(cm, tc) => { root.setup_set_appearance(cm, tc); }
    }

    // Task-list background context menu
    if root.background_menu_visible : BackgroundMenu {
        bg_visible: root.background_menu_visible;
        menu_x: root.background_menu_x;
        menu_y: root.background_menu_y;
        close => { root.background_menu_visible = false; }
        new_task => { root.open_new_task_dialog(); }
        refresh_list => { root.background_refresh(); }
    }

    // In-app toasts (topmost layer: above dialogs, handles own visibility and animations)
    ToastStack {
        toasts <=> root.toasts;
        dismiss(id) => { root.dismiss_toast(id); }
    }
}
