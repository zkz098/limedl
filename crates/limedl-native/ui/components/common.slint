export component TabButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> active: false;
    callback clicked();

    background: root.active ? Theme.c232b1d : (ta.has_hover ? Theme.c1a1e25 : transparent);
    border-radius: 6px;
    height: 34px;

    ta := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;
        alignment: center;

        if root.icon.width > 0 : VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                colorize: root.active ? Theme.c84cc16 : (ta.has_hover ? Theme.cf3f4f6 : Theme.c8b95a5);
                width: 15px;
                height: 15px;
                image-fit: contain;
            }
        }

        Text {
            text: root.text;
            color: root.active ? Theme.c84cc16 : (ta.has_hover ? Theme.cf3f4f6 : Theme.c9ca3af);
            font-size: 12px;
            font-weight: root.active ? 600 : 400;
            vertical-alignment: center;
        }
    }

    if root.active : Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: Theme.c84cc16;
        border-radius: 1px;
    }
}

export component CustomCheckBox inherits Rectangle {
    in property <bool> checked: false;
    callback toggled();

    width: 18px;
    height: 18px;
    border-radius: 4px;
    background: root.checked ? Theme.c84cc16 : (ta.has_hover ? Theme.c242932 : Theme.c15181d);
    border-color: root.checked ? Theme.c84cc16 : Theme.c3f4756;
    border-width: 1px;

    ta := TouchArea {
        clicked => { root.toggled(); }
    }

    if root.checked : Text {
        text: "✓";
        color: #0b1104;
        font-size: 12px;
        font-weight: 800;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

export component ToggleSwitch inherits Rectangle {
    in property <bool> checked: false;
    callback toggled();

    width: 42px;
    height: 22px;
    border-radius: 11px;
    background: root.checked ? Theme.c84cc16 : Theme.c252b34;

    ta := TouchArea {
        clicked => { root.toggled(); }
    }

    Rectangle {
        x: root.checked ? parent.width - self.width - 3px : 3px;
        y: 3px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: root.checked ? #0b1104 : Theme.c9ca3af;
    }
}

export component SearchInput inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: @tr("Search downloads...");
    callback text_changed(string);

    background: Theme.c15171c;
    border-color: ta.has-focus ? Theme.c84cc16 : Theme.c2a2f3a;
    border-width: 1px;
    border-radius: 6px;
    height: 32px;
    width: 230px;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;

        VerticalLayout {
            alignment: center;
            width: 20px;
            Image {
                source: @image-url("../assets/icons/search-line.svg");
                colorize: ta.has-focus ? Theme.c84cc16 : Theme.c5d6778;
                width: 14px;
                height: 14px;
                image-fit: contain;
            }
        }

        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Rectangle {
                clip: true;
                height: 100%;

                if root.text == "" : Text {
                    text: root.placeholder;
                    color: Theme.c5d6778;
                    font-size: 12px;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }

                ta := TextInput {
                    text <=> root.text;
                    color: Theme.cf3f4f6;
                    font-size: 12px;
                    vertical-alignment: center;
                    single-line: true;
                    width: 100%;
                    height: 100%;
                    edited => { root.text_changed(root.text); }
                }
            }
        }
    }
}

export component CustomTextInput inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: "";
    in property <bool> enabled: true;

    callback edited(string);
    callback accepted(string);

    background: Theme.c14161b;
    border-color: ta.has-focus ? Theme.c84cc16 : Theme.c2b313d;
    border-width: 1px;
    border-radius: 6px;
    height: 36px;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;

        VerticalLayout {
            alignment: center;
            Rectangle {
                clip: true;
                height: 100%;

                if root.text == "" : Text {
                    text: root.placeholder;
                    color: Theme.c5d6778;
                    font-size: 13px;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }

                ta := TextInput {
                    text <=> root.text;
                    enabled: root.enabled;
                    color: Theme.cf3f4f6;
                    font-size: 13px;
                    vertical-alignment: center;
                    single-line: true;
                    width: 100%;
                    height: 100%;
                    edited => { root.edited(root.text); }
                    accepted => { root.accepted(root.text); }
                }
            }
        }
    }
}

export component UnitInput inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: "";
    in property <string> unit_text: "";
    in property <bool> enabled: true;

    callback edited(string);
    callback accepted(string);

    background: Theme.c14161b;
    border-color: ta.has-focus ? Theme.c84cc16 : Theme.c2b313d;
    border-width: 1px;
    border-radius: 6px;
    height: 36px;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 6px;
        spacing: 8px;

        // NOTE: do NOT use `alignment: space-between` here. The input area's
        // children all use percentage widths (they contribute nothing to the
        // preferred-width calculation), so under space-between the input
        // column collapses to zero width: the field shows only a text
        // fragment, never gains focus and cannot be typed in. Default
        // (stretch) alignment + horizontal-stretch on the unit badge keeps
        // the input area at full remaining width.
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Rectangle {
                clip: true;
                height: 100%;

                if root.text == "" : Text {
                    text: root.placeholder;
                    color: Theme.c5d6778;
                    font-size: 13px;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }

                ta := TextInput {
                    text <=> root.text;
                    enabled: root.enabled;
                    color: Theme.cf3f4f6;
                    font-size: 13px;
                    vertical-alignment: center;
                    single-line: true;
                    width: 100%;
                    height: 100%;
                    edited => { root.edited(root.text); }
                    accepted => { root.accepted(root.text); }
                }
            }
        }

        if root.unit_text != "" : VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Rectangle {
                background: Theme.c1d212a;
                border-radius: 4px;
                height: 24px;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    alignment: center;
                    Text {
                        text: root.unit_text;
                        color: Theme.c84cc16;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

export component StatusBadge inherits Rectangle {
    in property <string> state_code;
    in property <string> state_label;

    background: root.state_code == "downloading" ? Theme.c142e1b : (
        root.state_code == "paused" ? Theme.c33200b : (
            root.state_code == "completed" ? Theme.c112842 : Theme.c361214
        )
    );
    border-color: root.state_code == "downloading" ? Theme.c22542e : (
        root.state_code == "paused" ? Theme.c543615 : (
            root.state_code == "completed" ? Theme.c1d406b : Theme.c5c1f23
        )
    );
    border-width: 1px;
    border-radius: 10px;
    height: 20px;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 5px;
        alignment: center;

        // Glowing Dot Indicator
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: root.state_code == "downloading" ? Theme.c4ade80 : (
                    root.state_code == "paused" ? Theme.cfacc15 : (
                        root.state_code == "completed" ? Theme.c38bdf8 : Theme.cf87171
                    )
                );
            }
        }

        Text {
            text: root.state_label;
            color: root.state_code == "downloading" ? Theme.c4ade80 : (
                root.state_code == "paused" ? Theme.cfacc15 : (
                    root.state_code == "completed" ? Theme.c60a5fa : Theme.cf87171
                )
            );
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

export component ToneBadge inherits Rectangle {
    in property <string> text;
    in property <string> tone: "neutral"; // neutral, success, info, warning, danger

    background: root.tone == "success" ? Theme.c14351a : (
        root.tone == "info" ? Theme.c132a42 : (
            root.tone == "warning" ? Theme.c3b280c : (
                root.tone == "danger" ? Theme.c3b1216 : Theme.c20252e
            )
        )
    );
    border-color: root.tone == "success" ? Theme.c22c55e : (
        root.tone == "info" ? Theme.c38bdf8 : (
            root.tone == "warning" ? Theme.cf59e0b : (
                root.tone == "danger" ? Theme.cef4444 : Theme.c3b4352
            )
        )
    );
    border-width: 1px;
    border-radius: 4px;
    height: 22px;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        alignment: center;
        Text {
            text: root.text;
            color: root.tone == "success" ? Theme.c4ade80 : (
                root.tone == "info" ? Theme.c38bdf8 : (
                    root.tone == "warning" ? Theme.cfbbf24 : (
                        root.tone == "danger" ? Theme.cf87171 : Theme.c9ca3af
                    )
                )
            );
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

