//! Settings center dialog: header, tab bar, footer and per-tab components.
//! Each tab lives in `settings/tab_*.slint`.

import { Theme } from "../theme.slint";
import { SettingsFormData, SpeedLimitSlotItem, UpdateState } from "../types.slint";
import {
    IconButton,
    PrimaryButton,
    SecondaryButton,
    TabButton,
} from "common.slint";
import { SettingsTabAppearance } from "settings/tab_appearance.slint";
import { SettingsTabDownload } from "settings/tab_download.slint";
import { SettingsTabProxy } from "settings/tab_proxy.slint";
import { SettingsTabSchedule } from "settings/tab_schedule.slint";
import { SettingsTabBt } from "settings/tab_bt.slint";
import { SettingsTabIo } from "settings/tab_io.slint";
import { SettingsTabLog } from "settings/tab_log.slint";
import { SettingsTabAria2 } from "settings/tab_aria2.slint";
import { SettingsTabAbout } from "settings/tab_about.slint";

export component SettingsDialog inherits Rectangle {
    in property <int> settings_tab: 0;
    // Advanced BT settings section is collapsed by default (not persisted:
    // the dialog is recreated on each open, so this resets to false).
    in-out property <bool> bt_show_advanced: false;
    // Factory reset asks for an inline second confirmation (full data wipe).
    in-out property <bool> reset_confirm: false;
    in-out property <SettingsFormData> settings_form;
    in-out property <[SpeedLimitSlotItem]> speed_limit_slots: [];
    in-out property <UpdateState> update_state;

    callback close();
    callback set_tab(int);
    callback save(SettingsFormData);
    callback toggle_game_mode();
    callback toggle_overclock_mode();
    callback fetch_trackers(string);
    callback pick_default_folder();
    callback pick_log_folder();
    callback open_log_folder();
    callback open_font_license();
    callback check_updates();
    callback start_download();
    callback restart_now();
    callback restart_setup();
    callback factory_reset();
    // Speed limit schedule editing (authoritative text state lives in Rust).
    callback schedule_set_enabled(bool);
    callback schedule_add();
    callback schedule_remove(int);
    callback schedule_update(int, string, string); // index, field("start"/"end"/"limit"), value

    in property <bool> is_open: false;

    width: 100%;
    height: 100%;
    visible: root.is_open || root.opacity > 0.01;
    opacity: root.is_open ? 1.0 : 0.0;
    animate opacity { duration: 160ms; easing: ease-out; }
    background: Theme.c000000bb;

    TouchArea {
        enabled: root.is_open;
    }

    Rectangle {
        width: min(parent.width - 100px, 1140px);
        height: min(parent.height - 100px, 820px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 + (root.is_open ? 0px : 14px);
        animate y { duration: 160ms; easing: ease-out; }
        background: Theme.c171a20;
        border-color: Theme.c2e3542;
        border-width: 1px;
        border-radius: 12px;
        drop-shadow-blur: 24px;
        drop-shadow-color: Theme.c000000cc;

        VerticalLayout {
            padding: 20px;
            spacing: 12px;

            // Header
            HorizontalLayout {
                alignment: space-between;
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../assets/icons/settings-3-line.svg");
                            colorize: Theme.ca3e635;
                            width: 18px;
                            height: 18px;
                            image-fit: contain;
                        }
                    }
                    Text {
                        text: @tr("Settings Center");
                        color: Theme.cf3f4f6;
                        font-size: 16px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
                // Header close button. The id is what the in-process UI tests
                // (src/ui_tests/) click, and what element introspection (L2/MCP)
                // can address — keep it stable.
                close_btn := IconButton {
                    icon: @image-url("../assets/icons/close-line.svg");
                    clicked => { root.close(); }
                }
            }

            // Tab Headers (Two-tier Common vs Advanced). Split into two rows
            // so the labels always fit the modal width in both locales — a
            // single start-aligned row overflowed the 940px modal with the
            // English labels and clipped the last tabs (Logging / Aria2).
            VerticalLayout {
                spacing: 6px;

                // Row 1 — Common
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    Text { text: @tr("Common:"); color: #6b7280; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                    TabButton {
                        text: @tr("Appearance");
                        icon: @image-url("../assets/icons/palette-line.svg");
                        active: root.settings_tab == 0;
                        clicked => { root.set_tab(0); }
                    }
                    TabButton {
                        text: @tr("Download");
                        icon: @image-url("../assets/icons/download-line.svg");
                        active: root.settings_tab == 1;
                        clicked => { root.set_tab(1); }
                    }
                    TabButton {
                        text: @tr("Proxy");
                        icon: @image-url("../assets/icons/global-line.svg");
                        active: root.settings_tab == 2;
                        clicked => { root.set_tab(2); }
                    }
                    TabButton {
                        text: @tr("About");
                        icon: @image-url("../assets/icons/information-line.svg");
                        active: root.settings_tab == 8;
                        clicked => { root.set_tab(8); }
                    }
                }

                // Row 2 — Advanced
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    Text { text: @tr("Advanced:"); color: #6b7280; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                    TabButton {
                        text: @tr("Scheduler");
                        icon: @image-url("../assets/icons/dashboard-3-line.svg");
                        active: root.settings_tab == 3;
                        clicked => { root.set_tab(3); }
                    }
                    TabButton {
                        text: @tr("BT Network");
                        icon: @image-url("../assets/icons/radar-line.svg");
                        active: root.settings_tab == 4;
                        clicked => { root.set_tab(4); }
                    }
                    TabButton {
                        text: @tr("IO & Storage");
                        icon: @image-url("../assets/icons/hard-drive-2-line.svg");
                        active: root.settings_tab == 5;
                        clicked => { root.set_tab(5); }
                    }
                    TabButton {
                        text: @tr("Logging");
                        icon: @image-url("../assets/icons/file-list-line.svg");
                        active: root.settings_tab == 6;
                        clicked => { root.set_tab(6); }
                    }
                    TabButton {
                        text: @tr("Aria2");
                        icon: @image-url("../assets/icons/terminal-box-line.svg");
                        active: root.settings_tab == 7;
                        clicked => { root.set_tab(7); }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.c272d38;
            }

            // Tab Content — unified container
            Rectangle {
                background: Theme.c111418;
                border-radius: 8px;
                border-color: Theme.c232832;
                border-width: 1px;
                // ── Tab 0: 外观 / 启动 ──
                if root.settings_tab == 0 : SettingsTabAppearance {
                    settings_form <=> root.settings_form;
                }

                // ── Tab 1: 下载 ──
                if root.settings_tab == 1 : SettingsTabDownload {
                    settings_form <=> root.settings_form;
                    pick_default_folder => { root.pick_default_folder(); }
                }

                // ── Tab 2: 代理 ──
                if root.settings_tab == 2 : SettingsTabProxy {
                    settings_form <=> root.settings_form;
                }

                // ── Tab 3: 调度 ──
                if root.settings_tab == 3 : SettingsTabSchedule {
                    settings_form <=> root.settings_form;
                    speed_limit_slots <=> root.speed_limit_slots;
                    schedule_set_enabled(enabled) => { root.schedule_set_enabled(enabled); }
                    schedule_add => { root.schedule_add(); }
                    schedule_remove(index) => { root.schedule_remove(index); }
                    schedule_update(index, field, value) => { root.schedule_update(index, field, value); }
                }

                // ── Tab 4: BT 网络 ──
                if root.settings_tab == 4 : SettingsTabBt {
                    settings_form <=> root.settings_form;
                    bt_show_advanced <=> root.bt_show_advanced;
                    fetch_trackers(url) => { root.fetch_trackers(url); }
                }

                // ── Tab 5: IO 实验室 ──
                if root.settings_tab == 5 : SettingsTabIo {
                    settings_form <=> root.settings_form;
                    toggle_game_mode => { root.toggle_game_mode(); }
                    toggle_overclock_mode => { root.toggle_overclock_mode(); }
                }

                // ── Tab 6: 日志 ──
                if root.settings_tab == 6 : SettingsTabLog {
                    settings_form <=> root.settings_form;
                    pick_log_folder => { root.pick_log_folder(); }
                    open_log_folder => { root.open_log_folder(); }
                }

                // ── Tab 7: Aria2 RPC ──
                if root.settings_tab == 7 : SettingsTabAria2 {
                    settings_form <=> root.settings_form;
                }

                // ── Tab 8: 关于 ──
                if root.settings_tab == 8 : SettingsTabAbout {
                    settings_form <=> root.settings_form;
                    update_state <=> root.update_state;
                    reset_confirm <=> root.reset_confirm;
                    check_updates => { root.check_updates(); }
                    start_download => { root.start_download(); }
                    restart_now => { root.restart_now(); }
                    restart_setup => { root.restart_setup(); }
                    factory_reset => { root.factory_reset(); }
                    open_font_license => { root.open_font_license(); }
                }

            }

            // Footer
            HorizontalLayout {
                alignment: end;
                spacing: 10px;

                SecondaryButton {
                    text: @tr("Cancel");
                    clicked => { root.close(); }
                }

                PrimaryButton {
                    text: @tr("Save Settings");
                    icon: @image-url("../assets/icons/save-line.svg");
                    clicked => { root.save(root.settings_form); }
                }
            }
        }
    }
}
