    {
      "id": "claim_9c0d5dcff6e1458e835a784c7889c1d7",
      "statement": "TaskId variants are Http(Uuid) and Bt(InfoHash), where InfoHash is limedl-types' own 20-byte newtype rather than irontide's Id20; they wire-serialize as http:<uuid> / bt:<hex>, deliberately do not implement Serialize/Deserialize, and expose kind() as the routing key.",
      "evidence": [
        {
          "resource": "repo://crates/limedl-types/src/types/task.rs#L39-L103",
          "version": "repo-lines-v1:sha256:898c567e8800b1d40eed18d736be1c0224706317edc543c37477ecf75f03fdbf:"
        }
      ]
    },
    {
      "id": "claim_23128312cda3460aa54342a83ae50b55",
      "statement": "StartDownloadRequest::classify_kind gives an explicit kind precedence, otherwise routes magnet: URLs and .torrent URLs/paths to BT and http(s) URLs to HTTP.",
