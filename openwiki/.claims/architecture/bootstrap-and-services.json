    {
      "id": "claim_f69b34a4ba464c7e92842d79f7d55f6d",
      "statement": "SystemContext::with_components constructs the Database, a BufferPool sized from io_baseline, a DiskDeviceManager seeded with persisted disk_type_overrides, an IoWorker pool of min(available_parallelism, 4), ConcurrencyManager::new(5, 3), DiskIoService and a shutdown CancellationToken.",
      "evidence": [
        {
          "resource": "repo://crates/limedl-core/src/context.rs#L31-L100",
          "version": "repo-lines-v1:sha256:d5bcef33a6849cb22e88532f6efa2663793988823a7eb70e5f8f08996e7ae52b:"
        }
      ]
    },
