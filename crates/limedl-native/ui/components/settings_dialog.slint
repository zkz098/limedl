                        Text { text: @tr("BitTorrent Network"); color: Theme.ca3e635; font-size: 13px; font-weight: 700; }

                        // 基础
                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: @tr("Enable DHT"); color: Theme.cf3f4f6; font-size: 13px; font-weight: 600;
                                    Tooltip {
                                        Rectangle {
                                            background: Theme.c111419;
                                            border-width: 1px;
        border-color: Theme.c2e3542;
                                            border-radius: 8px;
                                            max-width: 520px;
                                            HorizontalLayout { padding: 10px; Text { text: @tr("DHT discovers peers from the distributed network. Changes apply to the BT session after restart."); wrap: word-wrap; color: Theme.cf3f4f6; font-size: 12px; vertical-alignment: center; } }
                                        }
                                    } }
                                Text { text: @tr("Discover peers via DHT when no trackers are available"); color: #6b7280; font-size: 11px; }
                            }
                            ToggleSwitch {
                                checked: root.settings_form.dht_enabled;
                                toggled => { root.settings_form.dht_enabled = !root.settings_form.dht_enabled; }
                            }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Listen Port (empty for random):"); color: Theme.c9ca3af; font-size: 12px;
                                    Tooltip {
                                        Rectangle {
                                            background: Theme.c111419;
                                            border-width: 1px;
        border-color: Theme.c2e3542;
                                            border-radius: 8px;
                                            max-width: 520px;
                                            HorizontalLayout { padding: 10px; Text { text: @tr("Leave empty for auto-assignment. 1024–65535"); wrap: word-wrap; color: Theme.cf3f4f6; font-size: 12px; vertical-alignment: center; } }
                                        }
                                    } }
                                UnitInput {
                                    text <=> root.settings_form.listen_port;
