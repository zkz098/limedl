                                            border-width: 1px;
        border-color: Theme.c2e3542;
                                            border-radius: 8px;
                                            max-width: 520px;
                                            HorizontalLayout { padding: 10px; Text { text: @tr("Ban disconnects and blacklists offending peers for a while; Limit Slots caps how many peers a torrent uploads to at once."); wrap: word-wrap; color: Theme.cf3f4f6; font-size: 12px; vertical-alignment: center; } }
                                        }
                                    } }
                                ComboBox {
                                    model: [@tr("Ban"), @tr("Limit Upload Slots")];
                                    current-index <=> root.settings_form.bt_anti_leech_action_idx;
                                    height: 36px;
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Grace Period:"); color: Theme.c9ca3af; font-size: 12px;
                                    Tooltip {
                                        Rectangle {
