# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*

# Frontend workspace (website/ — Astro + pnpm)
node_modules
dist
.astro

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
target/

# Large binary archives (OS images, datasets, etc.)
*.tar.gz
*.tar
*.tar.xz
*.tar.bz2
*.zip
*.iso
*.img
*.dmg
*.vhd
*.vhdx
*.ova
*.ovf
*.qcow2
*.exe
*.msix

# MiSans VF font — fetched by `cargo xtask fetch-font`, not committed to git
# (MiSans font license forbids re-distributing the font file itself)
crates/limedl-native/assets/fonts/

# minisign signing keys — `cargo xtask generate-key` writes these; the private
# key belongs in the CI secret LIMEDL_SIGNING_KEY, never in git.
*.key

# Temporary files
temp/

