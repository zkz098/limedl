export component CategoryButton inherits Rectangle {
    in property <string> title;
    in property <image> icon_source;
    in property <string> count_text: "0";
    in property <bool> active: false;
    callback clicked();

    background: root.active ? Theme.c232b1d : (ta.has_hover ? Theme.c171b21 : transparent);
    border-radius: 6px;
    height: 36px;

    ta := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        alignment: space-between;

        HorizontalLayout {
            spacing: 8px;
            alignment: start;

            VerticalLayout {
                alignment: center;
                Image {
                    source: root.icon_source;
                    colorize: root.active ? Theme.c84cc16 : (ta.has_hover ? Theme.cf3f4f6 : Theme.c8b95a5);
                    width: 16px;
                    height: 16px;
                    image-fit: contain;
                }
            }

            Text {
                text: root.title;
                color: root.active ? Theme.c84cc16 : (ta.has_hover ? Theme.cf3f4f6 : Theme.c9ca3af);
                font-size: 13px;
                font-weight: root.active ? 600 : 400;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            alignment: center;
            Rectangle {
                // Active badge: accent-soft surface + accent-strong text (same
                // semantics as the active row background). The previous
                // c365314/ca3e635 pair mapped to a near-black pill with bright
                // lime text in light mode — inverted versus the theme.
                background: root.active ? Theme.c26331a : Theme.c1e2229;
                border-radius: 10px;
                height: 20px;
                min-width: 22px;
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    alignment: center;
                    Text {
                        text: root.count_text;
                        color: root.active ? Theme.c65a30d : Theme.c8b95a5;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
