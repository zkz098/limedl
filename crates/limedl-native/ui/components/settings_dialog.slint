                                            border-width: 1px;
        border-color: Theme.c2e3542;
                                            border-radius: 8px;
                                            max-width: 520px;
                                            HorizontalLayout { padding: 10px; Text { text: @tr("When either the uploaded amount or share ratio limit is reached, the matching BT task is paused."); wrap: word-wrap; color: Theme.cf3f4f6; font-size: 12px; vertical-alignment: center; } }
