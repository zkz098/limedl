import { ScrollView } from "std-widgets.slint";
export {
    TaskItem,
    PeerItem,
    TrackerItem,
    TorrentFileItem,
    InspectorInfo,
    SettingsFormData,
    ContextMenuState,
} from "types.slint";

import {
    TaskItem,
    PeerItem,
    TrackerItem,
    TorrentFileItem,
    InspectorInfo,
    SettingsFormData,
    ContextMenuState,
} from "types.slint";

import {
    CategoryButton,
    IconButton,
    PrimaryButton,
    SearchInput,
    SecondaryButton,
} from "components/common.slint";

import { TaskCard } from "components/task_card.slint";
import { ContextMenu } from "components/context_menu.slint";
import { NewTaskDialog } from "components/new_task_dialog.slint";
import { TaskInspector } from "components/inspector.slint";
import { SpeedLimitDialog } from "components/speed_limit_dialog.slint";
import { SettingsDialog } from "components/settings_dialog.slint";

export component MainWindow inherits Window {
    title: "limedl - Native";
    icon: @image-url("assets/icon.png");
    min-width: 1000px;
    min-height: 660px;
    default-font-family: "Segoe UI, PingFang SC, Microsoft YaHei, sans-serif";
    background: #0d0f12;

    // State properties
    in property <[TaskItem]> tasks: [];
    in property <int> active_category: 0; // 0: All, 1: Downloading, 2: Paused, 3: Completed, 4: Failed
    in property <string> count_all: "0";
    in property <string> count_downloading: "0";
    in property <string> count_paused: "0";
    in property <string> count_completed: "0";
    in property <string> count_failed: "0";
    in property <string> global_speed_text: "0 B/s";
    in property <string> default_download_dir: "";
    in property <bool> show_new_task_dialog: false;

    // Search & Sort state
    in-out property <string> search_query: "";
    in property <int> sort_field: 0; // 0: Created, 1: Size, 2: Speed, 3: Progress, 4: Name
    in property <bool> sort_asc: false;
    in property <int> selected_count: 0;

    // Phase 3: Inspector state
    in property <bool> show_inspector: false;
    in property <InspectorInfo> inspector_info;
    in property <int> inspector_tab: 0;
    in property <[PeerItem]> inspector_peers: [];
    in property <[TrackerItem]> inspector_trackers: [];
    in property <[TorrentFileItem]> inspector_files: [];
    in property <image> inspector_piece_map;
    in property <string> inspector_pieces_count_text: "";
    in property <bool> show_speed_limit_dialog: false;
    in-out property <string> speed_limit_dl_kb: "0";
    in-out property <string> speed_limit_ul_kb: "0";

    // Phase 4: Settings & Performance Modes state
    in property <bool> show_settings: false;
    in property <int> settings_tab: 0;
    in-out property <SettingsFormData> settings_form;
    in property <bool> game_mode_active: false;
    in property <bool> overclock_mode_active: false;

    // Context Menu state
    in-out property <ContextMenuState> context_menu_state: {
        visible: false,
        x: 0px,
        y: 0px,
        task_id: "",
        task_name: "",
        task_url: "",
        can_pause: false,
        can_resume: false,
        is_bt: false,
    };

    // New task form fields
    in-out property <string> new_task_url: "";
    in-out property <string> new_task_dir: "";
    in-out property <string> new_task_filename: "";

    // Callbacks to Rust
    callback select_category(int);
    callback open_new_task_dialog();
    callback close_new_task_dialog();
    callback submit_new_task(string, string, string);
    callback pause_all();
    callback resume_all();
    callback pause_task(string);
    callback resume_task(string);
    callback open_task_explorer(string);
    callback remove_task(string);

    // Phase 2 Callbacks
    callback search_changed(string);
    callback set_sort_field(int);
    callback toggle_sort_asc();
    callback toggle_select_task(string);
    callback select_all();
    callback clear_selection();
    callback batch_pause();
    callback batch_resume();
    callback batch_remove(bool);

    // Phase 3 Callbacks
    callback open_inspector(string);
    callback close_inspector();
    callback set_inspector_tab(int);
    callback open_speed_limit_dialog();
    callback close_speed_limit_dialog();
    callback submit_speed_limit(string, string);

    // Phase 4 Callbacks
    callback open_settings();
    callback close_settings();
    callback set_settings_tab(int);
    callback save_settings(SettingsFormData);
    callback toggle_game_mode();
    callback toggle_overclock_mode();
    callback fetch_trackers_remote(string);

    // Phase 5 Native Pickers & Clipboard Callbacks
    callback pick_torrent_file();
    callback pick_save_folder();
    callback pick_default_folder();
    callback copy_task_url(string);
    callback purge_single_task(string);

    HorizontalLayout {
        // Left Sidebar
        Rectangle {
            width: 220px;
            background: #12151a;
            border-color: #20242d;
            border-width: 1px;

            VerticalLayout {
                padding-top: 18px;
                padding-bottom: 16px;
                padding-left: 16px;
                padding-right: 16px;
                spacing: 16px;

                // App Brand
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("assets/logo.png");
                            width: 32px;
                            height: 32px;
                            image-fit: contain;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        Text {
                            text: "limedl";
                            color: #f3f4f6;
                            font-size: 16px;
                            font-weight: 700;
                        }
                        Text {
                            text: "Native Edition";
                            color: #84cc16;
                            font-size: 10px;
                            font-weight: 600;
                        }
                    }
                }

                // Category List
                VerticalLayout {
                    spacing: 4px;
                    CategoryButton {
                        title: "全部任务";
                        icon_source: @image-url("assets/icons/download-cloud-2-line.svg");
                        count_text: root.count_all;
                        active: root.active_category == 0;
                        clicked => { root.select_category(0); }
                    }
                    CategoryButton {
                        title: "正在下载";
                        icon_source: @image-url("assets/icons/download-line.svg");
                        count_text: root.count_downloading;
                        active: root.active_category == 1;
                        clicked => { root.select_category(1); }
                    }
                    CategoryButton {
                        title: "已暂停";
                        icon_source: @image-url("assets/icons/pause-circle-line.svg");
                        count_text: root.count_paused;
                        active: root.active_category == 2;
                        clicked => { root.select_category(2); }
                    }
                    CategoryButton {
                        title: "已完成";
                        icon_source: @image-url("assets/icons/checkbox-circle-line.svg");
                        count_text: root.count_completed;
                        active: root.active_category == 3;
                        clicked => { root.select_category(3); }
                    }
                    CategoryButton {
                        title: "失败/错误";
                        icon_source: @image-url("assets/icons/error-warning-line.svg");
                        count_text: root.count_failed;
                        active: root.active_category == 4;
                        clicked => { root.select_category(4); }
                    }
                }

                // Spacer
                Rectangle {}

                // Quick Mode Controls (Game Mode & Overclock)
                VerticalLayout {
                    spacing: 6px;

                    Rectangle {
                        background: root.game_mode_active ? #351d0b : #181b22;
                        border-color: root.game_mode_active ? #f59e0b : #252b36;
                        border-width: 1px;
                        border-radius: 6px;
                        height: 34px;

                        TouchArea {
                            clicked => { root.toggle_game_mode(); }
                        }

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            alignment: space-between;
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("assets/icons/gamepad-line.svg");
                                        colorize: root.game_mode_active ? #f59e0b : #8b95a5;
                                        width: 15px;
                                        height: 15px;
                                        image-fit: contain;
                                    }
                                }
                                Text {
                                    text: "游戏模式";
                                    color: root.game_mode_active ? #f59e0b : #9ca3af;
                                    font-size: 12px;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: root.game_mode_active ? "ON" : "OFF";
                                color: root.game_mode_active ? #fcd34d : #5d6778;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle {
                        background: root.overclock_mode_active ? #31132b : #181b22;
                        border-color: root.overclock_mode_active ? #ec4899 : #252b36;
                        border-width: 1px;
                        border-radius: 6px;
                        height: 34px;

                        TouchArea {
                            clicked => { root.toggle_overclock_mode(); }
                        }

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            alignment: space-between;
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("assets/icons/rocket-line.svg");
                                        colorize: root.overclock_mode_active ? #ec4899 : #8b95a5;
                                        width: 15px;
                                        height: 15px;
                                        image-fit: contain;
                                    }
                                }
                                Text {
                                    text: "超频模式";
                                    color: root.overclock_mode_active ? #ec4899 : #9ca3af;
                                    font-size: 12px;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                }
                            }
                            Text {
                                text: root.overclock_mode_active ? "ON" : "OFF";
                                color: root.overclock_mode_active ? #f472b6 : #5d6778;
                                font-size: 11px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Global Speed Widget
                Rectangle {
                    background: #181b22;
                    border-color: #252b36;
                    border-width: 1px;
                    border-radius: 8px;
                    height: 56px;

                    VerticalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        alignment: space-around;
                        Text {
                            text: "实时总下载速率";
                            color: #8b95a5;
                            font-size: 10px;
                            font-weight: 500;
                        }
                        Text {
                            text: root.global_speed_text;
                            color: #84cc16;
                            font-size: 15px;
                            font-weight: 700;
                        }
                    }
                }

                // Settings Button
                Rectangle {
                    background: ta_set.has_hover ? #222731 : #181b22;
                    border-color: #252b36;
                    border-width: 1px;
                    border-radius: 6px;
                    height: 36px;

                    ta_set := TouchArea {
                        clicked => { root.open_settings(); }
                    }

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        alignment: center;
                        spacing: 8px;

                        VerticalLayout {
                            alignment: center;
                            Image {
                                source: @image-url("assets/icons/settings-3-line.svg");
                                colorize: ta_set.has_hover ? #ffffff : #d1d5db;
                                width: 16px;
                                height: 16px;
                                image-fit: contain;
                            }
                        }

                        Text {
                            text: "设置中心";
                            color: ta_set.has_hover ? #ffffff : #d1d5db;
                            font-size: 12px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Right Main Content
        VerticalLayout {
            // Top Toolbar with vertical centering and proper padding
            Rectangle {
                height: 62px;
                background: #111419;
                border-color: #20242d;
                border-width: 1px;

                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    padding-top: 14px;
                    padding-bottom: 14px;
                    alignment: space-between;

                    // Left Title & Search
                    HorizontalLayout {
                        spacing: 16px;
                        alignment: start;

                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: root.active_category == 0 ? "全部任务" : (
                                    root.active_category == 1 ? "正在下载" : (
                                        root.active_category == 2 ? "已暂停" : (
                                            root.active_category == 3 ? "已完成" : "失败/错误"
                                        )
                                    )
                                );
                                color: #f3f4f6;
                                font-size: 16px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            SearchInput {
                                text <=> root.search_query;
                                text_changed(q) => { root.search_changed(q); }
                            }
                        }
                    }

                    // Middle / Right Actions
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;

                        // Sort Buttons
                        HorizontalLayout {
                            spacing: 4px;
                            alignment: center;

                            Text {
                                text: "排序:";
                                color: #6b7280;
                                font-size: 11px;
                                vertical-alignment: center;
                            }

                            SecondaryButton {
                                text: "时间";
                                active: root.sort_field == 0;
                                clicked => { root.set_sort_field(0); }
                            }
                            SecondaryButton {
                                text: "大小";
                                active: root.sort_field == 1;
                                clicked => { root.set_sort_field(1); }
                            }
                            SecondaryButton {
                                text: "速度";
                                active: root.sort_field == 2;
                                clicked => { root.set_sort_field(2); }
                            }
                            SecondaryButton {
                                text: "进度";
                                active: root.sort_field == 3;
                                clicked => { root.set_sort_field(3); }
                            }

                            IconButton {
                                text: root.sort_asc ? "升序" : "降序";
                                icon: @image-url("assets/icons/arrow-up-down-line.svg");
                                text_color: #a3e635;
                                clicked => { root.toggle_sort_asc(); }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 1px;
                                height: 20px;
                                background: #242934;
                            }
                        }

                        SecondaryButton {
                            text: "全部暂停";
                            icon: @image-url("assets/icons/pause-line.svg");
                            clicked => { root.pause_all(); }
                        }

                        SecondaryButton {
                            text: "全部继续";
                            icon: @image-url("assets/icons/play-line.svg");
                            clicked => { root.resume_all(); }
                        }

                        PrimaryButton {
                            text: "新建任务";
                            icon: @image-url("assets/icons/add-line.svg");
                            clicked => { root.open_new_task_dialog(); }
                        }
                    }
                }
            }

            // Task List Area & Floating BatchActionBar
            Rectangle {
                background: #0d0f12;

                if root.tasks.length == 0 : VerticalLayout {
                    alignment: center;
                    spacing: 12px;
                    Text {
                        text: root.search_query != "" ? "未找到匹配的下载任务" : "暂无下载任务";
                        color: #6b7280;
                        font-size: 16px;
                        font-weight: 500;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: root.search_query != "" ? "尝试清除搜索关键词" : "点击右上角「新建任务」添加 HTTP / BT 下载";
                        color: #4b5563;
                        font-size: 13px;
                        horizontal-alignment: center;
                    }
                }

                if root.tasks.length > 0 : ScrollView {
                    viewport-y: 0;
                    VerticalLayout {
                        padding-left: 18px;
                        padding-right: 18px;
                        padding-top: 18px;
                        padding-bottom: root.selected_count > 0 ? 72px : 18px;
                        spacing: 10px;
                        alignment: start;

                        for task[idx] in root.tasks : TaskCard {
                            item: task;
                            toggle_select => { root.toggle_select_task(task.id); }
                            open_inspector => { root.open_inspector(task.id); }
                            pause_task => { root.pause_task(task.id); }
                            resume_task => { root.resume_task(task.id); }
                            open_explorer => { root.open_task_explorer(task.id); }
                            remove_task => { root.remove_task(task.id); }
                            show_menu(mx, my) => {
                                root.context_menu_state = {
                                    visible: true,
                                    x: mx + 240px,
                                    y: my + 86px + (idx * 114px),
                                    task_id: task.id,
                                    task_name: task.file_name,
                                    task_url: task.url,
                                    can_pause: task.can_pause,
                                    can_resume: task.can_resume,
                                    is_bt: task.kind == "bt",
                                };
                            }
                        }
                    }
                }

                // Floating Batch Action Bar
                if root.selected_count > 0 : Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: parent.height - self.height - 16px;
                    width: min(parent.width - 40px, 700px);
                    height: 52px;
                    background: #181b22;
                    border-color: #84cc16;
                    border-width: 1px;
                    border-radius: 10px;
                    drop-shadow-blur: 20px;
                    drop-shadow-color: #000000cc;

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;

                            Text {
                                text: "已选择 " + root.selected_count + " 个任务";
                                color: #84cc16;
                                font-size: 13px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }

                            IconButton {
                                text: "全选";
                                text_color: #9ca3af;
                                clicked => { root.select_all(); }
                            }

                            IconButton {
                                text: "取消选择";
                                text_color: #9ca3af;
                                clicked => { root.clear_selection(); }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;

                            SecondaryButton {
                                text: "批量暂停";
                                icon: @image-url("assets/icons/pause-line.svg");
                                clicked => { root.batch_pause(); }
                            }

                            SecondaryButton {
                                text: "批量继续";
                                icon: @image-url("assets/icons/play-line.svg");
                                clicked => { root.batch_resume(); }
                            }

                            SecondaryButton {
                                text: "移除记录";
                                icon: @image-url("assets/icons/delete-bin-line.svg");
                                clicked => { root.batch_remove(false); }
                            }

                            PrimaryButton {
                                text: "彻底删除";
                                icon: @image-url("assets/icons/delete-bin-6-line.svg");
                                clicked => { root.batch_remove(true); }
                            }
                        }
                    }
                }
            }
        }
    }

    // Context Menu Overlay
    if root.context_menu_state.visible : ContextMenu {
        menu_state: root.context_menu_state;
        close => { root.context_menu_state.visible = false; }
        open_inspector(id) => { root.open_inspector(id); }
        pause_task(id) => { root.pause_task(id); }
        resume_task(id) => { root.resume_task(id); }
        open_explorer(id) => { root.open_task_explorer(id); }
        copy_url(url) => { root.copy_task_url(url); }
        open_speed_limit(id) => { root.open_inspector(id); root.open_speed_limit_dialog(); }
        remove_task(id) => { root.remove_task(id); }
        purge_task(id) => { root.purge_single_task(id); }
    }

    // Dialog: Settings Center
    if root.show_settings : SettingsDialog {
        settings_tab: root.settings_tab;
        settings_form <=> root.settings_form;
        close => { root.close_settings(); }
        set_tab(tab) => { root.set_settings_tab(tab); }
        save(form) => { root.save_settings(form); }
        toggle_game_mode => { root.toggle_game_mode(); }
        toggle_overclock_mode => { root.toggle_overclock_mode(); }
        fetch_trackers(url) => { root.fetch_trackers_remote(url); }
        pick_default_folder => { root.pick_default_folder(); }
    }

    // Dialog: Task Inspector
    if root.show_inspector : TaskInspector {
        inspector_info: root.inspector_info;
        inspector_tab: root.inspector_tab;
        inspector_peers: root.inspector_peers;
        inspector_trackers: root.inspector_trackers;
        inspector_files: root.inspector_files;
        inspector_piece_map: root.inspector_piece_map;
        inspector_pieces_count_text: root.inspector_pieces_count_text;
        close => { root.close_inspector(); }
        set_tab(tab) => { root.set_inspector_tab(tab); }
        open_speed_limit => { root.open_speed_limit_dialog(); }
        open_explorer(id) => { root.open_task_explorer(id); }
    }

    // Dialog: Speed Limit
    if root.show_speed_limit_dialog : SpeedLimitDialog {
        speed_limit_dl_kb <=> root.speed_limit_dl_kb;
        speed_limit_ul_kb <=> root.speed_limit_ul_kb;
        close => { root.close_speed_limit_dialog(); }
        submit(dl, ul) => { root.submit_speed_limit(dl, ul); }
    }

    // Dialog: New Task
    if root.show_new_task_dialog : NewTaskDialog {
        new_task_url <=> root.new_task_url;
        new_task_dir <=> root.new_task_dir;
        new_task_filename <=> root.new_task_filename;
        default_download_dir: root.default_download_dir;
        close => { root.close_new_task_dialog(); }
        submit(url, dir, filename) => { root.submit_new_task(url, dir, filename); }
        pick_torrent_file => { root.pick_torrent_file(); }
        pick_save_folder => { root.pick_save_folder(); }
    }
}
