        border-color: Theme.c2e3542;
                                            border-radius: 8px;
                                            max-width: 520px;
                                            HorizontalLayout { padding: 10px; Text { text: @tr("Full preallocation reduces disk fragmentation but is slower on task creation. irontide only."); wrap: word-wrap; color: Theme.cf3f4f6; font-size: 12px; vertical-alignment: center; } }
                                        }
                                    } }
                                ComboBox {
                                    model: [@tr("None (sparse)"), @tr("Full (zero-fill)")];
