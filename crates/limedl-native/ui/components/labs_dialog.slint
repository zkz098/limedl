import { Theme } from "../theme.slint";
import { CdnCandidateItem, LabsFormData, UrlRewriteRuleItem } from "../types.slint";
import { IconButton, PrimaryButton, SecondaryButton, TabButton, WarningBanner } from "common.slint";
import { LabsCdnTab } from "labs/cdn_tab.slint";
import { LabsRewriteTab } from "labs/rewrite_tab.slint";

export component LabsDialog inherits Rectangle {
    in property <int> labs_tab: 0; // 0: CDN Acceleration, 1: URL Rewrite
    in-out property <LabsFormData> labs_form;
    in property <[CdnCandidateItem]> cdn_candidates: [];
    in property <[UrlRewriteRuleItem]> rewrite_rules: [];

    property <bool> sandbox_expanded: true;
    callback close();
    callback set_tab(int);
    callback save_labs(LabsFormData);

    // CDN Acceleration callbacks
    callback start_cdn_test();
    callback cancel_cdn_test();
    callback clear_cdn_test();
    callback apply_cdn_candidate(string, float);
    callback toggle_cdn_advanced();
    callback apply_manual_cdn_ip(string);

    // URL Rewrite callbacks
    callback import_rewrite_preset(string); // "github" / "huggingface" / "civitai"
    callback add_custom_rule();
    callback remove_rule(int);
    callback toggle_rule_expanded(int);
    callback toggle_rule_enabled(int);
    callback update_rule_name(int, string);
    callback update_rule_match_type(int, string);
    callback update_rule_pattern(int, string);
    callback update_rule_mode(int, string);
    callback toggle_rule_encode(int);
    callback toggle_rule_fallback(int);
    callback add_rule_target(int);
    callback remove_rule_target(int, int);
    callback update_rule_target(int, int, string);
    callback toggle_rule_target(int, int);
    callback test_url_changed(string);

    in property <bool> is_open: false;

    width: 100%;
    height: 100%;
    visible: root.is_open || root.opacity > 0.01;
    opacity: root.is_open ? 1.0 : 0.0;
    animate opacity { duration: 160ms; easing: ease-out; }
    background: Theme.c000000bb;

    TouchArea {
        enabled: root.is_open;
    }

    modal := Rectangle {
        width: min(parent.width - 100px, 1140px);
        height: min(parent.height - 100px, 820px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 + (root.is_open ? 0px : 14px);
        animate y { duration: 160ms; easing: ease-out; }
        background: Theme.c171a20;
        border-color: Theme.c2e3542;
        border-width: 1px;
        border-radius: 12px;
        drop-shadow-blur: 24px;
        drop-shadow-color: Theme.c000000cc;

        VerticalLayout {
            padding: 20px;
            spacing: 12px;

            // Header
            HorizontalLayout {
                alignment: space-between;
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../assets/icons/flask-line.svg");
                            colorize: Theme.ca3e635;
                            width: 18px;
                            height: 18px;
                            image-fit: contain;
                        }
                    }
                    Text {
                        text: @tr("Labs");
                        color: Theme.cf3f4f6;
                        font-size: 16px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
                // Header close button; the id is the handle used by the UI tests
                // (src/ui_tests/) and by element introspection (L2/MCP).
                close_btn := IconButton {
                    icon: @image-url("../assets/icons/close-line.svg");
                    clicked => { root.close(); }
                }
            }

            // Warning Banner
            WarningBanner {
                text: @tr("Labs features are experimental and may affect stability or performance. Use with caution.");
            }

            // Tab Headers
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                TabButton {
                    text: @tr("CDN Optimization");
                    icon: @image-url("../assets/icons/speed-up-line.svg");
                    active: root.labs_tab == 0;
                    clicked => { root.set_tab(0); }
                }
                TabButton {
                    text: @tr("URL Rewrite");
                    icon: @image-url("../assets/icons/links-line.svg");
                    active: root.labs_tab == 1;
                    clicked => { root.set_tab(1); }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.c272d38;
            }

            // Tab Content
            Rectangle {
                background: Theme.c111418;
                border-radius: 8px;
                border-color: Theme.c232832;
                border-width: 1px;

                // ── Tab 0: CDN 网络优选 ──
                if root.labs_tab == 0 : LabsCdnTab {
                    labs_form <=> root.labs_form;
                    cdn_candidates: root.cdn_candidates;
                    start_cdn_test => { root.start_cdn_test(); }
                    cancel_cdn_test => { root.cancel_cdn_test(); }
                    clear_cdn_test => { root.clear_cdn_test(); }
                    apply_cdn_candidate(ip, tp) => { root.apply_cdn_candidate(ip, tp); }
                    toggle_cdn_advanced => { root.toggle_cdn_advanced(); }
                    apply_manual_cdn_ip(ip) => { root.apply_manual_cdn_ip(ip); }
                }

                if root.labs_tab == 1 : LabsRewriteTab {
                    labs_form <=> root.labs_form;
                    rewrite_rules: root.rewrite_rules;
                    import_rewrite_preset(p) => { root.import_rewrite_preset(p); }
                    add_custom_rule => { root.add_custom_rule(); }
                    remove_rule(idx) => { root.remove_rule(idx); }
                    toggle_rule_expanded(idx) => { root.toggle_rule_expanded(idx); }
                    toggle_rule_enabled(idx) => { root.toggle_rule_enabled(idx); }
                    update_rule_name(idx, name) => { root.update_rule_name(idx, name); }
                    update_rule_match_type(idx, mt) => { root.update_rule_match_type(idx, mt); }
                    update_rule_pattern(idx, pat) => { root.update_rule_pattern(idx, pat); }
                    update_rule_mode(idx, mode) => { root.update_rule_mode(idx, mode); }
                    toggle_rule_encode(idx) => { root.toggle_rule_encode(idx); }
                    toggle_rule_fallback(idx) => { root.toggle_rule_fallback(idx); }
                    add_rule_target(idx) => { root.add_rule_target(idx); }
                    remove_rule_target(ridx, tidx) => { root.remove_rule_target(ridx, tidx); }
                    update_rule_target(ridx, tidx, tmpl) => { root.update_rule_target(ridx, tidx, tmpl); }
                    toggle_rule_target(ridx, tidx) => { root.toggle_rule_target(ridx, tidx); }
                    test_url_changed(url) => { root.test_url_changed(url); }
                }
            }

            // Footer
            HorizontalLayout {
                alignment: end;
                spacing: 10px;

                SecondaryButton {
                    text: @tr("Close");
                    clicked => { root.close(); }
                }

                save_labs_btn := PrimaryButton {
                    text: @tr("Save Config");
                    icon: @image-url("../assets/icons/save-line.svg");
                    clicked => { root.save_labs(root.labs_form); }
                }
            }
        }
    }
}