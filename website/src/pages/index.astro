---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import FeaturesGrid from '../components/FeaturesGrid.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import IntegrationShowcase from '../components/IntegrationShowcase.astro';
import CtaSection from '../components/CtaSection.astro';
---

<Layout
  title="limedl - 极速多协议下载利器 | Rust + Slint 原生桌面客户端"
  description="limedl 是一款基于 Rust 与 Slint 原生界面的高性能多协议下载管理器，支持 HTTP AIMD 动态并发、BitTorrent 现代引擎、Cloudflare CDN 探针加速及 Aria2 RPC 兼容。"
  lang="zh-CN"
>
  <Hero lang="zh-CN" />
  <FeaturesGrid lang="zh-CN" />
  <ComparisonTable lang="zh-CN" />
  <IntegrationShowcase lang="zh-CN" />
  <CtaSection lang="zh-CN" />
</Layout>
