import { ScrollView, ComboBox } from "std-widgets.slint";
import { SettingsFormData } from "../types.slint";
import {
    CustomTextInput,
    IconButton,
    PrimaryButton,
    SecondaryButton,
    TabButton,
    ToggleSwitch,
    UnitInput,
} from "common.slint";

export component SettingsDialog inherits Rectangle {
    in property <int> settings_tab: 0;
    in-out property <SettingsFormData> settings_form;

    callback close();
    callback set_tab(int);
    callback save(SettingsFormData);
    callback toggle_game_mode();
    callback toggle_overclock_mode();
    callback fetch_trackers(string);
    callback pick_default_folder();
    callback pick_log_folder();
    callback open_log_folder();

    width: 100%;
    height: 100%;
    background: #000000bb;

    TouchArea {}

    Rectangle {
        width: min(parent.width - 60px, 940px);
        height: min(parent.height - 60px, 700px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: #171a20;
        border-color: #2e3542;
        border-width: 1px;
        border-radius: 12px;
        drop-shadow-blur: 24px;
        drop-shadow-color: #000000cc;

        VerticalLayout {
            padding: 20px;
            spacing: 12px;

            // Header
            HorizontalLayout {
                alignment: space-between;
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../assets/icons/settings-3-line.svg");
                            colorize: #a3e635;
                            width: 18px;
                            height: 18px;
                            image-fit: contain;
                        }
                    }
                    Text {
                        text: @tr("Settings Center");
                        color: #f3f4f6;
                        font-size: 16px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
                IconButton {
                    icon: @image-url("../assets/icons/close-line.svg");
                    clicked => { root.close(); }
                }
            }

            // Tab Headers (Two-tier Common vs Advanced)
            VerticalLayout {
                spacing: 6px;
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    Text { text: @tr("Common:"); color: #6b7280; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                    TabButton {
                        text: @tr("Appearance");
                        icon: @image-url("../assets/icons/palette-line.svg");
                        active: root.settings_tab == 0;
                        clicked => { root.set_tab(0); }
                    }
                    TabButton {
                        text: @tr("Download");
                        icon: @image-url("../assets/icons/download-line.svg");
                        active: root.settings_tab == 1;
                        clicked => { root.set_tab(1); }
                    }
                    TabButton {
                        text: @tr("Proxy");
                        icon: @image-url("../assets/icons/global-line.svg");
                        active: root.settings_tab == 2;
                        clicked => { root.set_tab(2); }
                    }
                    TabButton {
                        text: @tr("About");
                        icon: @image-url("../assets/icons/information-line.svg");
                        active: root.settings_tab == 8;
                        clicked => { root.set_tab(8); }
                    }

                    Rectangle { width: 1px; height: 18px; background: #2b313d; }

                    Text { text: @tr("Advanced:"); color: #6b7280; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                    TabButton {
                        text: @tr("Scheduler");
                        icon: @image-url("../assets/icons/dashboard-3-line.svg");
                        active: root.settings_tab == 3;
                        clicked => { root.set_tab(3); }
                    }
                    TabButton {
                        text: @tr("BT Network");
                        icon: @image-url("../assets/icons/radar-line.svg");
                        active: root.settings_tab == 4;
                        clicked => { root.set_tab(4); }
                    }
                    TabButton {
                        text: @tr("IO & Storage");
                        icon: @image-url("../assets/icons/hard-drive-2-line.svg");
                        active: root.settings_tab == 5;
                        clicked => { root.set_tab(5); }
                    }
                    TabButton {
                        text: @tr("Logging");
                        icon: @image-url("../assets/icons/file-list-line.svg");
                        active: root.settings_tab == 6;
                        clicked => { root.set_tab(6); }
                    }
                    TabButton {
                        text: @tr("Aria2");
                        icon: @image-url("../assets/icons/terminal-box-line.svg");
                        active: root.settings_tab == 7;
                        clicked => { root.set_tab(7); }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: #272d38;
            }

            // Tab Content — unified container
            Rectangle {
                background: #111418;
                border-radius: 8px;
                border-color: #232832;
                border-width: 1px;

                // ── Tab 0: 外观 / 启动 ──
                if root.settings_tab == 0 : ScrollView {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 14px;

                        Text { text: @tr("Appearance & System Integration"); color: #a3e635; font-size: 13px; font-weight: 700; }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Theme Mode (system/light/dark):"); color: #9ca3af; font-size: 12px; }
                                ComboBox {
                                    model: ["system", "light", "dark"];
                                    current-value <=> root.settings_form.appearance_color_mode;
                                    height: 36px;
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Theme Color (amber/sky/lime):"); color: #9ca3af; font-size: 12px; }
                                ComboBox {
                                    model: ["amber", "sky", "lime"];
                                    current-value <=> root.settings_form.appearance_theme_color;
                                    height: 36px;
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Background Opacity Preset (default/acrylic/frosted):"); color: #9ca3af; font-size: 12px; }
                                ComboBox {
                                    model: ["default", "acrylic", "frosted"];
                                    current-value <=> root.settings_form.appearance_background_opacity;
                                    height: 36px;
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("UI Language (zh-CN/en-US):"); color: #9ca3af; font-size: 12px; }
                                ComboBox {
                                    model: ["zh-CN", "en-US"];
                                    current-value <=> root.settings_form.appearance_language;
                                    height: 36px;
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Close Behavior (minimizeToTray/exit):"); color: #9ca3af; font-size: 12px; }
                                ComboBox {
                                    model: ["minimizeToTray", "exit"];
                                    current-value <=> root.settings_form.appearance_close_behavior;
                                    height: 36px;
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Max In-Memory Records (10-10000):"); color: #9ca3af; font-size: 12px; }
                                UnitInput {
                                    text <=> root.settings_form.max_in_memory_downloads;
                                    placeholder: "200";
                                    unit_text: @tr("items");
                                }
                            }
                        }

                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: @tr("Show Detail Panel"); color: #f3f4f6; font-size: 13px; font-weight: 600; }
                                Text { text: @tr("Show download inspector and piece heatmap on the right"); color: #6b7280; font-size: 11px; }
                            }
                            ToggleSwitch {
                                checked: root.settings_form.appearance_show_detail_info;
                                toggled => { root.settings_form.appearance_show_detail_info = !root.settings_form.appearance_show_detail_info; }
                            }
                        }

                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: @tr("Launch on Startup"); color: #f3f4f6; font-size: 13px; font-weight: 600; }
                                Text { text: @tr("Automatically launch limedl-native upon user login"); color: #6b7280; font-size: 11px; }
                            }
                            ToggleSwitch {
                                checked: root.settings_form.autostart;
                                toggled => { root.settings_form.autostart = !root.settings_form.autostart; }
                            }
                        }

                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: @tr("System Notifications"); color: #f3f4f6; font-size: 13px; font-weight: 600; }
                                Text { text: @tr("Show desktop notification on task completion/failure"); color: #6b7280; font-size: 11px; }
                            }
                            ToggleSwitch {
                                checked: root.settings_form.notifications_enabled;
                                toggled => { root.settings_form.notifications_enabled = !root.settings_form.notifications_enabled; }
                            }
                        }

                        Rectangle { height: 1px; background: #1a1e26; }

                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("Double-click Completed Task (none/open_file/open_in_explorer/open_download_dir):"); color: #9ca3af; font-size: 12px; }
                            ComboBox {
                                    model: ["none", "open_file", "open_in_explorer", "open_download_dir"];
                                    current-value <=> root.settings_form.double_click_completed;
                                    height: 36px;
                                }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("Double-click Uncompleted Task (none/toggle_pause_resume):"); color: #9ca3af; font-size: 12px; }
                            ComboBox {
                                    model: ["none", "toggle_pause_resume"];
                                    current-value <=> root.settings_form.double_click_uncompleted;
                                    height: 36px;
                                }
                        }
                    }
                }

                // ── Tab 1: 下载 ──
                if root.settings_tab == 1 : ScrollView {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 14px;

                        Text { text: @tr("Download Defaults"); color: #a3e635; font-size: 13px; font-weight: 700; }

                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("Default Download Folder:"); color: #9ca3af; font-size: 12px; }
                            HorizontalLayout {
                                spacing: 8px;
                                CustomTextInput {
                                    text <=> root.settings_form.default_download_dir;
                                    placeholder: "/downloads";
                                }
                                SecondaryButton {
                                    text: @tr("Browse...");
                                    icon: @image-url("../assets/icons/folder-open-line.svg");
                                    clicked => { root.pick_default_folder(); }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Max Concurrent Tasks (traditional):"); color: #9ca3af; font-size: 12px; }
                                UnitInput {
                                    text <=> root.settings_form.max_parallel_tasks;
                                    placeholder: "3";
                                    unit_text: @tr("tasks");
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Max Retries (0-100):"); color: #9ca3af; font-size: 12px; }
                                UnitInput {
                                    text <=> root.settings_form.download_max_retries;
                                    placeholder: "5";
                                    unit_text: @tr("times");
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Default Checksum (blake3/sha256/xxh3_128/none/sha1):"); color: #9ca3af; font-size: 12px; }
                                ComboBox {
                                    model: ["blake3", "sha256", "xxh3_128", "none", "sha1"];
                                    current-value <=> root.settings_form.download_checksum;
                                    height: 36px;
                                }
                            }
                            VerticalLayout {
                                alignment: space-between;
                                spacing: 2px;
                                Text { text: @tr("Auto-detect SHA-256"); color: #f3f4f6; font-size: 13px; font-weight: 600; }
                                ToggleSwitch {
                                    checked: root.settings_form.download_auto_detect_sha256;
                                    toggled => { root.settings_form.download_auto_detect_sha256 = !root.settings_form.download_auto_detect_sha256; }
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("Default User-Agent (empty for Chrome 124):"); color: #9ca3af; font-size: 12px; }
                            CustomTextInput {
                                text <=> root.settings_form.download_user_agent;
                                placeholder: "Mozilla/5.0 ... Chrome/124.0.0.0";
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("Global Bandwidth Limit (0 for unlimited):"); color: #9ca3af; font-size: 12px; }
                            UnitInput {
                                text <=> root.settings_form.global_speed_limit_kb;
                                placeholder: "0";
                                unit_text: "KB/s";
                            }
                        }
                    }
                }

                // ── Tab 2: 代理 ──
                if root.settings_tab == 2 : ScrollView {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 14px;

                        Text { text: @tr("Proxy Settings"); color: #a3e635; font-size: 13px; font-weight: 700; }

                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("Proxy Mode (disabled/system/manual):"); color: #9ca3af; font-size: 12px; }
                            ComboBox {
                                    model: ["disabled", "system", "manual"];
                                    current-value <=> root.settings_form.proxy_mode;
                                    height: 36px;
                                }
                            Text { text: @tr("system follows OS proxy; manual requires proxy URL below"); color: #6b7280; font-size: 11px; }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("Manual Proxy URL:"); color: #9ca3af; font-size: 12px; }
                            CustomTextInput {
                                text <=> root.settings_form.proxy_manual_url;
                                placeholder: "http://127.0.0.1:7890";
                            }
                        }
                    }
                }

                // ── Tab 3: 调度 ──
                if root.settings_tab == 3 : ScrollView {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 14px;

                        Text { text: @tr("Scheduler & Performance"); color: #a3e635; font-size: 13px; font-weight: 700; }

                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("Allocation Mode (automatic/traditional):"); color: #9ca3af; font-size: 12px; }
                            ComboBox {
                                    model: ["automatic", "traditional"];
                                    current-value <=> root.settings_form.scheduler_mode;
                                    height: 36px;
                                }
                            Text { text: @tr("automatic uses adaptive thread pool; traditional uses fixed concurrency"); color: #6b7280; font-size: 11px; }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Auto - Max Parallel Threads (1-128):"); color: #9ca3af; font-size: 12px; }
                                UnitInput {
                                    text <=> root.settings_form.scheduler_max_parallel_threads;
                                    placeholder: "16";
                                    unit_text: @tr("threads");
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Max Threads per Task (1-64):"); color: #9ca3af; font-size: 12px; }
                                UnitInput {
                                    text <=> root.settings_form.scheduler_max_threads_per_task;
                                    placeholder: "8";
                                    unit_text: @tr("threads");
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("Min Threads per Task (0-64):"); color: #9ca3af; font-size: 12px; }
                            UnitInput {
                                text <=> root.settings_form.scheduler_min_threads_per_task;
                                placeholder: "0";
                                unit_text: @tr("threads");
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Adaptive Profile (conservative/balanced/aggressive):"); color: #9ca3af; font-size: 12px; }
                                ComboBox {
                                    model: ["conservative", "balanced", "aggressive"];
                                    current-value <=> root.settings_form.scheduler_adaptive_profile;
                                    height: 36px;
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Chunk Strategy (adaptive/fixed):"); color: #9ca3af; font-size: 12px; }
                                ComboBox {
                                    model: ["adaptive", "fixed"];
                                    current-value <=> root.settings_form.scheduler_chunk_strategy;
                                    height: 36px;
                                }
                            }
                        }

                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: @tr("Tail Sprint"); color: #f3f4f6; font-size: 13px; font-weight: 600; }
                                Text { text: @tr("Parallelize tail chunks to minimize finishing latency"); color: #6b7280; font-size: 11px; }
                            }
                            ToggleSwitch {
                                checked: root.settings_form.scheduler_tail_sprint;
                                toggled => { root.settings_form.scheduler_tail_sprint = !root.settings_form.scheduler_tail_sprint; }
                            }
                        }

                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: @tr("Connection Warmup"); color: #f3f4f6; font-size: 13px; font-weight: 600; }
                                Text { text: @tr("Pre-establish multiple connections during handshake for faster warmup"); color: #6b7280; font-size: 11px; }
                            }
                            ToggleSwitch {
                                checked: root.settings_form.scheduler_connection_warmup;
                                toggled => { root.settings_form.scheduler_connection_warmup = !root.settings_form.scheduler_connection_warmup; }
                            }
                        }
                    }
                }

                // ── Tab 4: BT 网络 ──
                if root.settings_tab == 4 : ScrollView {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;

                        Text { text: @tr("BitTorrent Network"); color: #a3e635; font-size: 13px; font-weight: 700; }

                        // 基础
                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: @tr("Enable DHT"); color: #f3f4f6; font-size: 13px; font-weight: 600; }
                                Text { text: @tr("Discover peers via DHT when no trackers are available"); color: #6b7280; font-size: 11px; }
                            }
                            ToggleSwitch {
                                checked: root.settings_form.dht_enabled;
                                toggled => { root.settings_form.dht_enabled = !root.settings_form.dht_enabled; }
                            }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Listen Port (empty for random):"); color: #9ca3af; font-size: 12px; }
                                UnitInput {
                                    text <=> root.settings_form.listen_port;
                                    placeholder: @tr("Random");
                                    unit_text: @tr("port");
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Max Peers per Torrent:"); color: #9ca3af; font-size: 12px; }
                                UnitInput {
                                    text <=> root.settings_form.max_bt_connections;
                                    placeholder: "128";
                                    unit_text: @tr("peers");
                                }
                            }
                        }

                        Rectangle { height: 1px; background: #1a1e26; }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                alignment: space-between;
                                spacing: 2px;
                                Text { text: "UPnP"; color: #f3f4f6; font-size: 12px; font-weight: 600; }
                                ToggleSwitch {
                                    checked: root.settings_form.bt_upnp_enabled;
                                    toggled => { root.settings_form.bt_upnp_enabled = !root.settings_form.bt_upnp_enabled; }
                                }
                            }
                            VerticalLayout {
                                alignment: space-between;
                                spacing: 2px;
                                Text { text: "NAT-PMP"; color: #f3f4f6; font-size: 12px; font-weight: 600; }
                                ToggleSwitch {
                                    checked: root.settings_form.bt_natpmp_enabled;
                                    toggled => { root.settings_form.bt_natpmp_enabled = !root.settings_form.bt_natpmp_enabled; }
                                }
                            }
                            VerticalLayout {
                                alignment: space-between;
                                spacing: 2px;
                                Text { text: "IPv6"; color: #f3f4f6; font-size: 12px; font-weight: 600; }
                                ToggleSwitch {
                                    checked: root.settings_form.bt_ipv6_enabled;
                                    toggled => { root.settings_form.bt_ipv6_enabled = !root.settings_form.bt_ipv6_enabled; }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                alignment: space-between;
                                spacing: 2px;
                                Text { text: "PEX"; color: #f3f4f6; font-size: 12px; font-weight: 600; }
                                ToggleSwitch {
                                    checked: root.settings_form.bt_pex_enabled;
                                    toggled => { root.settings_form.bt_pex_enabled = !root.settings_form.bt_pex_enabled; }
                                }
                            }
                            VerticalLayout {
                                alignment: space-between;
                                spacing: 2px;
                                Text { text: "LSD"; color: #f3f4f6; font-size: 12px; font-weight: 600; }
                                ToggleSwitch {
                                    checked: root.settings_form.bt_lsd_enabled;
                                    toggled => { root.settings_form.bt_lsd_enabled = !root.settings_form.bt_lsd_enabled; }
                                }
                            }
                            VerticalLayout {
                                alignment: space-between;
                                spacing: 2px;
                                Text { text: "uTP"; color: #f3f4f6; font-size: 12px; font-weight: 600; }
                                ToggleSwitch {
                                    checked: root.settings_form.bt_utp_enabled;
                                    toggled => { root.settings_form.bt_utp_enabled = !root.settings_form.bt_utp_enabled; }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Encryption Mode (enabled/disabled/forced):"); color: #9ca3af; font-size: 12px; }
                                ComboBox {
                                    model: ["enabled", "disabled", "forced"];
                                    current-value <=> root.settings_form.bt_encryption_mode;
                                    height: 36px;
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Pre-allocation Mode (none/full):"); color: #9ca3af; font-size: 12px; }
                                ComboBox {
                                    model: ["none", "full"];
                                    current-value <=> root.settings_form.bt_preallocate_mode;
                                    height: 36px;
                                }
                            }
                        }

                        Rectangle { height: 1px; background: #1a1e26; }

                        Text { text: @tr("Queuing & Rate Limits"); color: #9ca3af; font-size: 12px; font-weight: 600; }
                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Max Active Downloads:"); color: #9ca3af; font-size: 12px; }
                                UnitInput { text <=> root.settings_form.bt_max_downloads; placeholder: "3"; unit_text: @tr("tasks"); }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Max Active Seeds:"); color: #9ca3af; font-size: 12px; }
                                UnitInput { text <=> root.settings_form.bt_max_seeds; placeholder: "5"; unit_text: @tr("tasks"); }
                            }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Max Torrents:"); color: #9ca3af; font-size: 12px; }
                                UnitInput { text <=> root.settings_form.bt_max_torrents; placeholder: "100"; unit_text: @tr("tasks"); }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Active Limit:"); color: #9ca3af; font-size: 12px; }
                                UnitInput { text <=> root.settings_form.bt_active_limit; placeholder: "500"; unit_text: @tr("tasks"); }
                            }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Global Download Rate Limit:"); color: #9ca3af; font-size: 12px; }
                                UnitInput { text <=> root.settings_form.bt_global_download_rate_limit_kb; placeholder: "0"; unit_text: "KB/s"; }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Global Upload Rate Limit:"); color: #9ca3af; font-size: 12px; }
                                UnitInput { text <=> root.settings_form.bt_global_upload_rate_limit_kb; placeholder: "0"; unit_text: "KB/s"; }
                            }
                        }

                        Rectangle { height: 1px; background: #1a1e26; }

                        Text { text: @tr("Seeding & Completion"); color: #9ca3af; font-size: 12px; font-weight: 600; }
                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: @tr("Pause Seeding upon Reaching Limit"); color: #f3f4f6; font-size: 13px; font-weight: 600; }
                                Text { text: @tr("Automatically pause seeding once upload limit or ratio target is reached"); color: #6b7280; font-size: 11px; }
                            }
                            ToggleSwitch {
                                checked: root.settings_form.bt_pause_upload_when_limit;
                                toggled => { root.settings_form.bt_pause_upload_when_limit = !root.settings_form.bt_pause_upload_when_limit; }
                            }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Seeding Upload Limit:"); color: #9ca3af; font-size: 12px; }
                                UnitInput { text <=> root.settings_form.bt_upload_limit_kb; placeholder: "0"; unit_text: "KB"; }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Share Ratio Limit (0 for unlimited):"); color: #9ca3af; font-size: 12px; }
                                CustomTextInput { text <=> root.settings_form.bt_upload_ratio_limit; placeholder: "0"; }
                            }
                        }

                        Rectangle { height: 1px; background: #1a1e26; }

                        Text { text: @tr("Anti-Leech & Peer Banning"); color: #9ca3af; font-size: 12px; font-weight: 600; }
                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: @tr("Enable Anti-Leech Detection"); color: #f3f4f6; font-size: 13px; font-weight: 600; }
                                Text { text: @tr("Detect peers that download without uploading"); color: #6b7280; font-size: 11px; }
                            }
                            ToggleSwitch {
                                checked: root.settings_form.bt_anti_leech_enabled;
                                toggled => { root.settings_form.bt_anti_leech_enabled = !root.settings_form.bt_anti_leech_enabled; }
                            }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Action (ban/limit_slots):"); color: #9ca3af; font-size: 12px; }
                                ComboBox {
                                    model: ["ban", "limit_slots"];
                                    current-value <=> root.settings_form.bt_anti_leech_action;
                                    height: 36px;
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Grace Period:"); color: #9ca3af; font-size: 12px; }
                                UnitInput { text <=> root.settings_form.bt_anti_leech_grace_secs; placeholder: "300"; unit_text: @tr("secs"); }
                            }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Share Ratio Threshold (0-1):"); color: #9ca3af; font-size: 12px; }
                                CustomTextInput { text <=> root.settings_form.bt_anti_leech_ratio; placeholder: "0.1"; }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Ban Duration:"); color: #9ca3af; font-size: 12px; }
                                UnitInput { text <=> root.settings_form.bt_anti_leech_ban_secs; placeholder: "3600"; unit_text: @tr("secs"); }
                            }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("Max Upload Slots in Limit Mode (1-64):"); color: #9ca3af; font-size: 12px; }
                            UnitInput { text <=> root.settings_form.bt_anti_leech_max_upload_slots; placeholder: "4"; unit_text: @tr("slots"); }
                        }
                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: @tr("Enable IP Blocklist"); color: #f3f4f6; font-size: 13px; font-weight: 600; }
                                Text { text: @tr("Load local blocklist filter file"); color: #6b7280; font-size: 11px; }
                            }
                            ToggleSwitch {
                                checked: root.settings_form.bt_blocklist_enabled;
                                toggled => { root.settings_form.bt_blocklist_enabled = !root.settings_form.bt_blocklist_enabled; }
                            }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("Blocklist Path:"); color: #9ca3af; font-size: 12px; }
                            CustomTextInput { text <=> root.settings_form.bt_blocklist_path; placeholder: "C:/path/to/blocklist.dat"; }
                        }

                        Rectangle { height: 1px; background: #1a1e26; }

                        Text { text: @tr("Engine Tuning"); color: #9ca3af; font-size: 12px; font-weight: 600; }
                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Seed Choking (fastest_upload/round_robin/anti_leech):"); color: #9ca3af; font-size: 12px; }
                                ComboBox {
                                    model: ["fastest_upload", "round_robin", "anti_leech"];
                                    current-value <=> root.settings_form.bt_seed_choking_algorithm;
                                    height: 36px;
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Choking Algorithm (fixed_slots/rate_based):"); color: #9ca3af; font-size: 12px; }
                                ComboBox {
                                    model: ["fixed_slots", "rate_based"];
                                    current-value <=> root.settings_form.bt_choking_algorithm;
                                    height: 36px;
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Max Upload Slots per Torrent:"); color: #9ca3af; font-size: 12px; }
                                UnitInput { text <=> root.settings_form.bt_max_upload_slots_per_torrent; placeholder: "4"; unit_text: @tr("slots"); }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Smart Ban Threshold (1-100):"); color: #9ca3af; font-size: 12px; }
                                UnitInput { text <=> root.settings_form.bt_smart_ban_max_failures; placeholder: "3"; unit_text: @tr("failures"); }
                            }
                        }
                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: @tr("Smart Ban Parole"); color: #f3f4f6; font-size: 13px; font-weight: 600; }
                                Text { text: @tr("Isolate suspicious peers before permanent ban to prevent false positives"); color: #6b7280; font-size: 11px; }
                            }
                            ToggleSwitch {
                                checked: root.settings_form.bt_smart_ban_parole;
                                toggled => { root.settings_form.bt_smart_ban_parole = !root.settings_form.bt_smart_ban_parole; }
                            }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Ban Duration after Eviction:"); color: #9ca3af; font-size: 12px; }
                                UnitInput { text <=> root.settings_form.bt_eviction_ban_duration_secs; placeholder: "600"; unit_text: @tr("secs"); }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("No Data Contribution Timeout:"); color: #9ca3af; font-size: 12px; }
                                UnitInput { text <=> root.settings_form.bt_data_contribution_timeout_secs; placeholder: "60"; unit_text: @tr("secs"); }
                            }
                        }

                        Rectangle { height: 1px; background: #1a1e26; }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                alignment: space-between;
                                spacing: 2px;
                                Text { text: "Fast Extension"; color: #f3f4f6; font-size: 12px; font-weight: 600; }
                                ToggleSwitch {
                                    checked: root.settings_form.bt_enable_fast_extension;
                                    toggled => { root.settings_form.bt_enable_fast_extension = !root.settings_form.bt_enable_fast_extension; }
                                }
                            }
                            VerticalLayout {
                                alignment: space-between;
                                spacing: 2px;
                                Text { text: "Holepunch"; color: #f3f4f6; font-size: 12px; font-weight: 600; }
                                ToggleSwitch {
                                    checked: root.settings_form.bt_enable_holepunch;
                                    toggled => { root.settings_form.bt_enable_holepunch = !root.settings_form.bt_enable_holepunch; }
                                }
                            }
                            VerticalLayout {
                                alignment: space-between;
                                spacing: 2px;
                                Text { text: "WebSeed"; color: #f3f4f6; font-size: 12px; font-weight: 600; }
                                ToggleSwitch {
                                    checked: root.settings_form.bt_enable_web_seed;
                                    toggled => { root.settings_form.bt_enable_web_seed = !root.settings_form.bt_enable_web_seed; }
                                }
                            }
                            VerticalLayout {
                                alignment: space-between;
                                spacing: 2px;
                                Text { text: "SuperSeed"; color: #f3f4f6; font-size: 12px; font-weight: 600; }
                                ToggleSwitch {
                                    checked: root.settings_form.bt_enable_super_seeding;
                                    toggled => { root.settings_form.bt_enable_super_seeding = !root.settings_form.bt_enable_super_seeding; }
                                }
                            }
                        }

                        Rectangle { height: 1px; background: #1a1e26; }

                        VerticalLayout {
                            spacing: 6px;
                            Text { text: @tr("Tracker Subscription URL:"); color: #9ca3af; font-size: 12px; }
                            HorizontalLayout {
                                spacing: 8px;
                                CustomTextInput {
                                    text <=> root.settings_form.tracker_url;
                                    placeholder: "https://cf.trackerslist.com/best.txt";
                                }
                                SecondaryButton {
                                    text: @tr("Sync Now");
                                    icon: @image-url("../assets/icons/refresh-line.svg");
                                    clicked => { root.fetch_trackers(root.settings_form.tracker_url); }
                                }
                            }
                            Text { text: @tr("Synced trackers update bt.trackerList. Click Save to apply."); color: #6b7280; font-size: 11px; }
                        }
                    }
                }

                // ── Tab 5: IO 实验室 ──
                if root.settings_tab == 5 : ScrollView {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 14px;

                        Text { text: @tr("IO Baseline & Performance Modes"); color: #a3e635; font-size: 13px; font-weight: 700; }

                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: @tr("Game Mode"); color: #f59e0b; font-size: 13px; font-weight: 600; }
                                Text { text: @tr("Reduces buffer and IO frequency to minimize latency interference with 3D games"); color: #6b7280; font-size: 11px; }
                            }
                            ToggleSwitch {
                                checked: root.settings_form.game_mode;
                                toggled => { root.toggle_game_mode(); }
                            }
                        }

                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: @tr("Overclock Mode"); color: #ec4899; font-size: 13px; font-weight: 600; }
                                Text { text: @tr("Aggressive multi-threading to push bandwidth to the hardware limit"); color: #6b7280; font-size: 11px; }
                            }
                            ToggleSwitch {
                                checked: root.settings_form.overclock_mode;
                                toggled => { root.toggle_overclock_mode(); }
                            }
                        }

                        Rectangle { height: 1px; background: #1a1e26; }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Buffer Pool Limit:"); color: #9ca3af; font-size: 12px; }
                                UnitInput { text <=> root.settings_form.io_buffer_limit_mb; placeholder: "1024"; unit_text: "MB"; }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Game Mode Buffer:"); color: #9ca3af; font-size: 12px; }
                                UnitInput { text <=> root.settings_form.io_game_mode_buffer_mb; placeholder: "128"; unit_text: "MB"; }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("HDD Max Parallel:"); color: #9ca3af; font-size: 12px; }
                                UnitInput { text <=> root.settings_form.io_max_parallel_hdd; placeholder: "4"; unit_text: @tr("tasks"); }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Game Mode Max Parallel:"); color: #9ca3af; font-size: 12px; }
                                UnitInput { text <=> root.settings_form.io_game_mode_max_parallel; placeholder: "1"; unit_text: @tr("tasks"); }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                alignment: space-between;
                                spacing: 2px;
                                Text { text: @tr("HDD Double-Buffer Optimization"); color: #f3f4f6; font-size: 12px; font-weight: 600; }
                                ToggleSwitch {
                                    checked: root.settings_form.io_hdd_buffer_enabled;
                                    toggled => { root.settings_form.io_hdd_buffer_enabled = !root.settings_form.io_hdd_buffer_enabled; }
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("SSD Write Combining (0=auto):"); color: #9ca3af; font-size: 12px; }
                                UnitInput { text <=> root.settings_form.io_ssd_write_combine_mb; placeholder: "0"; unit_text: "MB"; }
                            }
                        }

                        Rectangle { height: 1px; background: #1a1e26; }

                        VerticalLayout {
                            spacing: 4px;
                            HorizontalLayout {
                                spacing: 6px;
                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("../assets/icons/hard-drive-2-line.svg");
                                        colorize: #38bdf8;
                                        width: 15px;
                                        height: 15px;
                                        image-fit: contain;
                                    }
                                }
                                Text { text: @tr("Disk Type Detection (SSD / HDD):"); color: #9ca3af; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                            }
                            Text { text: root.settings_form.disk_type_text; color: #38bdf8; font-size: 12px; }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            HorizontalLayout {
                                spacing: 6px;
                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("../assets/icons/cpu-line.svg");
                                        colorize: #a3e635;
                                        width: 15px;
                                        height: 15px;
                                        image-fit: contain;
                                    }
                                }
                                Text { text: @tr("Buffer Pool Status:"); color: #9ca3af; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                            }
                            Text { text: root.settings_form.io_status_text; color: #a3e635; font-size: 12px; }
                        }
                    }
                }

                // ── Tab 6: 日志 ──
                if root.settings_tab == 6 : ScrollView {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 14px;

                        Text { text: @tr("Logging"); color: #a3e635; font-size: 13px; font-weight: 700; }

                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: @tr("Enable File Logging"); color: #f3f4f6; font-size: 13px; font-weight: 600; }
                                Text { text: @tr("Write logs to the specified filePath"); color: #6b7280; font-size: 11px; }
                            }
                            ToggleSwitch {
                                checked: root.settings_form.logging_enabled;
                                toggled => { root.settings_form.logging_enabled = !root.settings_form.logging_enabled; }
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("Log Level (trace/debug/info/warn/error):"); color: #9ca3af; font-size: 12px; }
                            ComboBox {
                                    model: ["trace", "debug", "info", "warn", "error"];
                                    current-value <=> root.settings_form.logging_level;
                                    height: 36px;
                                }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("Log File Path:"); color: #9ca3af; font-size: 12px; }
                            HorizontalLayout {
                                spacing: 8px;
                                CustomTextInput {
                                    text <=> root.settings_form.logging_file_path;
                                    placeholder: @tr("Leave empty for system default, e.g. D:\\limedl\\logs\\limedl.log");
                                }
                                SecondaryButton {
                                    text: @tr("Select Path...");
                                    icon: @image-url("../assets/icons/folder-open-line.svg");
                                    clicked => { root.pick_log_folder(); }
                                }
                                SecondaryButton {
                                    text: @tr("Open Folder");
                                    icon: @image-url("../assets/icons/folder-open-line.svg");
                                    clicked => { root.open_log_folder(); }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Retention Files (empty for unlimited):"); color: #9ca3af; font-size: 12px; }
                                UnitInput { text <=> root.settings_form.logging_retention_count; placeholder: @tr("Unlimited"); unit_text: @tr("files"); }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Retention Days (empty for unlimited):"); color: #9ca3af; font-size: 12px; }
                                UnitInput { text <=> root.settings_form.logging_retention_days; placeholder: @tr("Unlimited"); unit_text: @tr("days"); }
                            }
                        }
                    }
                }

                // ── Tab 7: Aria2 RPC ──
                if root.settings_tab == 7 : ScrollView {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 14px;

                        Text { text: @tr("Aria2 RPC Service"); color: #a3e635; font-size: 13px; font-weight: 700; }

                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: @tr("Enable Aria2 RPC Service"); color: #f3f4f6; font-size: 13px; font-weight: 600; }
                                Text { text: @tr("Allows browser extensions (such as Aria2 Explorer) to intercept downloads"); color: #6b7280; font-size: 11px; }
                            }
                            ToggleSwitch {
                                checked: root.settings_form.aria2_enabled;
                                toggled => { root.settings_form.aria2_enabled = !root.settings_form.aria2_enabled; }
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("RPC Port (1-65535):"); color: #9ca3af; font-size: 12px; }
                            UnitInput {
                                text <=> root.settings_form.aria2_port;
                                placeholder: "6800";
                                unit_text: @tr("port");
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("RPC Secret (empty for no authentication):"); color: #9ca3af; font-size: 12px; }
                            CustomTextInput {
                                text <=> root.settings_form.aria2_secret;
                                placeholder: @tr("Leave empty for no secret");
                            }
                        }

                        Rectangle { height: 1px; background: #1a1e26; }
                        Text { text: @tr("Tip: Install Aria2 Explorer from Chrome/Edge/Firefox webstore and set host to http://127.0.0.1:{{port}} with your secret."); color: #6b7280; font-size: 11px; wrap: word-wrap; }
                    }
                }

                // ── Tab 8: 关于 ──
                if root.settings_tab == 8 : ScrollView {
                    VerticalLayout {
                        padding: 18px;
                        spacing: 16px;

                        HorizontalLayout {
                            spacing: 16px;
                            alignment: start;
                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("../assets/logo.png");
                                    width: 48px;
                                    height: 48px;
                                    image-fit: contain;
                                }
                            }
                            VerticalLayout {
                                spacing: 3px;
                                Text { text: "limedl - Native Edition"; color: #f3f4f6; font-size: 16px; font-weight: 700; }
                                Text { text: @tr("Lightweight high-performance asynchronous multi-protocol download engine"); color: #84cc16; font-size: 12px; font-weight: 600; }
                                Text { text: @tr("Cross-platform unified engine supporting HTTP/HTTPS adaptive multi-threading and full BitTorrent protocols."); color: #9ca3af; font-size: 11px; }
                            }
                        }

                        Rectangle { height: 1px; background: #1f242e; }

                        Rectangle {
                            background: #14171d;
                            border-color: #232832;
                            border-width: 1px;
                            border-radius: 8px;

                            VerticalLayout {
                                padding: 14px;
                                spacing: 10px;
                                Text { text: @tr("System & Environment Info"); color: #a3e635; font-size: 12px; font-weight: 700; }

                                HorizontalLayout {
                                    Text { width: 140px; text: @tr("Client Version:"); color: #6b7280; font-size: 12px; }
                                    Text { text: root.settings_form.app_version; color: #f3f4f6; font-size: 12px; font-weight: 600; font-family: "Consolas, monospace"; }
                                }
                                HorizontalLayout {
                                    Text { width: 140px; text: @tr("Engine Core:"); color: #6b7280; font-size: 12px; }
                                    Text { text: root.settings_form.engine_version; color: #f3f4f6; font-size: 12px; font-weight: 600; font-family: "Consolas, monospace"; }
                                }
                                HorizontalLayout {
                                    Text { width: 140px; text: @tr("Target Arch & Graphics:"); color: #6b7280; font-size: 12px; }
                                    Text { text: root.settings_form.arch_info; color: #38bdf8; font-size: 12px; font-weight: 600; font-family: "Consolas, monospace"; }
                                }
                                HorizontalLayout {
                                    Text { width: 140px; text: @tr("Core Technology Stack:"); color: #6b7280; font-size: 12px; }
                                    Text { text: @tr("Rust Edition 2024 / Slint Native UI / Skia HW Acceleration / Tokio Async Runtime"); color: #9ca3af; font-size: 12px; }
                                }
                                HorizontalLayout {
                                    Text { width: 140px; text: @tr("License:"); color: #6b7280; font-size: 12px; }
                                    Text { text: "MIT / Apache-2.0 Dual License"; color: #9ca3af; font-size: 12px; }
                                }
                            }
                        }
                    }
                }
            }

            // Footer
            HorizontalLayout {
                alignment: end;
                spacing: 10px;

                SecondaryButton {
                    text: @tr("Cancel");
                    clicked => { root.close(); }
                }

                PrimaryButton {
                    text: @tr("Save Settings");
                    icon: @image-url("../assets/icons/save-line.svg");
                    clicked => { root.save(root.settings_form); }
                }
            }
        }
    }
}
