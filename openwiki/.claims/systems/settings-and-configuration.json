    {
      "id": "claim_9169e1c252554439953ee0c7363f52e9",
      "statement": "Dispatcher::save_settings_with persists through SettingsService, broadcasts to all backends, clears CDN when disabled, recomputes ConcurrencyManager HTTP/BT limits and notifies the scheduler, and pushes buffer-pool limits to DiskIoService.",
