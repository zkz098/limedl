    {
      "id": "claim_a7187bca605f403f92e8e0c25eaccfa2",
      "statement": "When only the cache-key prefix matches, rust-cache restores the previous generation, keeps its dependency artifacts, and writes a new generation under the new lockHash, so a Cargo.lock change causes an incremental rebuild rather than a cold one; a full key match is not written back.",
      "evidence": [
        {
          "resource": "repo://docs/ci-operations.md#L44-L57",
          "version": "repo-lines-v1:sha256:ad9c17b59d95d149057171afe3a4f39b59cd7b5ce0dbc91bf2c1efa4a763fc22:"
        }
