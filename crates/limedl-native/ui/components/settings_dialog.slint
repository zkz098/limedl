                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: @tr("Enable IP Blocklist"); color: Theme.cf3f4f6; font-size: 13px; font-weight: 600;
                                    Tooltip {
                                        Rectangle {
