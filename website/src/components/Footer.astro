---
import { Image } from 'astro:assets';
import logoImage from '../assets/logo.png';

interface Props {
  lang?: 'zh-CN' | 'en';
}

const { lang = 'zh-CN' } = Astro.props;
const isEn = lang === 'en';
---

<footer class="border-t border-brand-border bg-brand-surface/60 mt-24 py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
      <!-- Col 1: Brand & Bio -->
      <div class="space-y-4 md:col-span-1">
        <div class="flex items-center gap-3">
          <Image src={logoImage} alt="limedl logo" width={56} height={56} class="w-7 h-7 rounded-lg object-contain" format="webp" />
          <span class="font-bold text-lg text-white">limedl</span>
        </div>
        <p class="text-sm text-slate-400 leading-relaxed">
          {
            isEn
              ? 'Blazing fast multi-protocol download manager powered by Rust & Slint native UI. Zero bloatware, extreme throughput.'
              : '基于 Rust 与 Slint 原生 UI 的次世代多协议下载器。拒绝臃肿，追求极致吞吐与系统低负担。'
          }
        </p>
        <div class="text-xs text-slate-500">
          License: <a href="https://github.com/zkz098/limedl/blob/main/LICENSE" target="_blank" class="text-slate-400 hover:text-lime-400 underline">GPL-3.0</a>
        </div>
      </div>

      <!-- Col 2: Platform Downloads -->
      <div class="space-y-3">
        <h4 class="text-sm font-semibold uppercase tracking-wider text-slate-200">
          {isEn ? 'Platforms' : '全平台客户端'}
        </h4>
        <ul class="space-y-2 text-sm text-slate-400">
          <li><a href={isEn ? '/en/download' : '/download'} class="hover:text-lime-400 transition-colors">Windows (x86_64 Setup / Portable)</a></li>
          <li><a href={isEn ? '/en/download' : '/download'} class="hover:text-lime-400 transition-colors">macOS (Apple Silicon)</a></li>
          <li><a href={isEn ? '/en/download' : '/download'} class="hover:text-lime-400 transition-colors">Linux (x86_64 Portable)</a></li>
          <li><a href="https://github.com/zkz098/limedl/releases" target="_blank" class="hover:text-lime-400 transition-colors">GitHub Releases & Checksums</a></li>
        </ul>
      </div>

      <!-- Col 3: Resources & Docs -->
      <div class="space-y-3">
        <h4 class="text-sm font-semibold uppercase tracking-wider text-slate-200">
          {isEn ? 'Resources' : '文档与指引'}
        </h4>
        <ul class="space-y-2 text-sm text-slate-400">
          <li><a href={isEn ? '/en/getting-started/overview/' : '/getting-started/overview/'} class="hover:text-lime-400 transition-colors">{isEn ? 'Documentation' : '官方使用文档'}</a></li>
          <li><a href={isEn ? '/en/ecosystem/browser/' : '/ecosystem/browser/'} class="hover:text-lime-400 transition-colors">{isEn ? 'Browser Integration' : '浏览器接管教程'}</a></li>
          <li><a href={isEn ? '/en/guides/cdn/' : '/guides/cdn/'} class="hover:text-lime-400 transition-colors">{isEn ? 'CDN Probing Engine' : 'CDN 探针加速原理'}</a></li>
          <li><a href={isEn ? '/en/advanced/development/' : '/advanced/development/'} class="hover:text-lime-400 transition-colors">{isEn ? 'Developer Guide' : '源码编译与共建'}</a></li>
        </ul>
      </div>

      <!-- Col 4: Community -->
      <div class="space-y-3">
        <h4 class="text-sm font-semibold uppercase tracking-wider text-slate-200">
          {isEn ? 'Community' : '社区与技术'}
        </h4>
        <ul class="space-y-2 text-sm text-slate-400">
          <li><a href="https://github.com/zkz098/limedl" target="_blank" class="hover:text-lime-400 transition-colors">GitHub Repository</a></li>
          <li><a href="https://github.com/zkz098/limedl/issues" target="_blank" class="hover:text-lime-400 transition-colors">{isEn ? 'Issue Tracker' : '问题与功能反馈'}</a></li>
          <li><span class="text-slate-500">Built with Rust 2024 & Slint</span></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-brand-border/60 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <p>© {new Date().getFullYear()} limedl Project. Built with Astro & UnoCSS.</p>
      <p class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-lime-500 animate-pulse"></span>
        <span>{isEn ? 'Active Development & Continuous Updates' : '持续迭代中 · 每日更新'}</span>
      </p>
    </div>
  </div>
</footer>
