{
  "name": "limedl",
  "version": "0.3.2",
  "private": true,
  "description": "Fast multi-protocol download manager — HTTP, BitTorrent, CDN acceleration",
  "license": "GPL-3.0-or-later",
  "author": "limedl contributors",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:nas": "pnpm run build",
    "preview": "vite preview",
    "lint": "oxlint --type-aware --type-check .",
    "format": "oxfmt .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "test:e2e:nas": "playwright test --config e2e/playwright.config.ts --project=nas-webui",
    "test:e2e:nas:ui": "playwright test --config e2e/playwright.config.ts --project=nas-webui --ui",
    "test:e2e:nas:real": "cross-env LIMEDL_E2E_REAL_SERVER=1 playwright test --config e2e/playwright.config.ts --project=nas-webui e2e/tests/integration-real.spec.ts"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@vue/devtools-api": "^8.2.1",
    "@vueuse/core": "^14.4.0",
    "i18next": "^26.3.6",
    "pinia": "^4.0.3",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@iconify-json/ri": "^1.2.10",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "cross-env": "^10.1.0",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "sharp": "^0.35.3",
    "typescript": "~6.0.3",
    "unocss": "^66.7.5",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.10"
  },
  "packageManager": "pnpm@11.14.0"
}
