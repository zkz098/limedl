import { ScrollView, ComboBox } from "std-widgets.slint";
import { SettingsFormData } from "../types.slint";
import {
    CustomTextInput,
    IconButton,
    PrimaryButton,
    SecondaryButton,
    TabButton,
    ToggleSwitch,
    UnitInput,
} from "common.slint";

export component SettingsDialog inherits Rectangle {
    in property <int> settings_tab: 0;
    in-out property <SettingsFormData> settings_form;

    callback close();
    callback set_tab(int);
    callback save(SettingsFormData);
    callback toggle_game_mode();
    callback toggle_overclock_mode();
    callback fetch_trackers(string);
    callback pick_default_folder();
    callback pick_log_folder();
    callback open_log_folder();

    width: 100%;
    height: 100%;
    background: #000000bb;

    TouchArea {}

    Rectangle {
        width: min(parent.width - 60px, 940px);
        height: min(parent.height - 60px, 700px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: #171a20;
        border-color: #2e3542;
        border-width: 1px;
        border-radius: 12px;
        drop-shadow-blur: 24px;
        drop-shadow-color: #000000cc;

        VerticalLayout {
            padding: 20px;
            spacing: 12px;

            // Header
            HorizontalLayout {
                alignment: space-between;
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../assets/icons/settings-3-line.svg");
                            colorize: #a3e635;
                            width: 18px;
                            height: 18px;
                            image-fit: contain;
                        }
                    }
                    Text {
                        text: "设置中心 (Settings)";
                        color: #f3f4f6;
                        font-size: 16px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
                IconButton {
                    icon: @image-url("../assets/icons/close-line.svg");
                    clicked => { root.close(); }
                }
            }

            // Tab Headers (Two-tier Common vs Advanced)
            VerticalLayout {
                spacing: 6px;
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    Text { text: "常用:"; color: #6b7280; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                    TabButton {
                        text: "外观";
                        icon: @image-url("../assets/icons/palette-line.svg");
                        active: root.settings_tab == 0;
                        clicked => { root.set_tab(0); }
                    }
                    TabButton {
                        text: "下载";
                        icon: @image-url("../assets/icons/download-line.svg");
                        active: root.settings_tab == 1;
                        clicked => { root.set_tab(1); }
                    }
                    TabButton {
                        text: "代理";
                        icon: @image-url("../assets/icons/global-line.svg");
                        active: root.settings_tab == 2;
                        clicked => { root.set_tab(2); }
                    }
                    TabButton {
                        text: "关于";
                        icon: @image-url("../assets/icons/information-line.svg");
                        active: root.settings_tab == 8;
                        clicked => { root.set_tab(8); }
                    }

                    Rectangle { width: 1px; height: 18px; background: #2b313d; }

                    Text { text: "高级:"; color: #6b7280; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                    TabButton {
                        text: "调度";
                        icon: @image-url("../assets/icons/dashboard-3-line.svg");
                        active: root.settings_tab == 3;
                        clicked => { root.set_tab(3); }
                    }
                    TabButton {
                        text: "BT 网络";
                        icon: @image-url("../assets/icons/radar-line.svg");
                        active: root.settings_tab == 4;
                        clicked => { root.set_tab(4); }
                    }
                    TabButton {
                        text: "IO 存储";
                        icon: @image-url("../assets/icons/hard-drive-2-line.svg");
                        active: root.settings_tab == 5;
                        clicked => { root.set_tab(5); }
                    }
                    TabButton {
                        text: "日志";
                        icon: @image-url("../assets/icons/file-list-line.svg");
                        active: root.settings_tab == 6;
                        clicked => { root.set_tab(6); }
                    }
                    TabButton {
                        text: "Aria2";
                        icon: @image-url("../assets/icons/terminal-box-line.svg");
                        active: root.settings_tab == 7;
                        clicked => { root.set_tab(7); }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: #272d38;
            }

            // Tab Content — unified container
            Rectangle {
                background: #111418;
                border-radius: 8px;
                border-color: #232832;
                border-width: 1px;

                // ── Tab 0: 外观 / 启动 ──
                if root.settings_tab == 0 : ScrollView {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 14px;

                        Text { text: "外观与系统集成"; color: #a3e635; font-size: 13px; font-weight: 700; }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "主题模式 (system/light/dark):"; color: #9ca3af; font-size: 12px; }
                                ComboBox {
                                    model: ["system", "light", "dark"];
                                    current-value <=> root.settings_form.appearance_color_mode;
                                    height: 36px;
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "主题色 (amber/sky/lime):"; color: #9ca3af; font-size: 12px; }
                                ComboBox {
                                    model: ["amber", "sky", "lime"];
                                    current-value <=> root.settings_form.appearance_theme_color;
                                    height: 36px;
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "背景透明预设 (default/acrylic/frosted):"; color: #9ca3af; font-size: 12px; }
                                ComboBox {
                                    model: ["default", "acrylic", "frosted"];
                                    current-value <=> root.settings_form.appearance_background_opacity;
                                    height: 36px;
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "界面语言 (zh-CN/en-US):"; color: #9ca3af; font-size: 12px; }
                                ComboBox {
                                    model: ["zh-CN", "en-US"];
                                    current-value <=> root.settings_form.appearance_language;
                                    height: 36px;
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "关闭行为 (minimizeToTray/exit):"; color: #9ca3af; font-size: 12px; }
                                ComboBox {
                                    model: ["minimizeToTray", "exit"];
                                    current-value <=> root.settings_form.appearance_close_behavior;
                                    height: 36px;
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "内存保留数 (10-10000):"; color: #9ca3af; font-size: 12px; }
                                UnitInput {
                                    text <=> root.settings_form.max_in_memory_downloads;
                                    placeholder: "200";
                                    unit_text: "条";
                                }
                            }
                        }

                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: "显示详情面板"; color: #f3f4f6; font-size: 13px; font-weight: 600; }
                                Text { text: "在主界面右侧展示下载详情与分片热力图"; color: #6b7280; font-size: 11px; }
                            }
                            ToggleSwitch {
                                checked: root.settings_form.appearance_show_detail_info;
                                toggled => { root.settings_form.appearance_show_detail_info = !root.settings_form.appearance_show_detail_info; }
                            }
                        }

                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: "开机自启"; color: #f3f4f6; font-size: 13px; font-weight: 600; }
                                Text { text: "登录系统后自动启动 limedl-native"; color: #6b7280; font-size: 11px; }
                            }
                            ToggleSwitch {
                                checked: root.settings_form.autostart;
                                toggled => { root.settings_form.autostart = !root.settings_form.autostart; }
                            }
                        }

                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: "系统通知"; color: #f3f4f6; font-size: 13px; font-weight: 600; }
                                Text { text: "完成/失败时发送桌面通知"; color: #6b7280; font-size: 11px; }
                            }
                            ToggleSwitch {
                                checked: root.settings_form.notifications_enabled;
                                toggled => { root.settings_form.notifications_enabled = !root.settings_form.notifications_enabled; }
                            }
                        }

                        Rectangle { height: 1px; background: #1a1e26; }

                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "双击已完成任务 (none/open_file/open_in_explorer/open_download_dir):"; color: #9ca3af; font-size: 12px; }
                            ComboBox {
                                    model: ["none", "open_file", "open_in_explorer", "open_download_dir"];
                                    current-value <=> root.settings_form.double_click_completed;
                                    height: 36px;
                                }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "双击未完成任务 (none/toggle_pause_resume):"; color: #9ca3af; font-size: 12px; }
                            ComboBox {
                                    model: ["none", "toggle_pause_resume"];
                                    current-value <=> root.settings_form.double_click_uncompleted;
                                    height: 36px;
                                }
                        }
                    }
                }

                // ── Tab 1: 下载 ──
                if root.settings_tab == 1 : ScrollView {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 14px;

                        Text { text: "下载默认值"; color: #a3e635; font-size: 13px; font-weight: 700; }

                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "默认下载保存目录:"; color: #9ca3af; font-size: 12px; }
                            HorizontalLayout {
                                spacing: 8px;
                                CustomTextInput {
                                    text <=> root.settings_form.default_download_dir;
                                    placeholder: "/downloads";
                                }
                                SecondaryButton {
                                    text: "浏览...";
                                    icon: @image-url("../assets/icons/folder-open-line.svg");
                                    clicked => { root.pick_default_folder(); }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "最大同时任务数 (traditional):"; color: #9ca3af; font-size: 12px; }
                                UnitInput {
                                    text <=> root.settings_form.max_parallel_tasks;
                                    placeholder: "3";
                                    unit_text: "个";
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "默认重试次数 (0-100):"; color: #9ca3af; font-size: 12px; }
                                UnitInput {
                                    text <=> root.settings_form.download_max_retries;
                                    placeholder: "5";
                                    unit_text: "次";
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "默认校验 (blake3/sha256/xxh3_128/none/sha1):"; color: #9ca3af; font-size: 12px; }
                                ComboBox {
                                    model: ["blake3", "sha256", "xxh3_128", "none", "sha1"];
                                    current-value <=> root.settings_form.download_checksum;
                                    height: 36px;
                                }
                            }
                            VerticalLayout {
                                alignment: space-between;
                                spacing: 2px;
                                Text { text: "自动检测 sha256"; color: #f3f4f6; font-size: 13px; font-weight: 600; }
                                ToggleSwitch {
                                    checked: root.settings_form.download_auto_detect_sha256;
                                    toggled => { root.settings_form.download_auto_detect_sha256 = !root.settings_form.download_auto_detect_sha256; }
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "默认 User-Agent (空为内置 Chrome124):"; color: #9ca3af; font-size: 12px; }
                            CustomTextInput {
                                text <=> root.settings_form.download_user_agent;
                                placeholder: "Mozilla/5.0 ... Chrome/124.0.0.0";
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "全局带宽限速 (0 不限):"; color: #9ca3af; font-size: 12px; }
                            UnitInput {
                                text <=> root.settings_form.global_speed_limit_kb;
                                placeholder: "0";
                                unit_text: "KB/s";
                            }
                        }
                    }
                }

                // ── Tab 2: 代理 ──
                if root.settings_tab == 2 : ScrollView {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 14px;

                        Text { text: "代理设置"; color: #a3e635; font-size: 13px; font-weight: 700; }

                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "代理模式 (disabled/system/manual):"; color: #9ca3af; font-size: 12px; }
                            ComboBox {
                                    model: ["disabled", "system", "manual"];
                                    current-value <=> root.settings_form.proxy_mode;
                                    height: 36px;
                                }
                            Text { text: "system 跟随系统代理，manual 需填写下游 URL"; color: #6b7280; font-size: 11px; }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "手动代理 URL:"; color: #9ca3af; font-size: 12px; }
                            CustomTextInput {
                                text <=> root.settings_form.proxy_manual_url;
                                placeholder: "http://127.0.0.1:7890";
                            }
                        }
                    }
                }

                // ── Tab 3: 调度 ──
                if root.settings_tab == 3 : ScrollView {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 14px;

                        Text { text: "调度与性能"; color: #a3e635; font-size: 13px; font-weight: 700; }

                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "分配模式 (automatic/traditional):"; color: #9ca3af; font-size: 12px; }
                            ComboBox {
                                    model: ["automatic", "traditional"];
                                    current-value <=> root.settings_form.scheduler_mode;
                                    height: 36px;
                                }
                            Text { text: "automatic 为自适应线程池，traditional 为固定并发任务"; color: #6b7280; font-size: 11px; }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "自动-最大并行线程 (1-128):"; color: #9ca3af; font-size: 12px; }
                                UnitInput {
                                    text <=> root.settings_form.scheduler_max_parallel_threads;
                                    placeholder: "16";
                                    unit_text: "线程";
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "单任务最大线程 (1-64):"; color: #9ca3af; font-size: 12px; }
                                UnitInput {
                                    text <=> root.settings_form.scheduler_max_threads_per_task;
                                    placeholder: "8";
                                    unit_text: "线程";
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "单任务最小线程 (0-64):"; color: #9ca3af; font-size: 12px; }
                            UnitInput {
                                text <=> root.settings_form.scheduler_min_threads_per_task;
                                placeholder: "0";
                                unit_text: "线程";
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "自适应档位 (conservative/balanced/aggressive):"; color: #9ca3af; font-size: 12px; }
                                ComboBox {
                                    model: ["conservative", "balanced", "aggressive"];
                                    current-value <=> root.settings_form.scheduler_adaptive_profile;
                                    height: 36px;
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "分块策略 (adaptive/fixed):"; color: #9ca3af; font-size: 12px; }
                                ComboBox {
                                    model: ["adaptive", "fixed"];
                                    current-value <=> root.settings_form.scheduler_chunk_strategy;
                                    height: 36px;
                                }
                            }
                        }

                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: "尾部冲刺 (Tail Sprint)"; color: #f3f4f6; font-size: 13px; font-weight: 600; }
                                Text { text: "末段并行补齐，缩短长尾"; color: #6b7280; font-size: 11px; }
                            }
                            ToggleSwitch {
                                checked: root.settings_form.scheduler_tail_sprint;
                                toggled => { root.settings_form.scheduler_tail_sprint = !root.settings_form.scheduler_tail_sprint; }
                            }
                        }

                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: "连接预热"; color: #f3f4f6; font-size: 13px; font-weight: 600; }
                                Text { text: "建连阶段预建多个连接加速起步"; color: #6b7280; font-size: 11px; }
                            }
                            ToggleSwitch {
                                checked: root.settings_form.scheduler_connection_warmup;
                                toggled => { root.settings_form.scheduler_connection_warmup = !root.settings_form.scheduler_connection_warmup; }
                            }
                        }
                    }
                }

                // ── Tab 4: BT 网络 ──
                if root.settings_tab == 4 : ScrollView {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;

                        Text { text: "BitTorrent 网络"; color: #a3e635; font-size: 13px; font-weight: 700; }

                        // 基础
                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: "启用 DHT"; color: #f3f4f6; font-size: 13px; font-weight: 600; }
                                Text { text: "无 Tracker 时通过 DHT 发现节点"; color: #6b7280; font-size: 11px; }
                            }
                            ToggleSwitch {
                                checked: root.settings_form.dht_enabled;
                                toggled => { root.settings_form.dht_enabled = !root.settings_form.dht_enabled; }
                            }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "监听端口 (空为随机):"; color: #9ca3af; font-size: 12px; }
                                UnitInput {
                                    text <=> root.settings_form.listen_port;
                                    placeholder: "空";
                                    unit_text: "端口";
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "每 Torrent 最大 peers:"; color: #9ca3af; font-size: 12px; }
                                UnitInput {
                                    text <=> root.settings_form.max_bt_connections;
                                    placeholder: "128";
                                    unit_text: "个";
                                }
                            }
                        }

                        Rectangle { height: 1px; background: #1a1e26; }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                alignment: space-between;
                                spacing: 2px;
                                Text { text: "UPnP"; color: #f3f4f6; font-size: 12px; font-weight: 600; }
                                ToggleSwitch {
                                    checked: root.settings_form.bt_upnp_enabled;
                                    toggled => { root.settings_form.bt_upnp_enabled = !root.settings_form.bt_upnp_enabled; }
                                }
                            }
                            VerticalLayout {
                                alignment: space-between;
                                spacing: 2px;
                                Text { text: "NAT-PMP"; color: #f3f4f6; font-size: 12px; font-weight: 600; }
                                ToggleSwitch {
                                    checked: root.settings_form.bt_natpmp_enabled;
                                    toggled => { root.settings_form.bt_natpmp_enabled = !root.settings_form.bt_natpmp_enabled; }
                                }
                            }
                            VerticalLayout {
                                alignment: space-between;
                                spacing: 2px;
                                Text { text: "IPv6"; color: #f3f4f6; font-size: 12px; font-weight: 600; }
                                ToggleSwitch {
                                    checked: root.settings_form.bt_ipv6_enabled;
                                    toggled => { root.settings_form.bt_ipv6_enabled = !root.settings_form.bt_ipv6_enabled; }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                alignment: space-between;
                                spacing: 2px;
                                Text { text: "PEX"; color: #f3f4f6; font-size: 12px; font-weight: 600; }
                                ToggleSwitch {
                                    checked: root.settings_form.bt_pex_enabled;
                                    toggled => { root.settings_form.bt_pex_enabled = !root.settings_form.bt_pex_enabled; }
                                }
                            }
                            VerticalLayout {
                                alignment: space-between;
                                spacing: 2px;
                                Text { text: "LSD"; color: #f3f4f6; font-size: 12px; font-weight: 600; }
                                ToggleSwitch {
                                    checked: root.settings_form.bt_lsd_enabled;
                                    toggled => { root.settings_form.bt_lsd_enabled = !root.settings_form.bt_lsd_enabled; }
                                }
                            }
                            VerticalLayout {
                                alignment: space-between;
                                spacing: 2px;
                                Text { text: "uTP"; color: #f3f4f6; font-size: 12px; font-weight: 600; }
                                ToggleSwitch {
                                    checked: root.settings_form.bt_utp_enabled;
                                    toggled => { root.settings_form.bt_utp_enabled = !root.settings_form.bt_utp_enabled; }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "加密模式 (enabled/disabled/forced):"; color: #9ca3af; font-size: 12px; }
                                ComboBox {
                                    model: ["enabled", "disabled", "forced"];
                                    current-value <=> root.settings_form.bt_encryption_mode;
                                    height: 36px;
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "预分配 (none/full):"; color: #9ca3af; font-size: 12px; }
                                ComboBox {
                                    model: ["none", "full"];
                                    current-value <=> root.settings_form.bt_preallocate_mode;
                                    height: 36px;
                                }
                            }
                        }

                        Rectangle { height: 1px; background: #1a1e26; }

                        Text { text: "队列与限速"; color: #9ca3af; font-size: 12px; font-weight: 600; }
                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "最大活跃下载:"; color: #9ca3af; font-size: 12px; }
                                UnitInput { text <=> root.settings_form.bt_max_downloads; placeholder: "3"; unit_text: "个"; }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "最大做种:"; color: #9ca3af; font-size: 12px; }
                                UnitInput { text <=> root.settings_form.bt_max_seeds; placeholder: "5"; unit_text: "个"; }
                            }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "最大 Torrent 数:"; color: #9ca3af; font-size: 12px; }
                                UnitInput { text <=> root.settings_form.bt_max_torrents; placeholder: "100"; unit_text: "个"; }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "活跃上限:"; color: #9ca3af; font-size: 12px; }
                                UnitInput { text <=> root.settings_form.bt_active_limit; placeholder: "500"; unit_text: "个"; }
                            }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "全局下载限速:"; color: #9ca3af; font-size: 12px; }
                                UnitInput { text <=> root.settings_form.bt_global_download_rate_limit_kb; placeholder: "0"; unit_text: "KB/s"; }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "全局上传限速:"; color: #9ca3af; font-size: 12px; }
                                UnitInput { text <=> root.settings_form.bt_global_upload_rate_limit_kb; placeholder: "0"; unit_text: "KB/s"; }
                            }
                        }

                        Rectangle { height: 1px; background: #1a1e26; }

                        Text { text: "做种与完成"; color: #9ca3af; font-size: 12px; font-weight: 600; }
                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: "达到上限后暂停做种"; color: #f3f4f6; font-size: 13px; font-weight: 600; }
                                Text { text: "上传量或分享率达标后自动暂停"; color: #6b7280; font-size: 11px; }
                            }
                            ToggleSwitch {
                                checked: root.settings_form.bt_pause_upload_when_limit;
                                toggled => { root.settings_form.bt_pause_upload_when_limit = !root.settings_form.bt_pause_upload_when_limit; }
                            }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "做种上传上限:"; color: #9ca3af; font-size: 12px; }
                                UnitInput { text <=> root.settings_form.bt_upload_limit_kb; placeholder: "0"; unit_text: "KB"; }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "分享率上限 (0 不限):"; color: #9ca3af; font-size: 12px; }
                                CustomTextInput { text <=> root.settings_form.bt_upload_ratio_limit; placeholder: "0"; }
                            }
                        }

                        Rectangle { height: 1px; background: #1a1e26; }

                        Text { text: "反吸血与屏蔽"; color: #9ca3af; font-size: 12px; font-weight: 600; }
                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: "启用反吸血检测"; color: #f3f4f6; font-size: 13px; font-weight: 600; }
                                Text { text: "识别只下载不上传的节点"; color: #6b7280; font-size: 11px; }
                            }
                            ToggleSwitch {
                                checked: root.settings_form.bt_anti_leech_enabled;
                                toggled => { root.settings_form.bt_anti_leech_enabled = !root.settings_form.bt_anti_leech_enabled; }
                            }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "处置方式 (ban/limit_slots):"; color: #9ca3af; font-size: 12px; }
                                ComboBox {
                                    model: ["ban", "limit_slots"];
                                    current-value <=> root.settings_form.bt_anti_leech_action;
                                    height: 36px;
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "观察宽限时间:"; color: #9ca3af; font-size: 12px; }
                                UnitInput { text <=> root.settings_form.bt_anti_leech_grace_secs; placeholder: "300"; unit_text: "秒"; }
                            }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "分享率阈值 (0-1):"; color: #9ca3af; font-size: 12px; }
                                CustomTextInput { text <=> root.settings_form.bt_anti_leech_ratio; placeholder: "0.1"; }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "封禁时长:"; color: #9ca3af; font-size: 12px; }
                                UnitInput { text <=> root.settings_form.bt_anti_leech_ban_secs; placeholder: "3600"; unit_text: "秒"; }
                            }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "限制模式最大上传槽位 (1-64):"; color: #9ca3af; font-size: 12px; }
                            UnitInput { text <=> root.settings_form.bt_anti_leech_max_upload_slots; placeholder: "4"; unit_text: "个"; }
                        }
                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: "启用 IP 屏蔽列表"; color: #f3f4f6; font-size: 13px; font-weight: 600; }
                                Text { text: "加载本地 blocklist 文件"; color: #6b7280; font-size: 11px; }
                            }
                            ToggleSwitch {
                                checked: root.settings_form.bt_blocklist_enabled;
                                toggled => { root.settings_form.bt_blocklist_enabled = !root.settings_form.bt_blocklist_enabled; }
                            }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "屏蔽列表路径:"; color: #9ca3af; font-size: 12px; }
                            CustomTextInput { text <=> root.settings_form.bt_blocklist_path; placeholder: "C:/path/to/blocklist.dat"; }
                        }

                        Rectangle { height: 1px; background: #1a1e26; }

                        Text { text: "引擎调优"; color: #9ca3af; font-size: 12px; font-weight: 600; }
                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "做种调度 (fastest_upload/round_robin/anti_leech):"; color: #9ca3af; font-size: 12px; }
                                ComboBox {
                                    model: ["fastest_upload", "round_robin", "anti_leech"];
                                    current-value <=> root.settings_form.bt_seed_choking_algorithm;
                                    height: 36px;
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "阻塞算法 (fixed_slots/rate_based):"; color: #9ca3af; font-size: 12px; }
                                ComboBox {
                                    model: ["fixed_slots", "rate_based"];
                                    current-value <=> root.settings_form.bt_choking_algorithm;
                                    height: 36px;
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "每 Torrent 最大上传槽位:"; color: #9ca3af; font-size: 12px; }
                                UnitInput { text <=> root.settings_form.bt_max_upload_slots_per_torrent; placeholder: "4"; unit_text: "个"; }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "智能封禁阈值 (1-100):"; color: #9ca3af; font-size: 12px; }
                                UnitInput { text <=> root.settings_form.bt_smart_ban_max_failures; placeholder: "3"; unit_text: "次"; }
                            }
                        }
                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: "智能封禁假释"; color: #f3f4f6; font-size: 13px; font-weight: 600; }
                                Text { text: "先隔离再判定，减少误封"; color: #6b7280; font-size: 11px; }
                            }
                            ToggleSwitch {
                                checked: root.settings_form.bt_smart_ban_parole;
                                toggled => { root.settings_form.bt_smart_ban_parole = !root.settings_form.bt_smart_ban_parole; }
                            }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "驱逐后禁止重连时长:"; color: #9ca3af; font-size: 12px; }
                                UnitInput { text <=> root.settings_form.bt_eviction_ban_duration_secs; placeholder: "600"; unit_text: "秒"; }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "无数据贡献超时:"; color: #9ca3af; font-size: 12px; }
                                UnitInput { text <=> root.settings_form.bt_data_contribution_timeout_secs; placeholder: "60"; unit_text: "秒"; }
                            }
                        }

                        Rectangle { height: 1px; background: #1a1e26; }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                alignment: space-between;
                                spacing: 2px;
                                Text { text: "Fast Extension"; color: #f3f4f6; font-size: 12px; font-weight: 600; }
                                ToggleSwitch {
                                    checked: root.settings_form.bt_enable_fast_extension;
                                    toggled => { root.settings_form.bt_enable_fast_extension = !root.settings_form.bt_enable_fast_extension; }
                                }
                            }
                            VerticalLayout {
                                alignment: space-between;
                                spacing: 2px;
                                Text { text: "Holepunch"; color: #f3f4f6; font-size: 12px; font-weight: 600; }
                                ToggleSwitch {
                                    checked: root.settings_form.bt_enable_holepunch;
                                    toggled => { root.settings_form.bt_enable_holepunch = !root.settings_form.bt_enable_holepunch; }
                                }
                            }
                            VerticalLayout {
                                alignment: space-between;
                                spacing: 2px;
                                Text { text: "WebSeed"; color: #f3f4f6; font-size: 12px; font-weight: 600; }
                                ToggleSwitch {
                                    checked: root.settings_form.bt_enable_web_seed;
                                    toggled => { root.settings_form.bt_enable_web_seed = !root.settings_form.bt_enable_web_seed; }
                                }
                            }
                            VerticalLayout {
                                alignment: space-between;
                                spacing: 2px;
                                Text { text: "SuperSeed"; color: #f3f4f6; font-size: 12px; font-weight: 600; }
                                ToggleSwitch {
                                    checked: root.settings_form.bt_enable_super_seeding;
                                    toggled => { root.settings_form.bt_enable_super_seeding = !root.settings_form.bt_enable_super_seeding; }
                                }
                            }
                        }

                        Rectangle { height: 1px; background: #1a1e26; }

                        VerticalLayout {
                            spacing: 6px;
                            Text { text: "Tracker 订阅 URL:"; color: #9ca3af; font-size: 12px; }
                            HorizontalLayout {
                                spacing: 8px;
                                CustomTextInput {
                                    text <=> root.settings_form.tracker_url;
                                    placeholder: "https://cf.trackerslist.com/best.txt";
                                }
                                SecondaryButton {
                                    text: "立即同步";
                                    icon: @image-url("../assets/icons/refresh-line.svg");
                                    clicked => { root.fetch_trackers(root.settings_form.tracker_url); }
                                }
                            }
                            Text { text: "同步后写入 bt.trackerList，需手动保存生效"; color: #6b7280; font-size: 11px; }
                        }
                    }
                }

                // ── Tab 5: IO 实验室 ──
                if root.settings_tab == 5 : ScrollView {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 14px;

                        Text { text: "IO 基线与性能模式"; color: #a3e635; font-size: 13px; font-weight: 700; }

                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: "游戏模式"; color: #f59e0b; font-size: 13px; font-weight: 600; }
                                Text { text: "动态缩小缓冲并降 IO 频率，降低对 3D 游戏抢占"; color: #6b7280; font-size: 11px; }
                            }
                            ToggleSwitch {
                                checked: root.settings_form.game_mode;
                                toggled => { root.toggle_game_mode(); }
                            }
                        }

                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: "超频模式"; color: #ec4899; font-size: 13px; font-weight: 600; }
                                Text { text: "激进多线程压榨带宽极限"; color: #6b7280; font-size: 11px; }
                            }
                            ToggleSwitch {
                                checked: root.settings_form.overclock_mode;
                                toggled => { root.toggle_overclock_mode(); }
                            }
                        }

                        Rectangle { height: 1px; background: #1a1e26; }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "缓冲池上限:"; color: #9ca3af; font-size: 12px; }
                                UnitInput { text <=> root.settings_form.io_buffer_limit_mb; placeholder: "1024"; unit_text: "MB"; }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "游戏模式缓冲:"; color: #9ca3af; font-size: 12px; }
                                UnitInput { text <=> root.settings_form.io_game_mode_buffer_mb; placeholder: "128"; unit_text: "MB"; }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "HDD 最大并行:"; color: #9ca3af; font-size: 12px; }
                                UnitInput { text <=> root.settings_form.io_max_parallel_hdd; placeholder: "4"; unit_text: "个"; }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "游戏模式最大并行:"; color: #9ca3af; font-size: 12px; }
                                UnitInput { text <=> root.settings_form.io_game_mode_max_parallel; placeholder: "1"; unit_text: "个"; }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                alignment: space-between;
                                spacing: 2px;
                                Text { text: "HDD 双缓冲优化"; color: #f3f4f6; font-size: 12px; font-weight: 600; }
                                ToggleSwitch {
                                    checked: root.settings_form.io_hdd_buffer_enabled;
                                    toggled => { root.settings_form.io_hdd_buffer_enabled = !root.settings_form.io_hdd_buffer_enabled; }
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "SSD 写合并 (0=auto):"; color: #9ca3af; font-size: 12px; }
                                UnitInput { text <=> root.settings_form.io_ssd_write_combine_mb; placeholder: "0"; unit_text: "MB"; }
                            }
                        }

                        Rectangle { height: 1px; background: #1a1e26; }

                        VerticalLayout {
                            spacing: 4px;
                            HorizontalLayout {
                                spacing: 6px;
                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("../assets/icons/hard-drive-2-line.svg");
                                        colorize: #38bdf8;
                                        width: 15px;
                                        height: 15px;
                                        image-fit: contain;
                                    }
                                }
                                Text { text: "磁盘类型检测 (SSD / HDD):"; color: #9ca3af; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                            }
                            Text { text: root.settings_form.disk_type_text; color: #38bdf8; font-size: 12px; }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            HorizontalLayout {
                                spacing: 6px;
                                VerticalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("../assets/icons/cpu-line.svg");
                                        colorize: #a3e635;
                                        width: 15px;
                                        height: 15px;
                                        image-fit: contain;
                                    }
                                }
                                Text { text: "缓冲池状态:"; color: #9ca3af; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                            }
                            Text { text: root.settings_form.io_status_text; color: #a3e635; font-size: 12px; }
                        }
                    }
                }

                // ── Tab 6: 日志 ──
                if root.settings_tab == 6 : ScrollView {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 14px;

                        Text { text: "日志"; color: #a3e635; font-size: 13px; font-weight: 700; }

                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: "启用文件日志"; color: #f3f4f6; font-size: 13px; font-weight: 600; }
                                Text { text: "写入 filePath 指定的日志文件"; color: #6b7280; font-size: 11px; }
                            }
                            ToggleSwitch {
                                checked: root.settings_form.logging_enabled;
                                toggled => { root.settings_form.logging_enabled = !root.settings_form.logging_enabled; }
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "日志级别 (trace/debug/info/warn/error):"; color: #9ca3af; font-size: 12px; }
                            ComboBox {
                                    model: ["trace", "debug", "info", "warn", "error"];
                                    current-value <=> root.settings_form.logging_level;
                                    height: 36px;
                                }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "日志文件路径:"; color: #9ca3af; font-size: 12px; }
                            HorizontalLayout {
                                spacing: 8px;
                                CustomTextInput {
                                    text <=> root.settings_form.logging_file_path;
                                    placeholder: "留空由系统决定，例 D:\\limedl\\logs\\limedl.log";
                                }
                                SecondaryButton {
                                    text: "选择路径...";
                                    icon: @image-url("../assets/icons/folder-open-line.svg");
                                    clicked => { root.pick_log_folder(); }
                                }
                                SecondaryButton {
                                    text: "打开目录";
                                    icon: @image-url("../assets/icons/folder-open-line.svg");
                                    clicked => { root.open_log_folder(); }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "保留文件数 (空=不限):"; color: #9ca3af; font-size: 12px; }
                                UnitInput { text <=> root.settings_form.logging_retention_count; placeholder: "空"; unit_text: "个"; }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "保留天数 (空=不限):"; color: #9ca3af; font-size: 12px; }
                                UnitInput { text <=> root.settings_form.logging_retention_days; placeholder: "空"; unit_text: "天"; }
                            }
                        }
                    }
                }

                // ── Tab 7: Aria2 RPC ──
                if root.settings_tab == 7 : ScrollView {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 14px;

                        Text { text: "Aria2 RPC 服务"; color: #a3e635; font-size: 13px; font-weight: 700; }

                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: "启用 Aria2 RPC 服务"; color: #f3f4f6; font-size: 13px; font-weight: 600; }
                                Text { text: "供浏览器插件（Aria2 Explorer 等）接管下载"; color: #6b7280; font-size: 11px; }
                            }
                            ToggleSwitch {
                                checked: root.settings_form.aria2_enabled;
                                toggled => { root.settings_form.aria2_enabled = !root.settings_form.aria2_enabled; }
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "RPC 端口 (1-65535):"; color: #9ca3af; font-size: 12px; }
                            UnitInput {
                                text <=> root.settings_form.aria2_port;
                                placeholder: "6800";
                                unit_text: "端口";
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "RPC Secret (空为无鉴权):"; color: #9ca3af; font-size: 12px; }
                            CustomTextInput {
                                text <=> root.settings_form.aria2_secret;
                                placeholder: "留空表示不设 Secret";
                            }
                        }

                        Rectangle { height: 1px; background: #1a1e26; }
                        Text { text: "提示：Aria2 Explorer 扩展可在 Chrome/Edge/Firefox 商店搜索安装，填入 http://127.0.0.1:{端口} 与 Secret 即可接管。"; color: #6b7280; font-size: 11px; wrap: word-wrap; }
                    }
                }

                // ── Tab 8: 关于 ──
                if root.settings_tab == 8 : ScrollView {
                    VerticalLayout {
                        padding: 18px;
                        spacing: 16px;

                        HorizontalLayout {
                            spacing: 16px;
                            alignment: start;
                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("../assets/logo.png");
                                    width: 48px;
                                    height: 48px;
                                    image-fit: contain;
                                }
                            }
                            VerticalLayout {
                                spacing: 3px;
                                Text { text: "limedl - Native Edition"; color: #f3f4f6; font-size: 16px; font-weight: 700; }
                                Text { text: "轻量级高性能异步多协议下载引擎"; color: #84cc16; font-size: 12px; font-weight: 600; }
                                Text { text: "跨平台多端统一调度内核，支持 HTTP/HTTPS 多线程自适应加速与完整 BitTorrent 协议。"; color: #9ca3af; font-size: 11px; }
                            }
                        }

                        Rectangle { height: 1px; background: #1f242e; }

                        Rectangle {
                            background: #14171d;
                            border-color: #232832;
                            border-width: 1px;
                            border-radius: 8px;

                            VerticalLayout {
                                padding: 14px;
                                spacing: 10px;
                                Text { text: "系统与环境信息"; color: #a3e635; font-size: 12px; font-weight: 700; }

                                HorizontalLayout {
                                    Text { width: 140px; text: "客户端版本:"; color: #6b7280; font-size: 12px; }
                                    Text { text: root.settings_form.app_version; color: #f3f4f6; font-size: 12px; font-weight: 600; font-family: "Consolas, monospace"; }
                                }
                                HorizontalLayout {
                                    Text { width: 140px; text: "核心引擎:"; color: #6b7280; font-size: 12px; }
                                    Text { text: root.settings_form.engine_version; color: #f3f4f6; font-size: 12px; font-weight: 600; font-family: "Consolas, monospace"; }
                                }
                                HorizontalLayout {
                                    Text { width: 140px; text: "目标架构与图形栈:"; color: #6b7280; font-size: 12px; }
                                    Text { text: root.settings_form.arch_info; color: #38bdf8; font-size: 12px; font-weight: 600; font-family: "Consolas, monospace"; }
                                }
                                HorizontalLayout {
                                    Text { width: 140px; text: "核心技术栈:"; color: #6b7280; font-size: 12px; }
                                    Text { text: "Rust Edition 2024 / Slint Native UI / Skia 硬件加速 / Tokio 异步运行时"; color: #9ca3af; font-size: 12px; }
                                }
                                HorizontalLayout {
                                    Text { width: 140px; text: "开源协议:"; color: #6b7280; font-size: 12px; }
                                    Text { text: "MIT / Apache-2.0 Dual License"; color: #9ca3af; font-size: 12px; }
                                }
                            }
                        }
                    }
                }
            }

            // Footer
            HorizontalLayout {
                alignment: end;
                spacing: 10px;

                SecondaryButton {
                    text: "取消";
                    clicked => { root.close(); }
                }

                PrimaryButton {
                    text: "保存设置";
                    icon: @image-url("../assets/icons/save-line.svg");
                    clicked => { root.save(root.settings_form); }
                }
            }
        }
    }
}
