    /// dark #20242d / light #e7eaef
    in property <color> c20242d: dark ? #20242d : #e7eaef;
    /// dark #20252e / light #e7eaef
    in property <color> c20252e: dark ? #20252e : #e7eaef;
    /// dark #22262f / light #e6e9ee
    in property <color> c22262f: dark ? #22262f : #e6e9ee;
    /// dark #222731 / light #e7eaef
    in property <color> c222731: dark ? #222731 : #e7eaef;
    /// dark #232832 / light #e6e9ee
    in property <color> c232832: dark ? #232832 : #e6e9ee;
    /// dark #232a38 / light #e6e9ee
    in property <color> c232a38: dark ? #232a38 : #e6e9ee;
    /// dark #242932 / light #e6e9ee
    in property <color> c242932: dark ? #242932 : #e6e9ee;
    /// dark #242934 / light #e6e9ee
    in property <color> c242934: dark ? #242934 : #e6e9ee;
