import { Theme } from "../theme.slint";

export component RiIcon inherits Image {
    in property <image> icon_source;
    in property <color> icon_color: Theme.cd1d5db;
    in property <length> icon_size: 16px;

    source: root.icon_source;
    colorize: root.icon_color;
    width: root.icon_size;
    height: root.icon_size;
    image-fit: contain;
}

export component IconButton inherits Rectangle {
    in property <string> text: "";
    in property <image> icon;
    in property <color> hover_color: Theme.c242932;
    in property <color> text_color: Theme.cd1d5db;
    in property <length> font_size: 12px;
    in property <length> icon_size: 14px;
    callback clicked();

    background: ta.has_hover ? (ta.pressed ? root.hover_color.darker(0.2) : root.hover_color) : transparent;
    border-radius: 6px;
    height: 28px;
    min-width: 28px;

    ta := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: root.text != "" ? 8px : 6px;
        padding-right: root.text != "" ? 8px : 6px;
        spacing: 4px;
        alignment: center;

        if root.icon.width > 0 : VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                colorize: ta.has_hover ? Theme.cffffff : root.text_color;
                width: root.icon_size;
                height: root.icon_size;
                image-fit: contain;
            }
        }

        if root.text != "" : Text {
            text: root.text;
            color: ta.has_hover ? Theme.cffffff : root.text_color;
            font-size: root.font_size;
            font-weight: 500;
            vertical-alignment: center;
        }
    }
}

export component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> enabled: true;
    callback clicked();

    background: !root.enabled ? Theme.c2a3322 : (ta.has_hover ? (ta.pressed ? Theme.c65a30d : Theme.ca3e635) : Theme.c84cc16);
    border-radius: 6px;
    height: 32px;
    min-width: 80px;

    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 6px;
        alignment: center;

        if root.icon.width > 0 : VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                colorize: !root.enabled ? Theme.c4d5c41 : #0b1104;
                width: 15px;
                height: 15px;
                image-fit: contain;
            }
        }

        Text {
            text: root.text;
            color: !root.enabled ? Theme.c4d5c41 : #0b1104;
            font-size: 13px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }
}

export component SecondaryButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> active: false;
    in property <bool> enabled: true;
    callback clicked();

    background: !root.enabled ? Theme.c15181e : (root.active ? Theme.c26331a : (ta.has_hover ? (ta.pressed ? Theme.c20242c : Theme.c252b34) : Theme.c1a1d23));
    border-color: !root.enabled ? Theme.c252a34 : (root.active ? Theme.c84cc16 : Theme.c323844);
    border-width: 1px;
    border-radius: 6px;
    height: 32px;
    min-width: 60px;

    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 5px;
        alignment: center;

        if root.icon.width > 0 : VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                colorize: !root.enabled ? Theme.c4b5563 : (root.active ? Theme.c84cc16 : (ta.has_hover ? Theme.cffffff : Theme.cd1d5db));
                width: 14px;
                height: 14px;
                image-fit: contain;
            }
        }

        Text {
            text: root.text;
            color: !root.enabled ? Theme.c4b5563 : (root.active ? Theme.c84cc16 : (ta.has_hover ? Theme.cffffff : Theme.ce5e7eb));
            font-size: 12px;
            font-weight: root.active ? 600 : 500;
            vertical-alignment: center;
        }
    }
}

