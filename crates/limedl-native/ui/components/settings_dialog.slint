import { ScrollView, ComboBox } from "std-widgets.slint";

import { Theme } from "../theme.slint";
import { ScrollView, ComboBox } from "std-widgets.slint";
import { SettingsFormData, UpdateState } from "../types.slint";
import {
    CustomTextInput,
    IconButton,
    PrimaryButton,
    SecondaryButton,
    TabButton,
    ToggleSwitch,
    UnitInput,
} from "common.slint";

export component SettingsDialog inherits Rectangle {
    in property <int> settings_tab: 0;
    // Advanced BT settings section is collapsed by default (not persisted:
    // the dialog is recreated on each open, so this resets to false).
    in-out property <bool> bt_show_advanced: false;
    in-out property <SettingsFormData> settings_form;
    in-out property <UpdateState> update_state;

    callback close();
    callback set_tab(int);
    callback save(SettingsFormData);
    callback toggle_game_mode();
    callback toggle_overclock_mode();
    callback fetch_trackers(string);
    callback pick_default_folder();
    callback pick_log_folder();
    callback open_log_folder();
    callback open_font_license();
    callback check_updates();
    callback start_download();
    callback restart_now();

    pure function update_status_text() -> string {
        root.update_state.phase == "checking" ? @tr("Checking for updates...")
        : root.update_state.phase == "up-to-date" ? @tr("You are up to date.")
        : root.update_state.phase == "available" ? @tr("Version {} is available.", root.update_state.latest_version)
        : root.update_state.phase == "downloading" ? @tr("Downloading update...")
        : root.update_state.phase == "ready" ? @tr("v{} downloaded and verified. Restart to apply.", root.update_state.latest_version)
        : root.update_state.phase == "error" ? @tr("Update check failed.")
        : @tr("No update checked yet.");
    }

    pure function update_status_color() -> color {
        root.update_state.phase == "available" || root.update_state.phase == "ready" ? Theme.c84cc16
        : root.update_state.phase == "error" ? Theme.cf87171
        : root.update_state.phase == "downloading" ? Theme.c38bdf8
        : Theme.cf3f4f6;
    }

    pure function install_kind_label() -> string {
        root.update_state.install_kind == "store" ? @tr("Store (MSIX)")
        : root.update_state.install_kind == "installer" ? @tr("Installer")
        : @tr("Portable");
    }

    width: 100%;
    height: 100%;
    background: Theme.c000000bb;

    TouchArea {}

    Rectangle {
        width: min(parent.width - 60px, 940px);
        height: min(parent.height - 60px, 700px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.c171a20;
        border-color: Theme.c2e3542;
        border-width: 1px;
        border-radius: 12px;
        drop-shadow-blur: 24px;
        drop-shadow-color: Theme.c000000cc;

        VerticalLayout {
            padding: 20px;
            spacing: 12px;

            // Header
            HorizontalLayout {
                alignment: space-between;
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        Image {
                            source: @image-url("../assets/icons/settings-3-line.svg");
                            colorize: Theme.ca3e635;
                            width: 18px;
                            height: 18px;
                            image-fit: contain;
                        }
                    }
                    Text {
                        text: @tr("Settings Center");
                        color: Theme.cf3f4f6;
                        font-size: 16px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
                IconButton {
                    icon: @image-url("../assets/icons/close-line.svg");
                    clicked => { root.close(); }
                }
            }

            // Tab Headers (Two-tier Common vs Advanced). Split into two rows
            // so the labels always fit the modal width in both locales — a
            // single start-aligned row overflowed the 940px modal with the
            // English labels and clipped the last tabs (Logging / Aria2).
            VerticalLayout {
                spacing: 6px;

                // Row 1 — Common
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    Text { text: @tr("Common:"); color: #6b7280; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                    TabButton {
                        text: @tr("Appearance");
                        icon: @image-url("../assets/icons/palette-line.svg");
                        active: root.settings_tab == 0;
                        clicked => { root.set_tab(0); }
                    }
                    TabButton {
                        text: @tr("Download");
                        icon: @image-url("../assets/icons/download-line.svg");
                        active: root.settings_tab == 1;
                        clicked => { root.set_tab(1); }
                    }
                    TabButton {
                        text: @tr("Proxy");
                        icon: @image-url("../assets/icons/global-line.svg");
                        active: root.settings_tab == 2;
                        clicked => { root.set_tab(2); }
                    }
                    TabButton {
                        text: @tr("About");
                        icon: @image-url("../assets/icons/information-line.svg");
                        active: root.settings_tab == 8;
                        clicked => { root.set_tab(8); }
                    }
                }

                // Row 2 — Advanced
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    Text { text: @tr("Advanced:"); color: #6b7280; font-size: 11px; font-weight: 600; vertical-alignment: center; }
                    TabButton {
                        text: @tr("Scheduler");
                        icon: @image-url("../assets/icons/dashboard-3-line.svg");
                        active: root.settings_tab == 3;
                        clicked => { root.set_tab(3); }
                    }
                    TabButton {
                        text: @tr("BT Network");
                        icon: @image-url("../assets/icons/radar-line.svg");
                        active: root.settings_tab == 4;
                        clicked => { root.set_tab(4); }
                    }
                    TabButton {
                        text: @tr("IO & Storage");
                        icon: @image-url("../assets/icons/hard-drive-2-line.svg");
                        active: root.settings_tab == 5;
                        clicked => { root.set_tab(5); }
                    }
                    TabButton {
                        text: @tr("Logging");
                        icon: @image-url("../assets/icons/file-list-line.svg");
                        active: root.settings_tab == 6;
                        clicked => { root.set_tab(6); }
                    }
                    TabButton {
                        text: @tr("Aria2");
                        icon: @image-url("../assets/icons/terminal-box-line.svg");
                        active: root.settings_tab == 7;
                        clicked => { root.set_tab(7); }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.c272d38;
            }

            // Tab Content — unified container
            Rectangle {
                background: Theme.c111418;
                border-radius: 8px;
                border-color: Theme.c232832;
                border-width: 1px;

                // ── Tab 0: 外观 / 启动 ──
                if root.settings_tab == 0 : ScrollView {
                    VerticalLayout {
                        // Top-align content: ScrollView stretches short content to fill
                        // the viewport, which would otherwise spread rows far apart.
                        alignment: start;
                        padding: 16px;
                        spacing: 14px;

                        Text { text: @tr("Appearance & System Integration"); color: Theme.ca3e635; font-size: 13px; font-weight: 700; }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Theme Mode (system/light/dark):"); color: Theme.c9ca3af; font-size: 12px;
                                    Tooltip {
                                        Rectangle {
                                            background: Theme.c111419;
                                            border-width: 1px;
        border-color: Theme.c2e3542;
                                            border-radius: 8px;
                                            max-width: 520px;
                                            HorizontalLayout { padding: 10px; Text { text: @tr("Follow system switches automatically from the current Windows app theme."); wrap: word-wrap; color: Theme.cf3f4f6; font-size: 12px; vertical-alignment: center; } }
                                        }
                                    } }
                                // Display labels are localized via @tr; option order MUST match
                                // bridge.rs `combo` canonical value arrays.
                                ComboBox {
                                    model: [@tr("Follow System"), @tr("Light"), @tr("Dark")];
                                    current-index <=> root.settings_form.appearance_color_mode_idx;
                                    height: 36px;
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Theme Color (amber/sky/lime):"); color: Theme.c9ca3af; font-size: 12px; }
                                ComboBox {
                                    model: [@tr("Amber"), @tr("Sky Blue"), @tr("Lime")];
                                    current-index <=> root.settings_form.appearance_theme_color_idx;
                                    height: 36px;
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Background Opacity Preset (default/acrylic/frosted):"); color: Theme.c9ca3af; font-size: 12px;
                                    Tooltip {
                                        Rectangle {
                                            background: Theme.c111419;
                                            border-width: 1px;
        border-color: Theme.c2e3542;
                                            border-radius: 8px;
                                            max-width: 520px;
                                            HorizontalLayout { padding: 10px; Text { text: @tr("Controls transparency and background blur for app panels and dialogs."); wrap: word-wrap; color: Theme.cf3f4f6; font-size: 12px; vertical-alignment: center; } }
                                        }
                                    } }
                                ComboBox {
                                    model: [@tr("Default"), @tr("Acrylic"), @tr("Frosted")];
                                    current-index <=> root.settings_form.appearance_background_opacity_idx;
                                    height: 36px;
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("UI Language (zh-CN/en-US):"); color: Theme.c9ca3af; font-size: 12px; }
                                ComboBox {
                                    model: [@tr("简体中文"), @tr("English")];
                                    current-index <=> root.settings_form.appearance_language_idx;
                                    height: 36px;
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Close Behavior (minimizeToTray/exit):"); color: Theme.c9ca3af; font-size: 12px; }
                                ComboBox {
                                    model: [@tr("Minimize to Tray"), @tr("Exit")];
                                    current-index <=> root.settings_form.appearance_close_behavior_idx;
                                    height: 36px;
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Max In-Memory Records (10-10000):"); color: Theme.c9ca3af; font-size: 12px; }
                                UnitInput {
                                    text <=> root.settings_form.max_in_memory_downloads;
                                    placeholder: "200";
                                    unit_text: @tr("items");
                                }
                            }
                        }

                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: @tr("Show Detail Panel"); color: Theme.cf3f4f6; font-size: 13px; font-weight: 600;
                                    Tooltip {
                                        Rectangle {
                                            background: Theme.c111419;
                                            border-width: 1px;
        border-color: Theme.c2e3542;
                                            border-radius: 8px;
                                            max-width: 520px;
                                            HorizontalLayout { padding: 10px; Text { text: @tr("Show detailed fields like URL, checksum, threads in the download inspector."); wrap: word-wrap; color: Theme.cf3f4f6; font-size: 12px; vertical-alignment: center; } }
                                        }
                                    } }
                                Text { text: @tr("Show download inspector and piece heatmap on the right"); color: #6b7280; font-size: 11px; }
                            }
                            ToggleSwitch {
                                checked: root.settings_form.appearance_show_detail_info;
                                toggled => { root.settings_form.appearance_show_detail_info = !root.settings_form.appearance_show_detail_info; }
                            }
                        }

                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: @tr("Launch on Startup"); color: Theme.cf3f4f6; font-size: 13px; font-weight: 600;
                                    Tooltip {
                                        Rectangle {
                                            background: Theme.c111419;
                                            border-width: 1px;
        border-color: Theme.c2e3542;
                                            border-radius: 8px;
                                            max-width: 520px;
                                            HorizontalLayout { padding: 10px; Text { text: @tr("Start Limedl automatically when you log in. The app will start minimized to the system tray."); wrap: word-wrap; color: Theme.cf3f4f6; font-size: 12px; vertical-alignment: center; } }
                                        }
                                    } }
                                Text { text: @tr("Automatically launch limedl-native upon user login"); color: #6b7280; font-size: 11px; }
                            }
                            ToggleSwitch {
                                checked: root.settings_form.autostart;
                                toggled => { root.settings_form.autostart = !root.settings_form.autostart; }
                            }
                        }

                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: @tr("System Notifications"); color: Theme.cf3f4f6; font-size: 13px; font-weight: 600; }
                                Text { text: @tr("Show desktop notification on task completion/failure"); color: #6b7280; font-size: 11px; }
                            }
                            ToggleSwitch {
                                checked: root.settings_form.notifications_enabled;
                                toggled => { root.settings_form.notifications_enabled = !root.settings_form.notifications_enabled; }
                            }
                        }

                        Rectangle { height: 1px; background: Theme.c1a1e26; }

                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("Double-click Completed Task (none/open_file/open_in_explorer/open_download_dir):"); color: Theme.c9ca3af; font-size: 12px;
                                Tooltip {
                                    Rectangle {
                                        background: Theme.c111419;
                                        border-width: 1px;
        border-color: Theme.c2e3542;
                                        border-radius: 8px;
                                        max-width: 520px;
                                        HorizontalLayout { padding: 10px; Text { text: @tr("Action to perform when double-clicking a completed download task."); wrap: word-wrap; color: Theme.cf3f4f6; font-size: 12px; vertical-alignment: center; } }
                                    }
                                } }
                            ComboBox {
                                    model: [@tr("No Action"), @tr("Open File"), @tr("Show in Explorer"), @tr("Open Download Directory")];
                                    current-index <=> root.settings_form.double_click_completed_idx;
                                    height: 36px;
                                }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("Double-click Uncompleted Task (none/toggle_pause_resume):"); color: Theme.c9ca3af; font-size: 12px;
                                Tooltip {
                                    Rectangle {
                                        background: Theme.c111419;
                                        border-width: 1px;
        border-color: Theme.c2e3542;
                                        border-radius: 8px;
                                        max-width: 520px;
                                        HorizontalLayout { padding: 10px; Text { text: @tr("Action to perform when double-clicking an uncompleted download task."); wrap: word-wrap; color: Theme.cf3f4f6; font-size: 12px; vertical-alignment: center; } }
                                    }
                                } }
                            ComboBox {
                                    model: [@tr("No Action"), @tr("Pause / Resume")];
                                    current-index <=> root.settings_form.double_click_uncompleted_idx;
                                    height: 36px;
                                }
                        }
                    }
                }

                // ── Tab 1: 下载 ──
                if root.settings_tab == 1 : ScrollView {
                    VerticalLayout {
                        alignment: start;
                        padding: 16px;
                        spacing: 14px;

                        Text { text: @tr("Download Defaults"); color: Theme.ca3e635; font-size: 13px; font-weight: 700; }

                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("Default Download Folder:"); color: Theme.c9ca3af; font-size: 12px;
                                Tooltip {
                                    Rectangle {
                                        background: Theme.c111419;
                                        border-width: 1px;
        border-color: Theme.c2e3542;
                                        border-radius: 8px;
                                        max-width: 520px;
                                        HorizontalLayout { padding: 10px; Text { text: @tr("New tasks will prefill this folder, and you can still override it per task."); wrap: word-wrap; color: Theme.cf3f4f6; font-size: 12px; vertical-alignment: center; } }
                                    }
                                } }
                            HorizontalLayout {
                                spacing: 8px;
                                CustomTextInput {
                                    horizontal-stretch: 1;
                                    text <=> root.settings_form.default_download_dir;
                                    placeholder: "/downloads";
                                }
                                SecondaryButton {
                                    horizontal-stretch: 0;
                                    text: @tr("Browse...");
                                    icon: @image-url("../assets/icons/folder-open-line.svg");
                                    clicked => { root.pick_default_folder(); }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Max Concurrent Tasks (traditional):"); color: Theme.c9ca3af; font-size: 12px; }
                                UnitInput {
                                    text <=> root.settings_form.max_parallel_tasks;
                                    placeholder: "3";
                                    unit_text: @tr("tasks");
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Max Retries (0-100):"); color: Theme.c9ca3af; font-size: 12px; }
                                UnitInput {
                                    text <=> root.settings_form.download_max_retries;
                                    placeholder: "5";
                                    unit_text: @tr("times");
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Default Checksum (blake3/sha256/xxh3_128/none/sha1):"); color: Theme.c9ca3af; font-size: 12px;
                                    Tooltip {
                                        Rectangle {
                                            background: Theme.c111419;
                                            border-width: 1px;
        border-color: Theme.c2e3542;
                                            border-radius: 8px;
                                            max-width: 520px;
                                            HorizontalLayout { padding: 10px; Text { text: @tr("New tasks no longer show checksum mode separately. This setting is used globally."); wrap: word-wrap; color: Theme.cf3f4f6; font-size: 12px; vertical-alignment: center; } }
                                        }
                                    } }
                                ComboBox {
                                    model: [@tr("BLAKE3"), @tr("SHA-256"), @tr("XXH3-128"), @tr("None (skip)"), @tr("SHA-1")];
                                    current-index <=> root.settings_form.download_checksum_idx;
                                    height: 36px;
                                }
                            }
                            VerticalLayout {
                                alignment: space-between;
                                spacing: 2px;
                                Text { text: @tr("Auto-detect SHA-256"); color: Theme.cf3f4f6; font-size: 13px; font-weight: 600;
                                    Tooltip {
                                        Rectangle {
                                            background: Theme.c111419;
                                            border-width: 1px;
        border-color: Theme.c2e3542;
                                            border-radius: 8px;
                                            max-width: 520px;
                                            HorizontalLayout { padding: 10px; Text { text: @tr("Automatically probe for matching .sha256 or parent SHA256SUMS files when downloading HTTP links, and verify after completion."); wrap: word-wrap; color: Theme.cf3f4f6; font-size: 12px; vertical-alignment: center; } }
                                        }
                                    } }
                                ToggleSwitch {
                                    checked: root.settings_form.download_auto_detect_sha256;
                                    toggled => { root.settings_form.download_auto_detect_sha256 = !root.settings_form.download_auto_detect_sha256; }
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("Default User-Agent (empty for Chrome 124):"); color: Theme.c9ca3af; font-size: 12px;
                                Tooltip {
                                    Rectangle {
                                        background: Theme.c111419;
                                        border-width: 1px;
        border-color: Theme.c2e3542;
                                        border-radius: 8px;
                                        max-width: 520px;
                                        HorizontalLayout { padding: 10px; Text { text: @tr("New HTTP tasks prefill this UA, and each task can override it."); wrap: word-wrap; color: Theme.cf3f4f6; font-size: 12px; vertical-alignment: center; } }
                                    }
                                } }
                            CustomTextInput {
                                text <=> root.settings_form.download_user_agent;
                                placeholder: "Mozilla/5.0 ... Chrome/124.0.0.0";
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("Global Bandwidth Limit (0 for unlimited):"); color: Theme.c9ca3af; font-size: 12px;
                                Tooltip {
                                    Rectangle {
                                        background: Theme.c111419;
                                        border-width: 1px;
        border-color: Theme.c2e3542;
                                        border-radius: 8px;
                                        max-width: 520px;
                                        HorizontalLayout { padding: 10px; Text { text: @tr("Limit total download speed across all active tasks. 0 means unlimited."); wrap: word-wrap; color: Theme.cf3f4f6; font-size: 12px; vertical-alignment: center; } }
                                    }
                                } }
                            UnitInput {
                                text <=> root.settings_form.global_speed_limit_kb;
                                placeholder: "0";
                                unit_text: "KB/s";
                            }
                        }
                    }
                }

                // ── Tab 2: 代理 ──
                if root.settings_tab == 2 : ScrollView {
                    VerticalLayout {
                        alignment: start;
                        padding: 16px;
                        spacing: 14px;

                        Text { text: @tr("Proxy Settings"); color: Theme.ca3e635; font-size: 13px; font-weight: 700; }

                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("Proxy Mode (disabled/system/manual):"); color: Theme.c9ca3af; font-size: 12px;
                                Tooltip {
                                    Rectangle {
                                        background: Theme.c111419;
                                        border-width: 1px;
        border-color: Theme.c2e3542;
                                        border-radius: 8px;
                                        max-width: 520px;
                                        HorizontalLayout { padding: 10px; Text { text: @tr("Supports common HTTP / HTTPS / SOCKS proxy URLs. Enter a full URL."); wrap: word-wrap; color: Theme.cf3f4f6; font-size: 12px; vertical-alignment: center; } }
                                    }
                                } }
                            ComboBox {
                                    model: [@tr("Disabled"), @tr("System Proxy"), @tr("Manual")];
                                    current-index <=> root.settings_form.proxy_mode_idx;
                                    height: 36px;
                                }
                            Text { text: @tr("system follows OS proxy; manual requires proxy URL below"); color: #6b7280; font-size: 11px; }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("Manual Proxy URL:"); color: Theme.c9ca3af; font-size: 12px; }
                            CustomTextInput {
                                text <=> root.settings_form.proxy_manual_url;
                                placeholder: "http://127.0.0.1:7890";
                            }
                        }
                    }
                }

                // ── Tab 3: 调度 ──
                if root.settings_tab == 3 : ScrollView {
                    VerticalLayout {
                        alignment: start;
                        padding: 16px;
                        spacing: 14px;

                        Text { text: @tr("Scheduler & Performance"); color: Theme.ca3e635; font-size: 13px; font-weight: 700; }

                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("Allocation Mode (automatic/traditional):"); color: Theme.c9ca3af; font-size: 12px; }
                            ComboBox {
                                    model: [@tr("Automatic (adaptive)"), @tr("Traditional (fixed)")];
                                    current-index <=> root.settings_form.scheduler_mode_idx;
                                    height: 36px;
                                }
                            Text { text: @tr("automatic uses adaptive thread pool; traditional uses fixed concurrency"); color: #6b7280; font-size: 11px; }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Auto - Max Parallel Threads (1-128):"); color: Theme.c9ca3af; font-size: 12px; }
                                UnitInput {
                                    text <=> root.settings_form.scheduler_max_parallel_threads;
                                    placeholder: "16";
                                    unit_text: @tr("threads");
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Max Threads per Task (1-64):"); color: Theme.c9ca3af; font-size: 12px; }
                                UnitInput {
                                    text <=> root.settings_form.scheduler_max_threads_per_task;
                                    placeholder: "8";
                                    unit_text: @tr("threads");
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: 4px;
                            Text { text: @tr("Min Threads per Task (0-64):"); color: Theme.c9ca3af; font-size: 12px;
                                Tooltip {
                                    Rectangle {
                                        background: Theme.c111419;
                                        border-width: 1px;
        border-color: Theme.c2e3542;
                                        border-radius: 8px;
                                        max-width: 520px;
                                        HorizontalLayout { padding: 10px; Text { text: @tr("Set to 0 to use 50% of the max thread count automatically. The adaptive algorithm never goes below this once reached."); wrap: word-wrap; color: Theme.cf3f4f6; font-size: 12px; vertical-alignment: center; } }
                                    }
                                } }
                            UnitInput {
                                text <=> root.settings_form.scheduler_min_threads_per_task;
                                placeholder: "0";
                                unit_text: @tr("threads");
                            }
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Adaptive Profile (conservative/balanced/aggressive):"); color: Theme.c9ca3af; font-size: 12px;
                                    Tooltip {
                                        Rectangle {
                                            background: Theme.c111419;
                                            border-width: 1px;
        border-color: Theme.c2e3542;
                                            border-radius: 8px;
                                            max-width: 520px;
                                            HorizontalLayout { padding: 10px; Text { text: @tr("Conservative limits thread growth, Balanced trades overhead for speed, and Aggressive prioritizes download speed."); wrap: word-wrap; color: Theme.cf3f4f6; font-size: 12px; vertical-alignment: center; } }
                                        }
                                    } }
                                ComboBox {
                                    model: [@tr("Conservative"), @tr("Balanced"), @tr("Aggressive")];
                                    current-index <=> root.settings_form.scheduler_adaptive_profile_idx;
                                    height: 36px;
                                }
                            }
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Chunk Strategy (adaptive/fixed):"); color: Theme.c9ca3af; font-size: 12px;
                                    Tooltip {
                                        Rectangle {
                                            background: Theme.c111419;
                                            border-width: 1px;
        border-color: Theme.c2e3542;
                                            border-radius: 8px;
                                            max-width: 520px;
                                            HorizontalLayout { padding: 10px; Text { text: @tr("Auto-adjust chunk strategy based on network conditions"); wrap: word-wrap; color: Theme.cf3f4f6; font-size: 12px; vertical-alignment: center; } }
                                        }
                                    } }
                                ComboBox {
                                    model: [@tr("Adaptive"), @tr("Fixed")];
                                    current-index <=> root.settings_form.scheduler_chunk_strategy_idx;
                                    height: 36px;
                                }
                            }
                        }

                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: @tr("Tail Sprint"); color: Theme.cf3f4f6; font-size: 13px; font-weight: 600; }
                                Text { text: @tr("Parallelize tail chunks to minimize finishing latency"); color: #6b7280; font-size: 11px; }
                            }
                            ToggleSwitch {
                                checked: root.settings_form.scheduler_tail_sprint;
                                toggled => { root.settings_form.scheduler_tail_sprint = !root.settings_form.scheduler_tail_sprint; }
                            }
                        }

                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: @tr("Connection Warmup"); color: Theme.cf3f4f6; font-size: 13px; font-weight: 600; }
                                Text { text: @tr("Pre-establish multiple connections during handshake for faster warmup"); color: #6b7280; font-size: 11px; }
                            }
                            ToggleSwitch {
                                checked: root.settings_form.scheduler_connection_warmup;
                                toggled => { root.settings_form.scheduler_connection_warmup = !root.settings_form.scheduler_connection_warmup; }
                            }
                        }
                    }
                }

                // ── Tab 4: BT 网络 ──
                if root.settings_tab == 4 : ScrollView {
                    VerticalLayout {
