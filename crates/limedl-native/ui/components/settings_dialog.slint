        border-color: Theme.c2e3542;
                                            border-radius: 8px;
                                            max-width: 520px;
                                            HorizontalLayout { padding: 10px; Text { text: @tr("For example, 2 pauses after uploaded bytes reach 2x downloaded bytes. Use 0 to disable the ratio limit."); wrap: word-wrap; color: Theme.cf3f4f6; font-size: 12px; vertical-alignment: center; } }
                                        }
                                    } }
                                CustomTextInput { text <=> root.settings_form.bt_upload_ratio_limit; placeholder: "0"; }
                            }
                        }

                        Rectangle { height: 1px; background: Theme.c1a1e26; }

                        Text { text: @tr("Anti-Leech & Peer Banning"); color: Theme.c9ca3af; font-size: 12px; font-weight: 600; }
                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 2px;
                                Text { text: @tr("Enable Anti-Leech Detection"); color: Theme.cf3f4f6; font-size: 13px; font-weight: 600;
                                    Tooltip {
                                        Rectangle {
                                            background: Theme.c111419;
                                            border-width: 1px;
        border-color: Theme.c2e3542;
                                            border-radius: 8px;
                                            max-width: 520px;
                                            HorizontalLayout { padding: 10px; Text { text: @tr("Periodically identify peers that download from you without giving data back, then enforce the selected action."); wrap: word-wrap; color: Theme.cf3f4f6; font-size: 12px; vertical-alignment: center; } }
                                        }
                                    } }
                                Text { text: @tr("Detect peers that download without uploading"); color: #6b7280; font-size: 11px; }
                            }
                            ToggleSwitch {
                                checked: root.settings_form.bt_anti_leech_enabled;
                                toggled => { root.settings_form.bt_anti_leech_enabled = !root.settings_form.bt_anti_leech_enabled; }
                            }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: @tr("Action (ban/limit_slots):"); color: Theme.c9ca3af; font-size: 12px;
                                    Tooltip {
                                        Rectangle {
